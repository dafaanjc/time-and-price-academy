---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { siteConfig } from '../../config/site';
import KnowledgeGraph from '../../components/KnowledgeGraph.astro';
import PageHead from '../../components/PageHead.astro';
import { conceptCategoryLabel, conceptHref, getConcepts, getKnowledgeGraph } from '../../lib/concepts';

const graph = await getKnowledgeGraph();
const concepts = await getConcepts();
const titles = new Map(concepts.map((c) => [c.id, c.data.title]));
const layerOf = new Map(graph.nodes.map((n) => [n.id, n.layer]));
---

<BaseLayout
  title="Peta Pengetahuan"
  description={`Peta hubungan prasyarat antar konsep di ${siteConfig.product}: konsep mana yang menjadi dasar bagi konsep lainnya.`}
>
  <PageHead title="Peta Pengetahuan" index={[`${graph.nodes.length} konsep`, `${graph.layerCount} tingkat`, `${graph.edges.length} prasyarat`]}>
    <p>
      Peta ini menunjukkan konsep mana yang menjadi dasar bagi konsep lainnya.
      Garis mengarah dari <strong>prasyarat</strong> ke konsep yang membutuhkannya.
      Arahkan kursor atau fokuskan sebuah titik untuk melihat ringkasannya, klik untuk membuka konsepnya.
    </p>
  </PageHead>

  <KnowledgeGraph graph={graph} idPrefix="peta" />

  <section class="map-table" aria-labelledby="peta-tabel">
    <h2 id="peta-tabel">Daftar prasyarat</h2>
    <p>Isi peta yang sama dalam bentuk tabel.</p>
    <!-- Dapat difokuskan agar pengguna keyboard bisa menggeser tabel di layar sempit. -->
    <div class="map-table__scroll" tabindex="0" role="region" aria-labelledby="peta-tabel">
      <table>
        <thead>
          <tr>
            <th scope="col">Tingkat</th>
            <th scope="col">Konsep</th>
            <th scope="col">Kategori</th>
            <th scope="col">Prasyarat</th>
          </tr>
        </thead>
        <tbody>
          {
            concepts.map((c) => (
              <tr>
                <td>{(layerOf.get(c.id) ?? 0) + 1}</td>
                <th scope="row">
                  <a href={conceptHref(c.id)}>{c.data.title}</a>
                </th>
                <td>{conceptCategoryLabel(c)}</td>
                <td>{c.data.prerequisites.map((p) => titles.get(p) ?? p).join(', ') || '—'}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </section>
</BaseLayout>

<style>
  .map-table {
    max-width: var(--measure);
    margin-top: 3rem;
  }

  .map-table h2 {
    margin: 0 0 0.25rem;
    font-size: var(--text-xl);
  }

  .map-table p {
    margin: 0 0 1rem;
    font-size: var(--text-sm);
    color: var(--ink-2);
  }

  .map-table__scroll {
    overflow-x: auto;
  }

  .map-table__scroll:focus-visible {
    outline-offset: 4px;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--text-sm);
  }

  /* Tabel tetap terbaca di layar sempit: geser mendatar dengan lebar minimum. */
  table {
    min-width: 32rem;
  }

  th,
  td {
    padding: 0.5rem 0.75rem;
    text-align: left;
    vertical-align: top;
    border-bottom: 1px solid var(--rule);
  }

  thead th {
    font-size: var(--text-xs);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  tbody th a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
  }

  tbody th {
    font-weight: 600;
  }
</style>
