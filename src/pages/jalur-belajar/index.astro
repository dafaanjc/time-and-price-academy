---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { siteConfig } from '../../config/site';
import LearningPath from '../../components/LearningPath.astro';
import PageHead from '../../components/PageHead.astro';
import { getLearningPaths, pathAnchor } from '../../lib/concepts';
import { readingMinutes } from '../../lib/reading-time';

const paths = await getLearningPaths();
const totalMinutes = (path: (typeof paths)[number]) =>
  path.steps.reduce((sum, c) => sum + readingMinutes(c.body), 0);
---

<BaseLayout
  title="Jalur Belajar"
  description={`Urutan belajar konsep risiko di ${siteConfig.product}, disusun berdasarkan prasyarat.`}
>
  <PageHead title="Jalur Belajar" index={[`${paths.length} jalur`, 'Bertahap', 'Berdasarkan prasyarat']}>
    <p>
      Setiap jalur menyusun konsep berdasarkan prasyaratnya, sehingga setiap langkah dibangun di atas langkah
      sebelumnya. Jalur bertahap: fondasi probabilitas lebih dulu, lalu psikologi penilaian, lalu keputusan di
      bawah risiko. Anda tetap bebas membuka konsep mana pun secara langsung.
    </p>
  </PageHead>

  {
    paths.map((path, i) => (
      <section class="path" aria-labelledby={pathAnchor(path.id)}>
        <div class="path__intro">
          <p class="label path__index">
            <span class="label__index">
              Jalur {String(i + 1).padStart(2, '0')} / {String(paths.length).padStart(2, '0')}
            </span>
            <span class="label__sep" aria-hidden="true">·</span><span>Tahap {path.tier}</span>
            <span class="label__sep" aria-hidden="true">·</span><span>{path.steps.length} konsep</span>
            <span class="label__sep" aria-hidden="true">·</span><span>{totalMinutes(path)} mnt baca</span>
          </p>
          <h2 id={pathAnchor(path.id)}>{path.title}</h2>
          <p class="path__desc">{path.description}</p>
          {path.requires.length > 0 && (
            <p class="path__requires">
              Lanjutan dari{' '}
              {path.requires.map((r, j) => (
                <>
                  {j > 0 && ', '}
                  <a href={`#${pathAnchor(r.id)}`}>{r.title}</a>
                </>
              ))}
              . Prasyarat dari jalur itu dianggap sudah dipelajari.
            </p>
          )}
        </div>
        <div class="path__route">
          <LearningPath path={path} />
        </div>
      </section>
    ))
  }
</BaseLayout>

<style>
  /* Setiap jalur: pengantar di kiri (sticky di desktop), rute di kanan. */
  .path {
    display: grid;
    gap: var(--space-6) var(--grid-gap);
    padding-top: var(--space-4);
    border-top: var(--border-mark) solid var(--ink);
  }

  .path + .path {
    margin-top: var(--space-24);
  }

  @media (min-width: 64rem) {
    .path {
      grid-template-columns: repeat(var(--grid-columns), minmax(0, 1fr));
      align-items: start;
    }

    .path__intro {
      grid-column: 1 / span 4;
      position: sticky;
      top: calc(var(--header-height) + var(--space-8));
    }

    .path__route {
      grid-column: 6 / -1;
    }
  }

  .path__index {
    margin-bottom: var(--space-2);
  }

  .path h2 {
    margin: 0 0 var(--space-3);
    font-size: var(--text-2xl);
  }

  .path__desc {
    max-width: var(--measure);
    margin: 0 0 var(--space-6);
    color: var(--ink-2);
  }

  .path__desc:has(+ .path__requires) {
    margin-bottom: var(--space-2);
  }

  .path__requires {
    max-width: var(--measure);
    margin: 0 0 var(--space-6);
    font-size: var(--text-sm);
    color: var(--ink-3);
  }
</style>
