---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { siteConfig } from '../../config/site';
import LearningPath from '../../components/LearningPath.astro';
import { getLearningPaths } from '../../lib/concepts';
import { readingMinutes } from '../../lib/reading-time';

const paths = await getLearningPaths();
const totalMinutes = (path: (typeof paths)[number]) =>
  path.steps.reduce((sum, c) => sum + readingMinutes(c.body), 0);
---

<BaseLayout
  title="Jalur Belajar"
  description={`Urutan belajar konsep risiko di ${siteConfig.product}, disusun berdasarkan prasyarat.`}
>
  <header class="paths-header">
    <h1>Jalur Belajar</h1>
    <p>
      Setiap jalur menyusun konsep berdasarkan prasyaratnya, sehingga setiap langkah dibangun di atas langkah
      sebelumnya. Anda tetap bebas membuka konsep mana pun secara langsung.
    </p>
  </header>

  {
    paths.map((path, i) => (
      <section class="path" aria-labelledby={`jalur-${path.id}`}>
        <p class="label path__index">
          <span class="label__index">
            Jalur {String(i + 1).padStart(2, '0')} / {String(paths.length).padStart(2, '0')}
          </span>
          <span class="label__sep" aria-hidden="true">·</span><span>{path.steps.length} konsep</span>
          <span class="label__sep" aria-hidden="true">·</span><span>{totalMinutes(path)} mnt baca</span>
        </p>
        <h2 id={`jalur-${path.id}`}>{path.title}</h2>
        <p class="path__desc">{path.description}</p>
        <LearningPath path={path} />
      </section>
    ))
  }
</BaseLayout>

<style>
  .paths-header {
    max-width: var(--measure);
    margin-bottom: 2.5rem;
  }

  .paths-header h1 {
    margin: 0 0 0.75rem;
    font-size: clamp(var(--text-2xl), 5vw, var(--text-3xl));
  }

  .paths-header p {
    margin: 0;
    font-size: var(--text-lg);
    color: var(--ink-2);
  }

  .path + .path {
    margin-top: var(--space-16);
  }

  .path__index {
    margin-bottom: var(--space-2);
  }

  .path h2 {
    margin: 0 0 var(--space-2);
    font-size: var(--text-xl);
  }

  .path__desc {
    max-width: var(--measure);
    margin: 0 0 var(--space-6);
    color: var(--ink-2);
  }
</style>
