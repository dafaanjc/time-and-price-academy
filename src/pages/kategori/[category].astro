---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ConceptRows from '../../components/ConceptRows.astro';
import ProblemList from '../../components/ProblemList.astro';
import { categories, type Category } from '../../data/categories';
import { getConceptsByCategory, groupByTopic } from '../../lib/concepts';
import { getProblems } from '../../lib/problems';

export function getStaticPaths() {
  return categories.map((category) => ({
    params: { category: category.id },
    props: { category },
  }));
}

interface Props {
  category: Category;
}

const { category } = Astro.props;
const concepts = (await getConceptsByCategory()).get(category.id) ?? [];
const conceptIds = new Set(concepts.map((c) => c.id));
// Kategori bertopik: satu daftar per topik. Tanpa topik (atau hanya kelompok tanpa judul): satu daftar.
const groups = groupByTopic(category, concepts);
const titled = groups.some((g) => g.topic);
// Masalah trader yang merujuk setidaknya satu konsep di kategori ini.
const problems = (await getProblems()).filter((p) => p.data.concepts.some((id) => conceptIds.has(id)));
---

<BaseLayout title={category.title} description={category.description} sidebar>
  <header class="category-header">
    <p class="eyebrow">Kategori</p>
    <h1>{category.title}</h1>
    <p class="category-header__desc">{category.description}</p>
    <p class="category-header__count">{concepts.length > 0 ? `${concepts.length} konsep` : 'Segera hadir'}</p>
  </header>

  {concepts.length > 0 && !titled && <ConceptRows concepts={concepts} />}
  {
    titled &&
      groups.map((group, i) => (
        <section class="topic" aria-labelledby={`topik-${group.topic?.id ?? 'lainnya'}`}>
          <p class="label">
            <span class="label__index">{String(i + 1).padStart(2, '0')}</span>
            <span class="label__sep" aria-hidden="true">·</span><span>{group.concepts.length} konsep</span>
          </p>
          <h2 id={`topik-${group.topic?.id ?? 'lainnya'}`}>{group.topic?.title ?? 'Lainnya'}</h2>
          <ConceptRows concepts={group.concepts} />
        </section>
      ))
  }
  {concepts.length === 0 && <p class="empty">Konsep untuk kategori ini sedang disiapkan.</p>}

  {
    problems.length > 0 && (
      <section class="category-problems" aria-labelledby="kategori-masalah">
        <h2 id="kategori-masalah">Masalah Trader Terkait</h2>
        <ProblemList problems={problems} headingLevel={3} />
      </section>
    )
  }
</BaseLayout>

<style>
  .category-header {
    max-width: var(--measure);
    margin-bottom: var(--space-8);
    padding-bottom: var(--space-4);
    border-bottom: var(--border-mark) solid var(--ink);
  }

  .category-header h1 {
    margin: var(--space-2) 0 var(--space-3);
    font-size: clamp(var(--text-2xl), 5vw, var(--text-3xl));
  }

  .category-header__desc {
    margin: 0;
    font-size: var(--text-lg);
    color: var(--ink-2);
  }

  .category-header__count {
    margin: var(--space-3) 0 0;
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .topic + .topic {
    margin-top: var(--space-12);
  }

  .topic h2 {
    margin: var(--space-1) 0 var(--space-4);
    font-size: var(--text-xl);
  }

  .empty {
    max-width: var(--measure);
    margin: 0;
    color: var(--ink-3);
  }

  .category-problems {
    margin-top: var(--space-16);
  }

  .category-problems h2 {
    margin: 0 0 var(--space-4);
    font-size: var(--text-xl);
  }
</style>
