---
import BaseLayout from '../layouts/BaseLayout.astro';
import CategoryGrid from '../components/CategoryGrid.astro';
import ConceptCard from '../components/ConceptCard.astro';
import LearningPath from '../components/LearningPath.astro';
import KnowledgeGraph from '../components/KnowledgeGraph.astro';
import { siteConfig } from '../config/site';
import { getConcepts, getKnowledgeGraph, getLearningPaths } from '../lib/concepts';
import { routes, withBase } from '../lib/url';

const concepts = await getConcepts();
const featured = concepts.filter((c) => c.data.featured);
const [mainPath] = await getLearningPaths();
const graph = await getKnowledgeGraph();

const principles = [
  {
    title: 'Dapat ditelusuri',
    body: 'Setiap klaim harus bisa dilacak ke sumbernya. Konsep tanpa sumber yang terverifikasi ditandai sebagai draf.',
  },
  {
    title: 'Bertahap',
    body: 'Konsep disusun berdasarkan prasyarat. Setiap halaman menunjukkan apa yang perlu dipahami lebih dulu.',
  },
  {
    title: 'Edukasi, bukan sinyal',
    body: `${siteConfig.product} menjelaskan cara berpikir tentang risiko. Tidak ada rekomendasi beli, jual, atau sinyal trading.`,
  },
];
---

<BaseLayout>
  <section class="hero" aria-labelledby="hero-title">
    <p class="eyebrow">{siteConfig.product} · {siteConfig.masterBrand}</p>
    <h1 id="hero-title" class="hero__title">
      {siteConfig.taglineParts.map((part) => <span>{`${part} `}</span>)}
    </h1>
    <p class="hero__lead prose">
      {siteConfig.product} adalah perpustakaan riset dan sistem belajar interaktif tentang risiko, probabilitas, dan
      pengambilan keputusan. Setiap konsep dijelaskan bertahap: dari gagasan dasarnya, contoh sehari-hari,
      hingga penerapannya di pasar keuangan.
    </p>
    <p class="hero__actions">
      <a class="button" href={withBase(routes.learningPaths)}>Mulai jalur belajar</a>
      <a class="button button--ghost" href="#jelajahi">Jelajahi topik</a>
    </p>
  </section>

  <section class="home-section" id="jelajahi" aria-labelledby="jelajahi-title">
    <h2 id="jelajahi-title">Jelajahi Pengetahuan</h2>
    <CategoryGrid />
  </section>

  {
    featured.length > 0 && (
      <section class="home-section" aria-labelledby="pilihan-title">
        <h2 id="pilihan-title">Konsep Pilihan</h2>
        <div class="card-grid">
          {featured.map((concept) => (
            <ConceptCard concept={concept} />
          ))}
        </div>
      </section>
    )
  }

  {
    mainPath && (
      <section class="home-section" id="jalur-belajar" aria-labelledby="jalur-title">
        <h2 id="jalur-title">Jalur Belajar: {mainPath.title}</h2>
        <p class="prose section-lead">{mainPath.description}</p>
        <LearningPath path={mainPath} />
        <p class="section-more">
          <a href={withBase(routes.learningPaths)}>Lihat semua jalur belajar →</a>
        </p>
      </section>
    )
  }

  <section class="home-section" aria-labelledby="peta-title">
    <h2 id="peta-title">Pratinjau Peta Pengetahuan</h2>
    <div class="map-preview">
      <div class="map-preview__text">
        <p class="prose section-lead">
          Setiap konsep dibangun di atas konsep sebelumnya. Panah pada peta mengarah dari prasyarat ke konsep yang
          membutuhkannya, sehingga Anda bisa melihat urutan belajar yang masuk akal.
        </p>
        <p class="section-more">
          <a href={withBase(routes.map)}>Buka peta lengkap →</a>
        </p>
      </div>
      <KnowledgeGraph graph={graph} idPrefix="pratinjau" />
    </div>
  </section>

  <section class="home-section" aria-labelledby="filosofi-title">
    <h2 id="filosofi-title">Filosofi Riset</h2>
    <ul class="principles">
      {
        principles.map((p) => (
          <li>
            <h3>{p.title}</h3>
            <p>{p.body}</p>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>

<style>
  .hero {
    padding-block: 1rem 2.5rem;
    border-bottom: 1px solid var(--line);
  }

  .hero__title {
    display: flex;
    flex-direction: column;
    margin: 0.75rem 0 1rem;
    font-size: clamp(2.25rem, 6vw, 3.75rem);
    letter-spacing: -0.02em;
  }

  .hero__title span:last-child {
    color: var(--accent);
  }

  .hero__lead {
    margin: 0;
    font-size: 1.125rem;
    color: var(--ink-soft);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin: 1.75rem 0 0;
  }

  .button {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0 1.125rem;
    font-weight: 600;
    color: var(--surface);
    background: var(--accent);
    border: 1px solid var(--accent);
    border-radius: var(--radius);
    text-decoration: none;
  }

  .button--ghost {
    color: var(--accent);
    background: transparent;
  }

  .home-section {
    padding-top: 3rem;
  }

  .home-section h2 {
    margin: 0 0 1.25rem;
    font-size: 1.625rem;
  }

  .section-lead {
    margin: -0.5rem 0 1.5rem;
    color: var(--ink-soft);
  }

  .section-more {
    margin: 0.5rem 0 0;
    font-weight: 600;
  }

  .map-preview {
    display: grid;
    gap: 1.5rem;
    align-items: start;
  }

  .map-preview .section-lead {
    margin-top: 0;
  }

  @media (min-width: 64rem) {
    .map-preview {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 3rem;
    }
  }

  .principles {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 15rem), 1fr));
    gap: 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .principles h3 {
    margin: 0 0 0.375rem;
    font-size: 1.125rem;
  }

  .principles p {
    margin: 0;
    font-size: 0.9375rem;
    color: var(--ink-soft);
  }
</style>
