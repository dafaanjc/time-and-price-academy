---
// Beranda: HERO (figur Waktu × Harga) → TRANSISI RISK LAB (emblem + rantai konsep) → MASALAH TRADER →
// HITUNG DULU → KATEGORI → JALUR BELAJAR (+ prinsip).
// Pintu masuk utama adalah masalah dalam bahasa trader; teori tetap tersedia lewat indeks dan jalur.
import BaseLayout from '../layouts/BaseLayout.astro';
import CategoryGrid from '../components/CategoryGrid.astro';
import HomeHero from '../components/HomeHero.astro';
import LearningPathStrip from '../components/LearningPathStrip.astro';
import ProblemList from '../components/ProblemList.astro';
import RiskLabTransition from '../components/RiskLabTransition.astro';
import SectionHeading from '../components/SectionHeading.astro';
import UkuranPosisi from '../components/tools/UkuranPosisi.astro';
import { siteConfig } from '../config/site';
import { getLearningPaths } from '../lib/concepts';
import { getProblems } from '../lib/problems';
import { routes, withBase } from '../lib/url';

const problems = await getProblems();
const [mainPath] = await getLearningPaths();

const principles = [
  {
    title: 'Dapat ditelusuri',
    body: 'Setiap klaim harus bisa dilacak ke sumbernya. Halaman tanpa sumber terverifikasi ditandai sebagai draf.',
  },
  {
    title: 'Bertahap',
    body: 'Konsep disusun berdasarkan prasyarat. Setiap halaman menunjukkan apa yang perlu dipahami lebih dulu.',
  },
  {
    title: 'Edukasi, bukan sinyal',
    body: `${siteConfig.product} menjelaskan cara berpikir tentang risiko. Tidak ada rekomendasi beli, jual, atau sinyal trading.`,
  },
];
---

<BaseLayout>
  <HomeHero />
  <RiskLabTransition />

  <section class="home-section" id="masalah" aria-labelledby="masalah-title">
    <SectionHeading
      id="masalah-title"
      number="01"
      title="Masalah Trader"
      more={{ href: withBase(routes.problems), label: 'Semua masalah' }}
    />
    <ProblemList problems={problems} headingLevel={3} ruled={false} />
  </section>

  <section class="home-section" aria-labelledby="hitung-title">
    <SectionHeading id="hitung-title" number="02" title="Hitung Dulu" />
    <UkuranPosisi />
  </section>

  <section class="home-section" aria-labelledby="konsep-title">
    <SectionHeading
      id="konsep-title"
      number="03"
      title="Kategori"
      more={{ href: withBase(routes.concepts), label: 'Indeks konsep' }}
    />
    <CategoryGrid />
  </section>

  {
    mainPath && (
      <section class="home-section" aria-labelledby="jalur-title">
        <SectionHeading
          id="jalur-title"
          number="04"
          title="Jalur Belajar"
          more={{ href: withBase(routes.learningPaths), label: 'Semua jalur' }}
        />
        <p class="section-lead">
          <strong>{mainPath.title}.</strong> {mainPath.description}
        </p>
        <LearningPathStrip path={mainPath} />
        <p class="section-more">
          <a href={withBase(routes.map)}>Lihat hubungan antar-konsep di peta pengetahuan →</a>
        </p>
      </section>
    )
  }

  <section class="home-section" aria-labelledby="prinsip-title">
    <SectionHeading id="prinsip-title" number="05" title="Prinsip" />
    <ul class="principles">
      {
        principles.map((p) => (
          <li>
            <h3>{p.title}</h3>
            <p>{p.body}</p>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>

<style>
  .home-section {
    padding-top: var(--space-16);
  }

  @media (min-width: 64rem) {
    .home-section {
      padding-top: var(--space-24);
    }
  }

  .section-lead {
    max-width: var(--measure);
    margin: 0 0 var(--space-6);
    color: var(--ink-2);
  }

  .section-lead strong {
    color: var(--ink);
  }

  .section-more {
    margin: var(--space-6) 0 0;
    font-weight: 600;
  }

  .principles {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
    gap: var(--space-8);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .principles h3 {
    margin: 0 0 var(--space-2);
    font-size: var(--text-lg);
  }

  .principles p {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--ink-2);
  }
</style>
