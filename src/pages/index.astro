---
// Beranda: MASALAH TRADER → HITUNG DULU → KONSEP INTI → JALUR BELAJAR (+ prinsip).
// Pintu masuk utama adalah masalah dalam bahasa trader; teori tetap tersedia lewat indeks dan jalur.
import BaseLayout from '../layouts/BaseLayout.astro';
import BrandEmblem from '../components/BrandEmblem.astro';
import ConceptIndexCompact from '../components/ConceptIndexCompact.astro';
import LearningPathStrip from '../components/LearningPathStrip.astro';
import ProblemList from '../components/ProblemList.astro';
import SectionHeading from '../components/SectionHeading.astro';
import UkuranPosisi from '../components/tools/UkuranPosisi.astro';
import { siteConfig } from '../config/site';
import { getLearningPaths } from '../lib/concepts';
import { getProblems } from '../lib/problems';
import { routes, withBase } from '../lib/url';

const problems = await getProblems();
const [mainPath] = await getLearningPaths();

const principles = [
  {
    title: 'Dapat ditelusuri',
    body: 'Setiap klaim harus bisa dilacak ke sumbernya. Halaman tanpa sumber terverifikasi ditandai sebagai draf.',
  },
  {
    title: 'Bertahap',
    body: 'Konsep disusun berdasarkan prasyarat. Setiap halaman menunjukkan apa yang perlu dipahami lebih dulu.',
  },
  {
    title: 'Edukasi, bukan sinyal',
    body: `${siteConfig.product} menjelaskan cara berpikir tentang risiko. Tidak ada rekomendasi beli, jual, atau sinyal trading.`,
  },
];
---

<BaseLayout>
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero__text">
      <p class="eyebrow">{siteConfig.product} · Bagian dari {siteConfig.masterBrand}</p>
      <h1 id="hero-title" class="hero__title">
        {siteConfig.taglineParts.map((part) => <span>{`${part} `}</span>)}
      </h1>
      <p class="hero__lead">
        Mulai dari masalah yang Anda alami saat trading, lalu pahami konsep risiko di baliknya: definisinya,
        contoh hitungannya, dan cara menerapkannya.
      </p>
      <p class="hero__actions">
        <a class="button" href="#masalah">Mulai dari masalah</a>
        <a class="hero__secondary" href={withBase(routes.learningPaths)}>Ikuti jalur belajar →</a>
      </p>
    </div>
    <BrandEmblem variant="hero" />
  </section>

  <section class="home-section" id="masalah" aria-labelledby="masalah-title">
    <SectionHeading
      id="masalah-title"
      number="01"
      title="Masalah Trader"
      more={{ href: withBase(routes.problems), label: 'Semua masalah' }}
    />
    <ProblemList problems={problems} headingLevel={3} ruled={false} />
  </section>

  <section class="home-section" aria-labelledby="hitung-title">
    <SectionHeading id="hitung-title" number="02" title="Hitung Dulu" />
    <UkuranPosisi />
  </section>

  <section class="home-section" aria-labelledby="konsep-title">
    <SectionHeading
      id="konsep-title"
      number="03"
      title="Konsep Inti Risiko"
      more={{ href: withBase(routes.concepts), label: 'Indeks konsep' }}
    />
    <ConceptIndexCompact />
  </section>

  {
    mainPath && (
      <section class="home-section" aria-labelledby="jalur-title">
        <SectionHeading
          id="jalur-title"
          number="04"
          title="Jalur Belajar"
          more={{ href: withBase(routes.learningPaths), label: 'Semua jalur' }}
        />
        <p class="section-lead">
          <strong>{mainPath.title}.</strong> {mainPath.description}
        </p>
        <LearningPathStrip path={mainPath} />
        <p class="section-more">
          <a href={withBase(routes.map)}>Lihat hubungan antar-konsep di peta pengetahuan →</a>
        </p>
      </section>
    )
  }

  <section class="home-section" aria-labelledby="prinsip-title">
    <SectionHeading id="prinsip-title" number="05" title="Prinsip" />
    <ul class="principles">
      {
        principles.map((p) => (
          <li>
            <h3>{p.title}</h3>
            <p>{p.body}</p>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>

<style>
  .hero {
    display: grid;
    gap: var(--space-8);
    align-items: center;
    padding-block: var(--space-4) var(--space-8);
  }

  /* Desktop: teks kiri, artwork kanan. Mobile: artwork di bawah tombol. */
  @media (min-width: 64rem) {
    .hero {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: var(--space-12);
    }
  }

  .hero__title {
    display: flex;
    flex-direction: column;
    margin: var(--space-3) 0 var(--space-4);
    font-size: clamp(var(--text-2xl), 6vw, var(--text-4xl));
    letter-spacing: -0.02em;
  }

  .hero__lead {
    max-width: 52ch;
    margin: 0;
    font-size: var(--text-lg);
    color: var(--ink-2);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-6);
    margin: var(--space-8) 0 0;
  }

  .button {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0 var(--space-6);
    font-weight: 600;
    color: var(--paper);
    background: var(--ink);
    border: var(--border-hair) solid var(--ink);
    border-radius: var(--radius-1);
    text-decoration: none;
  }

  .button:hover {
    color: var(--ink);
    background: transparent;
  }

  .hero__secondary {
    font-weight: 600;
    color: var(--ink);
  }

  .home-section {
    padding-top: var(--space-16);
  }

  @media (min-width: 64rem) {
    .home-section {
      padding-top: var(--space-24);
    }
  }

  .section-lead {
    max-width: var(--measure);
    margin: 0 0 var(--space-6);
    color: var(--ink-2);
  }

  .section-lead strong {
    color: var(--ink);
  }

  .section-more {
    margin: var(--space-6) 0 0;
    font-weight: 600;
  }

  .principles {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
    gap: var(--space-8);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .principles h3 {
    margin: 0 0 var(--space-2);
    font-size: var(--text-lg);
  }

  .principles p {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--ink-2);
  }
</style>
