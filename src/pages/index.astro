---
// Beranda "Modern Digital Museum", enam ruang berurutan:
// HERO (judul + pelat gelap: emblem + instrumen jam pasir modal) → FILOSOFI (Waktu × Harga + prinsip)
// → 01 MASALAH TRADER → 02 SISTEM BELAJAR (rantai Risiko → … → Varians) → 03 INSTRUMEN (ukuran posisi)
// → 04 INDEKS KATEGORI. Pintu masuk utama adalah masalah dalam bahasa trader; teori lewat rantai & indeks.
import BaseLayout from '../layouts/BaseLayout.astro';
import CategoryIndex from '../components/CategoryIndex.astro';
import HomeHero from '../components/HomeHero.astro';
import HomePhilosophy from '../components/HomePhilosophy.astro';
import HomeProblems from '../components/HomeProblems.astro';
import LearningSystem from '../components/LearningSystem.astro';
import SectionHeading from '../components/SectionHeading.astro';
import UkuranPosisi from '../components/tools/UkuranPosisi.astro';
import { getProblems } from '../lib/problems';
import { routes, withBase } from '../lib/url';

const problems = await getProblems();
---

<BaseLayout>
  <HomeHero />
  <HomePhilosophy />
  <HomeProblems problems={problems} number="01" />
  <LearningSystem number="02" />

  <section class="home-section" data-reveal aria-labelledby="instrumen-title">
    <SectionHeading id="instrumen-title" number="03" title="Instrumen" />
    <div class="instrument">
      <div class="instrument__intro">
        <p class="instrument__statement">Ukuran posisi adalah hasil, bukan titik awal.</p>
        <p class="instrument__lead">
          Tentukan dulu berapa yang rela hilang bila stop loss tersentuh. Lot mengikuti dari angka itu, bukan dari
          kebiasaan atau keyakinan.
        </p>
        <p class="instrument__formula">
          <span class="instrument__formula-label">Rumus</span>
          <span>Lot = (Modal × Risiko %)</span>
          <span>&emsp;&ensp;÷ (Stop × Nilai/poin)</span>
        </p>
      </div>
      <div class="instrument__tool">
        <UkuranPosisi variant="instrument" />
      </div>
    </div>
  </section>

  <section class="home-section" data-reveal aria-labelledby="kategori-title">
    <SectionHeading
      id="kategori-title"
      number="04"
      title="Indeks Kategori"
      more={{ href: withBase(routes.concepts), label: 'Indeks konsep' }}
    />
    <CategoryIndex />
  </section>
</BaseLayout>

<style>
  .home-section {
    padding-top: var(--space-16);
  }

  .instrument {
    display: grid;
    gap: var(--space-8) var(--grid-gap);
  }

  .instrument__statement {
    margin: 0;
    font-family: var(--font-serif);
    font-size: var(--text-2xl);
    font-weight: 600;
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-display);
    text-wrap: balance;
  }

  .instrument__lead {
    max-width: var(--measure-narrow);
    margin: var(--space-4) 0 0;
    color: var(--ink-2);
  }

  /* Rumus sebagai keterangan instrumen: mono, garis kiri kuningan, tanpa kotak. */
  .instrument__formula {
    display: grid;
    gap: var(--space-1);
    margin: var(--space-8) 0 0;
    padding-left: var(--space-4);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    border-left: var(--border-mark) solid var(--mark);
  }

  .instrument__formula-label {
    font-size: var(--text-2xs);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
    color: var(--ink-3);
  }

  @media (min-width: 64rem) {
    .home-section {
      padding-top: var(--space-24);
    }

    .instrument {
      grid-template-columns: repeat(var(--grid-columns), minmax(0, 1fr));
      align-items: start;
    }

    .instrument__intro {
      grid-column: 1 / span 4;
      position: sticky;
      top: calc(var(--header-height) + var(--space-8));
    }

    .instrument__statement {
      font-size: var(--text-3xl);
    }

    .instrument__tool {
      grid-column: 6 / -1;
    }
  }
</style>
