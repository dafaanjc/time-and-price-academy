---
// "Di halaman ini": di layar lebar menjadi kolom kanan yang sticky (diatur ConceptLayout),
// di layar sempit tampil ringkas di atas isi.
interface Props {
  sections: { id: string; title: string }[];
}

const { sections } = Astro.props;
---

{
  sections.length > 0 && (
    <nav class="toc" aria-labelledby="toc-title">
      <h2 id="toc-title" class="toc__title">
        Di halaman ini
      </h2>
      <ol>
        {sections.map((s) => (
          <li>
            <a href={`#${s.id}`}>{s.title}</a>
          </li>
        ))}
      </ol>
    </nav>
  )
}

<style>
  .toc {
    max-width: var(--measure);
    margin-bottom: var(--space-8);
    padding-block: var(--space-3);
    border-block: var(--border-hair) solid var(--rule);
  }

  .toc__title {
    margin: 0 0 var(--space-2);
    font-family: var(--font-label);
    font-size: var(--text-sm);
    font-style: italic;
    font-weight: 400;
    font-variant-caps: small-caps;
    letter-spacing: 0.02em;
    color: var(--ink-3);
  }

  ol {
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: toc;
    columns: 2 12rem;
    column-gap: var(--space-8);
    font-size: var(--text-sm);
  }

  li {
    counter-increment: toc;
    break-inside: avoid;
    padding-block: var(--space-1);
  }

  li::before {
    content: counter(toc) '.';
    display: inline-block;
    min-width: 1.5rem;
    color: var(--ink-3);
  }

  a {
    color: var(--ink-2);
    text-decoration: none;
  }

  a:hover {
    color: var(--ink);
    text-decoration: underline;
  }

  /* Mobile: daftar sebaris yang membungkus, agar isi utama naik ke layar pertama. */
  @media (max-width: 47.99rem) {
    ol {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-1) var(--space-4);
      columns: auto;
    }

    li {
      padding-block: 0;
    }

    li::before {
      min-width: 0;
      margin-right: var(--space-1);
    }
  }

  /* Sebagai kolom kanan (≥ 80rem): satu kolom dengan garis kiri, tanpa garis atas/bawah. */
  @media (min-width: 80rem) {
    .toc {
      margin-bottom: 0;
      padding: 0 0 0 var(--space-4);
      border-block: 0;
      border-left: var(--border-hair) solid var(--rule);
    }

    ol {
      columns: 1;
    }
  }
</style>
