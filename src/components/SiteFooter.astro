---
import { siteConfig } from '../config/site';
---

<footer class="site-footer">
  <p class="site-footer__attribution">{siteConfig.attribution}</p>
  <p class="site-footer__meta">
    {siteConfig.product} adalah bagian dari {siteConfig.masterBrand}. Konten bersifat edukasi, bukan saran investasi
    atau sinyal trading.
  </p>
</footer>

<style>
  .site-footer {
    margin-top: 4rem;
    padding: 2rem 0 2.5rem;
    border-top: 1px solid var(--line);
    font-size: 0.875rem;
    color: var(--ink-faint);
  }

  .site-footer p {
    margin: 0;
    max-width: var(--measure);
  }

  .site-footer__attribution {
    font-weight: 600;
    color: var(--ink-soft);
  }

  .site-footer .site-footer__meta {
    margin-top: 0.375rem;
  }
</style>
