---
import { siteConfig } from '../config/site';
import Emblem from './Emblem.astro';
import { routes, withBase } from '../lib/url';

// Emblem maksimal satu kali per halaman: beranda sudah menampilkannya di panggung hero (figures/HeroStage).
const showEmblem = Astro.url.pathname !== withBase(routes.home);
---

<footer class="site-footer">
  {showEmblem && <Emblem variant="footer" />}
  <div class="site-footer__text">
    <p class="site-footer__attribution">{siteConfig.attribution}</p>
    <p class="site-footer__meta">
      {siteConfig.product} adalah bagian dari {siteConfig.masterBrand}. Konten bersifat edukasi, bukan saran
      investasi atau sinyal trading.
    </p>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-6) var(--space-8);
    margin-top: var(--space-16);
    padding: var(--space-8) 0 var(--space-12);
    border-top: var(--border-hair) solid var(--rule);
    font-size: var(--text-sm);
    color: var(--ink-3);
  }

  /* Garis kedua: garis ganda tipis ala kolofon buku. */
  .site-footer::before {
    content: "";
    position: absolute;
    inset-inline: 0;
    top: var(--frame-gap);
    border-top: var(--border-hair) solid var(--rule);
  }

  /* Layar sempit: pelat di atas, teks di bawah. */
  .site-footer__text {
    flex: 1 1 16rem;
  }

  .site-footer p {
    margin: 0;
    max-width: var(--measure);
  }

  /* Kolofon: atribusi dalam italic small caps, keterangan dalam teks biasa. */
  .site-footer__attribution {
    font-style: italic;
    font-variant-caps: small-caps;
    letter-spacing: 0.02em;
    color: var(--ink-2);
  }

  .site-footer .site-footer__meta {
    margin-top: var(--space-1);
  }
</style>
