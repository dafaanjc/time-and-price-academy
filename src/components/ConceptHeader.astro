---
import { getCategory } from '../data/categories';
import { categoryHref, type Concept } from '../lib/concepts';
import Byline from './Byline.astro';
import ConceptMeta from './ConceptMeta.astro';

interface Props {
  concept: Concept;
  url?: string;
}

const { concept, url } = Astro.props;
const { title, termEn, description, category } = concept.data;
---

<header class="concept-header">
  <p class="eyebrow">
    <a href={categoryHref(category)}>{getCategory(category).title}</a>
  </p>
  <h1 class="concept-header__title">{title}</h1>
  {termEn && <p class="concept-header__term">Istilah asli: <span lang="en">{termEn}</span></p>}
  <p class="concept-header__desc">{description}</p>
  <ConceptMeta concept={concept} />
  <Byline url={url} />
</header>

<style>
  .concept-header {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-width: var(--measure);
  }

  .eyebrow a {
    color: inherit;
    text-decoration: none;
  }

  .eyebrow a:hover {
    color: var(--accent);
  }

  .concept-header__title {
    margin: -0.25rem 0 0;
    font-size: clamp(2rem, 5vw, 2.75rem);
  }

  .concept-header__term {
    margin: -0.5rem 0 0;
    font-size: 0.9375rem;
    color: var(--ink-faint);
  }

  .concept-header__term span {
    font-style: italic;
  }

  .concept-header__desc {
    margin: 0;
    font-size: 1.1875rem;
    color: var(--ink-soft);
  }
</style>
