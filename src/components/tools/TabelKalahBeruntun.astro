---
// Alat: kalah beruntun — risiko tetap vs menggandakan risiko setelah rugi. Hitungan pasti, tanpa angka acak.
// Menjawab: "kenapa habis loss gue malah ngejar balik?".
import ToolFrame from './ToolFrame.astro';
import { describeStreak } from '../../lib/calc/describe';
import { losingStreak } from '../../lib/calc/drawdown';
import { formatNumber } from '../../lib/format';

const defaults = { riskPercent: 1, losses: 6 };
const fixed = losingStreak(defaults.riskPercent, defaults.losses, 'fixed');
const doubled = losingStreak(defaults.riskPercent, defaults.losses, 'double');
const pct = (v: number) => `${formatNumber(Math.round(v * 10) / 10)}%`;
const rows = fixed.map((row, i) => ({ loss: row.loss, fixed: row.remainingPercent, doubled: doubled[i]?.remainingPercent ?? 0 }));
---

<ToolFrame
  tool="streak"
  title="Kalah beruntun: risiko tetap vs menggandakan setelah rugi"
  description="Rangkaian kalah beruntun itu normal. Bandingkan sisa modal bila risiko tetap, dengan bila risiko digandakan setiap kali kalah untuk 'balik modal'."
  summary={describeStreak(defaults.losses, fixed.at(-1)?.remainingPercent ?? 100, doubled.at(-1)?.remainingPercent ?? 100)}
>
  <Fragment slot="inputs">
    <label class="field"><span>Risiko awal per transaksi (%)</span><input name="riskPercent" type="number" inputmode="decimal" min="0.1" max="50" step="0.1" value={defaults.riskPercent} /></label>
    <label class="field"><span>Jumlah kalah beruntun</span><input name="losses" type="number" inputmode="numeric" min="1" max="20" step="1" value={defaults.losses} /></label>
  </Fragment>
  <Fragment slot="results">
    <div class="streak__scroll" tabindex="0" role="region" aria-label="Tabel sisa modal per kekalahan">
      <table class="streak">
        <thead>
          <tr>
            <th scope="col">Kalah ke-</th>
            <th scope="col">Sisa modal, risiko tetap</th>
            <th scope="col">Sisa modal, risiko digandakan</th>
          </tr>
        </thead>
        <tbody data-out="rows">
          {
            rows.map((row) => (
              <tr>
                <td>{row.loss}</td>
                <td>{pct(row.fixed)}</td>
                <td class="is-loss">{pct(row.doubled)}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </Fragment>
</ToolFrame>

<script>
  import { describeStreak } from '../../lib/calc/describe';
  import { losingStreak } from '../../lib/calc/drawdown';
  import { formatNumber } from '../../lib/format';

  const pct = (v: number) => `${formatNumber(Math.round(v * 10) / 10)}%`;

  for (const form of document.querySelectorAll<HTMLFormElement>('form[data-tool="streak"]')) {
    const value = (name: string) => (form.elements.namedItem(name) as HTMLInputElement).valueAsNumber;
    const body = form.querySelector<HTMLElement>('[data-out="rows"]')!;
    const summary = form.querySelector<HTMLElement>('[data-summary]')!;

    const cell = (text: string, className?: string): HTMLTableCellElement => {
      const td = document.createElement('td');
      td.textContent = text;
      if (className) td.className = className;
      return td;
    };

    const update = (): void => {
      const risk = value('riskPercent');
      const losses = Math.round(value('losses'));
      if (!(risk > 0 && risk <= 50 && losses >= 1 && losses <= 20)) {
        body.replaceChildren();
        summary.textContent = 'Isi risiko 0,1–50% dan jumlah kalah 1–20.';
        return;
      }
      const fixed = losingStreak(risk, losses, 'fixed');
      const doubled = losingStreak(risk, losses, 'double');
      body.replaceChildren(
        ...fixed.map((row, i) => {
          const tr = document.createElement('tr');
          tr.append(cell(String(row.loss)), cell(pct(row.remainingPercent)), cell(pct(doubled[i]?.remainingPercent ?? 0), 'is-loss'));
          return tr;
        }),
      );
      summary.textContent = describeStreak(losses, fixed.at(-1)?.remainingPercent ?? 100, doubled.at(-1)?.remainingPercent ?? 100);
    };

    form.addEventListener('input', update);
    form.addEventListener('submit', (event) => event.preventDefault());
    update();
  }
</script>

<style>
  .streak__scroll {
    overflow-x: auto;
  }

  .streak {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--text-sm);
    font-variant-numeric: tabular-nums;
  }

  .streak th,
  .streak :global(td) {
    padding: var(--space-2) var(--space-3);
    text-align: right;
    border-bottom: var(--border-hair) solid var(--rule);
  }

  .streak th:first-child,
  .streak :global(td:first-child) {
    text-align: left;
  }

  .streak th {
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--ink-3);
  }
</style>
