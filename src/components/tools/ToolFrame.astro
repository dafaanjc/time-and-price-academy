---
// Kerangka bersama alat hitung: label, judul, lalu empat tahap berlabel (R10) —
// 01 Input (slot "inputs") → 02 Asumsi (catatan batasan) → 03 Hasil (slot "results") →
// 04 Konsekuensi (ringkasan satu kalimat, aria-live). Tanpa JavaScript, hasil awal (dihitung di server dari
// nilai default) tetap tampil. Angka hasil yang berubah setelah pengguna mengubah input diberi tanda
// kuningan sekali (`.value-changed`, kosakata gerak "konsekuensi"); tidak pernah saat halaman dimuat.
interface Props {
  /** Nama alat untuk skrip (data-tool). */
  tool: string;
  title: string;
  description: string;
  /** Ringkasan hasil awal (juga diperbarui skrip). */
  summary: string;
  /**
   * Tampilan selalu instrumen ukur (R9: satu gaya alat hitung di seluruh situs). Varian hanya mengatur
   * penempatan: `default` = di dalam artikel MDX (lebar baca, jarak atas-bawah); `instrument` = berdiri
   * sendiri di beranda (mengisi kolomnya).
   */
  variant?: 'default' | 'instrument';
  /** Label kecil di atas judul. */
  label?: string;
  /** Catatan batasan alat (default: catatan spesifikasi instrumen/broker untuk alat hitung posisi). */
  note?: string;
}

const DEFAULT_NOTE =
  'Alat bantu hitung untuk belajar, bukan rekomendasi. Spesifikasi (nilai per poin, margin, level stop out) berbeda tiap instrumen dan broker.';
const { tool, title, description, summary, variant = 'default', label = 'Alat hitung', note = DEFAULT_NOTE } = Astro.props;
---

<form class:list={['tool', 'tool--instrument', { 'tool--embedded': variant === 'default' }]} data-tool={tool} novalidate>
  <header class="tool__header">
    <p class="tool__label">{label}</p>
    <h3 class="tool__title">{title}</h3>
    <p class="tool__desc">{description}</p>
  </header>
  <p class="tool__stage label"><span class="label__index">01</span><span class="label__sep" aria-hidden="true">·</span>Input</p>
  <div class="tool__inputs">
    <slot name="inputs" />
  </div>
  <p class="tool__stage label"><span class="label__index">02</span><span class="label__sep" aria-hidden="true">·</span>Asumsi</p>
  <p class="tool__note tool__assumption">{note}</p>
  <noscript><p class="tool__note">Aktifkan JavaScript untuk menghitung dengan angka Anda sendiri.</p></noscript>
  <p class="tool__stage label tool__stage--results"><span class="label__index">03</span><span class="label__sep" aria-hidden="true">·</span>Hasil</p>
  <div class="tool__results">
    <slot name="results" />
  </div>
  <p class="tool__stage label"><span class="label__index">04</span><span class="label__sep" aria-hidden="true">·</span>Konsekuensi</p>
  <p class="tool__summary" data-summary aria-live="polite">{summary}</p>
</form>

<script>
  // Kosakata gerak "konsekuensi": angka di .readout yang berubah setelah pengguna bertindak diberi tanda sekali.
  for (const form of document.querySelectorAll<HTMLFormElement>('form.tool')) {
    let armed = false;
    const arm = () => (armed = true);
    form.addEventListener('input', arm);
    form.addEventListener('change', arm);
    form.addEventListener('click', arm);
    const mark = (el: Element | null) => {
      if (!el) return;
      el.classList.remove('value-changed');
      void (el as HTMLElement).offsetWidth; // mulai ulang animasi
      el.classList.add('value-changed');
    };
    new MutationObserver((records) => {
      if (!armed) return;
      const seen = new Set<Element>();
      for (const r of records) {
        const node = r.target.nodeType === Node.TEXT_NODE ? r.target.parentElement : (r.target as Element);
        const dd = node?.closest('.readout dd');
        if (dd && !seen.has(dd)) {
          seen.add(dd);
          mark(dd);
        }
      }
    }).observe(form, { subtree: true, childList: true, characterData: true });
  }
</script>

<style>
  .tool {
    max-width: var(--measure);
    margin: var(--space-8) 0;
    padding: var(--space-6) clamp(var(--space-4), 4vw, var(--space-6));
    background: var(--surface);
    border: var(--border-hair) solid var(--rule);
    border-top: var(--border-mark) solid var(--ink);
  }

  .tool__header {
    margin-bottom: var(--space-4);
  }

  .tool__label {
    margin: 0;
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .tool__title {
    margin: var(--space-1) 0 var(--space-2);
    font-size: var(--text-lg);
  }

  .tool__desc {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--ink-2);
  }

  /* Dua kolom sudah muncul di ponsel (≥ ~19rem) agar alat dengan banyak input tidak terlalu panjang. */
  .tool__inputs {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 9rem), 1fr));
    gap: var(--space-4) var(--space-3);
    align-items: end;
  }

  .tool__results {
    margin-top: var(--space-6);
    padding-top: var(--space-4);
    border-top: var(--border-hair) solid var(--rule);
  }

  .tool__summary {
    margin: var(--space-4) 0 0;
    font-weight: 600;
  }

  .tool__note {
    margin: var(--space-3) 0 0;
    font-size: var(--text-xs);
    color: var(--ink-3);
  }

  /* Gaya bersama untuk isi slot (input & hasil) di semua alat. */
  .tool :global(.field) {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    font-size: var(--text-sm);
  }

  .tool :global(.field span) {
    color: var(--ink-2);
  }

  /* Target sentuh ≥ 44px (2,75rem) untuk input, slider, dan tombol di semua alat. */
  .tool :global(.field input) {
    min-height: 2.75rem;
    padding: 0 var(--space-3);
    font: inherit;
    font-variant-numeric: tabular-nums;
    color: var(--ink);
    background: var(--paper);
    border: var(--border-hair) solid var(--ink-3);
    border-radius: var(--radius-1);
  }

  .tool :global(.field input[type='range']) {
    padding: 0;
    border: 0;
    background: transparent;
    accent-color: var(--ink);
  }

  .tool :global(.field input:focus-visible) {
    outline: 2px solid var(--ink);
    outline-offset: 1px;
  }

  .tool :global(.field input[aria-invalid='true']) {
    border-color: var(--loss);
  }

  .tool :global(.field output) {
    font-variant-numeric: tabular-nums;
    color: var(--ink);
  }

  /* Tombol sekunder bersama (mis. "Simulasi ulang"): garis tipis, tanpa isian. */
  .tool :global(.tool__button) {
    min-height: 2.75rem;
    padding: 0 var(--space-4);
    font: inherit;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--ink);
    background: transparent;
    border: var(--border-hair) solid var(--ink-3);
    border-radius: var(--radius-1);
    cursor: pointer;
    touch-action: manipulation;
    transition: border-color var(--motion-fast) var(--ease);
  }

  .tool :global(.tool__button:hover) {
    border-color: var(--ink);
  }

  .tool :global(.tool__button:focus-visible) {
    outline: 2px solid var(--ink);
    outline-offset: 2px;
  }

  /* Sakelar (checkbox) satu baris dengan target sentuh penuh. */
  .tool :global(.toggle) {
    display: flex;
    gap: var(--space-2);
    align-items: center;
    min-height: 2.75rem;
    font-size: var(--text-sm);
    color: var(--ink-2);
    cursor: pointer;
  }

  .tool :global(.toggle input) {
    width: 1.125rem;
    height: 1.125rem;
    margin: 0;
    accent-color: var(--mark);
  }

  /* ---------- Plot alat (SVG + label HTML) ----------
     SVG meregang ke lebar wadah (preserveAspectRatio="none") dengan garis non-scaling, sehingga garis
     tetap setipis rambut di ponsel. Label ditulis sebagai HTML yang diposisikan dengan persen, jadi tetap
     terbaca (tidak ikut mengecil bersama viewBox). */
  .tool :global(.plot) {
    margin: var(--space-6) 0 0;
  }

  .tool :global(.plot__caption) {
    margin-bottom: var(--space-2);
    font-size: var(--text-xs);
    color: var(--ink-3);
  }

  .tool :global(.plot__stage) {
    position: relative;
  }

  .tool :global(.plot__svg) {
    display: block;
    width: 100%;
    height: clamp(9rem, 42vw, 13.5rem);
    overflow: visible;
  }

  .tool :global(.plot__svg--short) {
    height: clamp(5.5rem, 22vw, 7.5rem);
  }

  .tool :global(.plot__svg *) {
    vector-effect: non-scaling-stroke;
  }

  .tool :global(.plot__axis) {
    position: relative;
    height: 1.5rem;
    margin: 0;
    border-top: var(--border-hair) solid var(--rule-strong);
  }

  .tool :global(.plot__tick),
  .tool :global(.plot__tag) {
    position: absolute;
    font-family: var(--font-label);
    font-size: var(--text-2xs);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--ink-3);
    font-variant-numeric: tabular-nums;
  }

  .tool :global(.plot__tick) {
    top: var(--space-1);
    transform: translateX(-50%);
  }

  .tool :global(.plot__tick::before) {
    content: '';
    position: absolute;
    top: calc(-1 * var(--space-1) - 1px);
    left: 50%;
    width: var(--stroke-hair);
    height: var(--tick-minor);
    background: var(--rule-strong);
  }

  .tool :global(.plot__tick:first-child) {
    transform: none;
  }

  .tool :global(.plot__tick:first-child::before) {
    left: 0;
  }

  .tool :global(.plot__tick:last-child) {
    transform: translateX(-100%);
  }

  .tool :global(.plot__tick:last-child::before) {
    left: auto;
    right: 0;
  }

  .tool :global(.plot__axis-title) {
    margin: var(--space-1) 0 0;
    font-family: var(--font-label);
    font-size: var(--text-2xs);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
    text-align: right;
    color: var(--ink-3);
  }

  .tool :global(.plot__tag) {
    top: 0;
    padding: 0 var(--space-1);
    transform: translateX(-50%);
    background: var(--surface);
  }

  .tool :global(.plot__tag--mark) {
    color: var(--mark);
  }

  .tool :global(.plot__tag--ink) {
    color: var(--ink);
  }

  /* Label tanda di dekat tepi tidak keluar dari bidang. */
  .tool :global(.plot__tag[data-edge='start']) {
    transform: none;
  }

  .tool :global(.plot__tag[data-edge='end']) {
    transform: translateX(-100%);
  }

  .tool :global(.plot__tag[hidden]) {
    display: none;
  }

  .tool :global(.sim-tag) {
    margin-right: var(--space-2);
    padding: 0 var(--space-2);
    font-weight: 600;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--caution);
    background: var(--caution-bg);
  }

  .tool :global(.readout) {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 9rem), 1fr));
    gap: var(--space-3) var(--space-6);
    margin: 0;
  }

  .tool :global(.readout dt) {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .tool :global(.readout dd) {
    margin: var(--space-1) 0 0;
    font-size: var(--text-lg);
    font-weight: 600;
  }

  .tool :global(.is-loss) {
    color: var(--loss);
  }

  .tool :global(.is-gain) {
    color: var(--gain);
  }

  /* ---------- Gaya instrumen (semua alat) ----------
     Pelat instrumen: bingkai garis tegas, label mono, input angka mono rata kanan seperti jendela
     pembacaan, hasil sebagai angka serif besar. Tanpa bayangan; sorotan hanya garis kuningan. */
  .tool--instrument {
    max-width: none;
    margin: 0;
    padding: 0;
    border: var(--border-hair) solid var(--rule-strong);
    border-top: var(--border-hair) solid var(--rule-strong);
  }

  .tool--instrument .tool__header {
    margin: 0;
    padding: var(--space-4) var(--space-6);
    border-bottom: var(--border-hair) solid var(--rule);
  }

  .tool--instrument .tool__label {
    font-family: var(--font-label);
    font-size: var(--text-label);
    font-weight: 400;
    letter-spacing: var(--tracking-mono);
    color: var(--mark);
  }

  .tool--instrument .tool__title {
    font-size: var(--text-xl);
  }

  .tool--instrument .tool__inputs {
    padding: var(--space-6);
    gap: var(--space-4) var(--space-4);
  }

  .tool--instrument .tool__results {
    margin: 0;
    padding: var(--space-3) var(--space-6) var(--space-6);
    border-top: 0;
    background: var(--paper);
  }

  /* Label tahap: 01 Input · 02 Asumsi · 03 Hasil · 04 Konsekuensi. */
  .tool--instrument .tool__stage {
    margin: 0;
    padding: var(--space-3) var(--space-6) 0;
    font-size: var(--text-2xs);
  }

  .tool--instrument .tool__stage--results {
    border-top: var(--border-hair) solid var(--rule-strong);
    background: var(--paper);
  }

  .tool--instrument .tool__inputs {
    padding-top: var(--space-3);
  }

  .tool--instrument .tool__note {
    margin: 0;
    padding: var(--space-2) var(--space-6) var(--space-4);
  }

  .tool--instrument .tool__summary {
    margin: 0;
    padding: var(--space-2) var(--space-6) var(--space-6);
    font-size: var(--text-base);
  }

  .tool--instrument .tool__stage:has(+ .tool__summary) {
    border-top: var(--border-hair) solid var(--rule);
  }

  .tool--instrument :global(.field span) {
    font-family: var(--font-label);
    font-size: var(--text-label);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .tool--instrument :global(.field input) {
    font-family: var(--font-mono);
    font-size: var(--text-base);
    text-align: right;
    background: var(--surface);
    border-color: var(--rule-strong);
    border-radius: var(--radius-0);
    transition: border-color var(--motion-fast) var(--ease);
  }

  .tool--instrument :global(.field input:hover) {
    border-color: var(--ink-3);
  }

  .tool--instrument :global(.field input:focus-visible) {
    outline: 2px solid var(--mark);
    outline-offset: 1px;
    border-color: var(--mark);
  }

  .tool--instrument :global(.readout dt) {
    font-family: var(--font-label);
    font-size: var(--text-label);
    font-weight: 400;
    letter-spacing: var(--tracking-mono);
  }

  .tool--instrument :global(.readout dd) {
    font-family: var(--font-serif);
    font-size: var(--text-2xl);
    line-height: 1.1;
  }

  .tool--instrument :global(.readout > div) {
    padding-left: var(--space-3);
    border-left: var(--border-hair) solid var(--rule-strong);
  }

  .tool--instrument :global(.readout > .readout__primary) {
    border-left: var(--border-mark) solid var(--mark);
  }

  /* Label plot dan penanda simulasi menutup garis dengan warna bidang hasil (paper), bukan surface. */
  .tool--instrument :global(.plot__tag) {
    background: var(--paper);
  }

  /* Di dalam artikel: lebar baca dan jarak dari paragraf di sekitarnya. */
  .tool--embedded {
    max-width: var(--measure);
    margin: var(--space-8) 0;
  }
</style>
