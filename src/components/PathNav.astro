---
// Navigasi "Sebelumnya / Berikutnya" berdasarkan urutan jalur belajar.
// Di langkah terakhir, "Berikutnya" menunjuk jalur tahap berikutnya (jalur yang membutuhkan jalur ini).
import { conceptHref, pathAnchor, type PathContext } from '../lib/concepts';
import { routes, withBase } from '../lib/url';

interface Props {
  context: PathContext;
}

const { path, index, prev, next, nextPaths } = Astro.props.context;
const nextPath = next ? undefined : nextPaths[0];
const position = `Langkah ${index + 1} dari ${path.steps.length}`;
---

<nav class="path-nav" aria-label={`Jalur belajar: ${path.title}`}>
  <p class="path-nav__position">
    <a href={withBase(routes.learningPaths)}>{path.title}</a> · {position}
  </p>
  <div class="path-nav__links">
    {
      prev && (
        <a class="path-nav__link path-nav__link--prev" href={conceptHref(prev.id)} rel="prev">
          <span class="path-nav__label">← Sebelumnya</span>
          <span class="path-nav__title">{prev.data.title}</span>
        </a>
      )
    }
    {
      next && (
        <a class="path-nav__link path-nav__link--next" href={conceptHref(next.id)} rel="next">
          <span class="path-nav__label">Berikutnya →</span>
          <span class="path-nav__title">{next.data.title}</span>
        </a>
      )
    }
    {
      nextPath && (
        <a class="path-nav__link path-nav__link--next" href={`${withBase(routes.learningPaths)}#${pathAnchor(nextPath.id)}`}>
          <span class="path-nav__label">Jalur berikutnya →</span>
          <span class="path-nav__title">{nextPath.title}</span>
        </a>
      )
    }
  </div>
</nav>

<style>
  .path-nav {
    max-width: var(--measure);
    padding-top: 1.5rem;
    border-top: 1px solid var(--rule);
  }

  .path-nav__position {
    margin: 0 0 0.75rem;
    font-size: var(--text-sm);
    color: var(--ink-3);
  }

  .path-nav__links {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
    gap: 0.5rem;
  }

  .path-nav__link {
    display: flex;
    flex-direction: column;
    padding: 0.75rem 1rem;
    text-decoration: none;
    background: var(--surface);
    border: 1px solid var(--rule-strong);
    border-top: var(--border-mark) double var(--brass);
    border-radius: var(--radius-1);
  }

  .path-nav__link:hover {
    border-color: var(--brass);
  }

  /* "Berikutnya" selalu di kolom kanan, meski tidak ada "Sebelumnya". */
  .path-nav__link--next {
    grid-column: -2;
    text-align: right;
  }

  .path-nav__label {
    font-family: var(--font-label);
    font-size: var(--text-sm);
    font-style: italic;
    font-variant-caps: small-caps;
    color: var(--ink-3);
  }

  .path-nav__title {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    line-height: var(--leading-tight);
  }
</style>
