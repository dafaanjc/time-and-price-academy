---
// Katalog jilid (Tahap 5): tiap konsep satu entri — nomor jilid Bodoni, judul, istilah asli, tingkat, deskripsi.
// Dipakai oleh ConceptIndex (/konsep/) dan halaman kategori. Tick kuningan saat ditunjuk (`.row-link`, R10).
import { conceptHref, difficultyLabels, type Concept } from '../lib/concepts';

interface Props {
  concepts: Concept[];
}

const { concepts } = Astro.props;
---

<ol class="concept-rows">
  {
    concepts.map((concept) => (
      <li class="concept-rows__item row-link">
        <a class="concept-rows__title" href={conceptHref(concept.id)}>
          {concept.data.title}
        </a>
        <span class="concept-rows__meta">
          {concept.data.termEn && <span lang="en">{concept.data.termEn}</span>}{' '}
          <span>{difficultyLabels[concept.data.difficulty]}</span>
        </span>
        <p class="concept-rows__desc">{concept.data.description}</p>
      </li>
    ))
  }
</ol>

<style>
  .concept-rows {
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: concept;
  }

  .concept-rows__item {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr) auto;
    column-gap: var(--space-2);
    padding-block: var(--space-3);
    border-bottom: var(--border-hair) solid var(--rule);
    counter-increment: concept;
  }

  .concept-rows__item:first-child {
    padding-top: 0;
  }

  /* Nomor jilid seperti kartu katalog perpustakaan: Bodoni, kuningan. */
  .concept-rows__item::before {
    content: counter(concept, decimal-leading-zero);
    grid-row: 1 / span 2;
    font-family: var(--font-display);
    font-size: var(--text-xl);
    line-height: 1.1;
    letter-spacing: var(--tracking-display);
    color: var(--mark);
  }

  .concept-rows__title {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: var(--weight-display);
    line-height: var(--leading-tight);
    color: var(--ink);
    text-decoration: none;
  }

  .concept-rows__title:hover {
    text-decoration: underline;
  }

  .concept-rows__meta {
    display: flex;
    gap: var(--space-3);
    font-family: var(--font-label);
    font-size: var(--text-sm);
    font-variant-caps: small-caps;
    color: var(--ink-3);
    white-space: nowrap;
  }

  .concept-rows__meta [lang='en'] {
    font-style: italic;
  }

  .concept-rows__desc {
    grid-column: 2 / -1;
    margin: var(--space-1) 0 0;
    font-size: var(--text-sm);
    color: var(--ink-2);
  }

  @media (max-width: 29.99rem) {
    .concept-rows__meta {
      grid-column: 2 / -1;
    }
  }
</style>
