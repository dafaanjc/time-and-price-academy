---
// Indeks semua konsep per kategori, bergaya daftar isi: label kategori di kiri, baris konsep di kanan.
// Dipakai di /konsep/. Kategori kosong digabung menjadi satu baris. Baris konsep: ConceptRows.
import { categoryHref, getCategoryIndex } from '../lib/concepts';
import ConceptRows from './ConceptRows.astro';

interface Props {
  /** Tingkat heading untuk nama kategori, sesuai posisinya di halaman. */
  headingLevel?: 2 | 3;
}

const { headingLevel = 2 } = Astro.props;
const Heading = `h${headingLevel}` as const;
const { active, upcoming } = await getCategoryIndex();
---

<div class="concept-index">
  {
    active.map(({ category, concepts }) => (
      <section class="concept-index__group">
        <div class="concept-index__label">
          <Heading class="concept-index__category">
            <a href={categoryHref(category.id)}>{category.title}</a>
          </Heading>
          <p class="concept-index__count">{concepts.length} konsep</p>
        </div>
        <ConceptRows concepts={concepts} />
      </section>
    ))
  }
  {
    upcoming.length > 0 && (
      <p class="concept-index__upcoming">
        <span>Segera hadir</span>{' '}
        {upcoming.map((c) => c.title).join(' · ')}
      </p>
    )
  }
</div>

<style>
  .concept-index__group {
    display: grid;
    gap: var(--space-4);
    padding-block: var(--space-6);
    border-top: var(--border-mark) solid var(--ink);
  }

  @media (min-width: 48rem) {
    .concept-index__group {
      grid-template-columns: 12rem minmax(0, 1fr);
      gap: var(--space-8);
    }
  }

  .concept-index__category {
    margin: 0;
    font-size: var(--text-xl);
  }

  .concept-index__category a {
    color: var(--ink);
    text-decoration: none;
  }

  .concept-index__category a:hover {
    text-decoration: underline;
  }

  .concept-index__count {
    margin: var(--space-1) 0 0;
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .concept-index__upcoming {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    margin: 0;
    padding-top: var(--space-6);
    border-top: var(--border-hair) solid var(--rule);
    font-size: var(--text-sm);
    color: var(--ink-3);
  }

  .concept-index__upcoming span {
    font-weight: 600;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    font-size: var(--text-xs);
    line-height: 1.9;
  }
</style>
