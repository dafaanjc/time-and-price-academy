---
// Pelat sitasi seperti label objek museum: baris mono (JENIS · TAHUN · DOI), judul serif, bingkai hairline.
import { sourceTypeLabels } from '../data/source-types';
import { sourceHref, type Source } from '../lib/sources';

interface Props {
  source: Source;
  /** Nomor urut sumber (mulai dari 1); ditampilkan sebagai indeks kuningan. */
  index?: number;
}

const { source, index } = Astro.props;
const href = sourceHref(source);
const authors = source.authors.join(', ');
const identifiers = [
  source.publisher,
  source.doi && `DOI: ${source.doi}`,
  source.isbn && `ISBN: ${source.isbn}`,
].filter(Boolean);
---

<article class="source-card">
  <p class="label source-card__meta" data-type={source.type}>
    {index !== undefined && <span class="label__index">{String(index).padStart(2, '0')}</span>}{' '}
    {index !== undefined && <span class="label__sep" aria-hidden="true">·</span>}{' '}
    <span>{sourceTypeLabels[source.type]}</span>{' '}
    {source.year && <span class="label__sep" aria-hidden="true">·</span>}{' '}
    {source.year && <span>{source.year}</span>}
  </p>
  <h3 class="source-card__title">
    {
      href ? (
        <a href={href} rel="noopener noreferrer" target="_blank">
          <cite>{source.title}</cite>
          <span class="visually-hidden"> (membuka tab baru)</span>
        </a>
      ) : (
        <cite>{source.title}</cite>
      )
    }
  </h3>
  {authors && <p class="source-card__byline">{authors}</p>}
  {identifiers.length > 0 && <p class="label source-card__ids">{identifiers.join(' · ')}</p>}
  {source.note && <p class="source-card__note">{source.note}</p>}
</article>

<style>
  .source-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-4);
    background: var(--surface);
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius-0);
  }

  .source-card p {
    margin: 0;
  }

  .source-card__title {
    margin: 0;
    font-family: var(--font-serif);
    font-size: var(--text-lg);
    font-weight: 600;
    line-height: 1.35;
    overflow-wrap: anywhere;
  }

  cite {
    font-style: normal;
  }

  .source-card__title a {
    color: var(--ink);
  }

  .source-card__byline {
    font-size: var(--text-sm);
    color: var(--ink-2);
    overflow-wrap: anywhere;
  }

  .source-card__ids {
    overflow-wrap: anywhere;
  }

  .source-card .source-card__note {
    margin-top: var(--space-1);
    padding-top: var(--space-2);
    border-top: 1px solid var(--rule);
    font-size: var(--text-sm);
    color: var(--ink-3);
  }
</style>
