---
// Catatan draf (R9): satu baris di antara dua garis rambut, bukan panel berwarna, agar status draf jelas
// tanpa mengalahkan judul halaman. Tag mono berwarna --caution (≥ 6:1 pada paper di kedua tema).
---

<p class="draft-line" role="note">
  <span class="draft-line__tag">Draf</span>{' '}
  <span><slot /></span>
</p>

<style>
  .draft-line {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    max-width: var(--measure);
    margin: 0;
    padding: var(--space-2) 0;
    font-size: var(--text-sm);
    color: var(--ink-2);
    border-block: var(--border-hair) solid var(--rule);
  }

  .draft-line__tag {
    flex: none;
    font-family: var(--font-label);
    font-size: var(--text-label);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
    color: var(--caution);
  }
</style>
