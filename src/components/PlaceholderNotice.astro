---
// Pita tipis untuk halaman berstatus draf: tidak mendominasi, tetapi tetap jelas.
---

<p class="draft-ribbon" role="note">
  <span class="draft-ribbon__tag">Draf</span>{' '}
  <span><slot /></span>
</p>

<style>
  .draft-ribbon {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    max-width: var(--measure);
    margin: 0;
    padding: var(--space-2) var(--space-3);
    font-size: var(--text-sm);
    color: var(--caution);
    background: var(--caution-bg);
    border-left: var(--border-mark) solid var(--caution);
  }

  .draft-ribbon__tag {
    flex: none;
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }
</style>
