---
interface Props {
  title?: string;
}

const { title = 'Konsep ini masih draf' } = Astro.props;
---

<aside class="placeholder-notice" role="note">
  <p class="placeholder-notice__title">{title}</p>
  <p class="placeholder-notice__body"><slot /></p>
</aside>

<style>
  .placeholder-notice {
    max-width: var(--measure);
    padding: 0.875rem 1.125rem;
    color: var(--warn-ink);
    background: var(--warn-bg);
    border-radius: var(--radius);
  }

  .placeholder-notice p {
    margin: 0;
  }

  .placeholder-notice__title {
    font-weight: 700;
  }

  .placeholder-notice__body {
    font-size: 0.9375rem;
  }
</style>
