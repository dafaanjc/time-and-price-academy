---
// Menyalin URL halaman. Memakai URL canonical bila tersedia (SITE_URL di-set).
interface Props {
  url?: string;
}

const { url } = Astro.props;
---

<button class="copy-link" type="button" data-url={url}>
  <svg aria-hidden="true" width="16" height="16" viewBox="0 0 16 16">
    <path
      d="M6.5 9.5l3-3M7 4.5l1.2-1.2a2.8 2.8 0 014 4L11 8.5M9 11.5l-1.2 1.2a2.8 2.8 0 01-4-4L5 7.5"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"></path>
  </svg>
  <span class="copy-link__label">Salin tautan</span>
</button>
<span class="copy-link__status visually-hidden" role="status"></span>

<script>
  const RESET_MS = 2000;

  // Clipboard API tersedia di HTTPS dan localhost. Bila gagal, tampilkan pesan.
  async function copyText(text: string): Promise<boolean> {
    try {
      await navigator.clipboard.writeText(text);
      return true;
    } catch {
      return false;
    }
  }

  for (const button of document.querySelectorAll<HTMLButtonElement>('.copy-link')) {
    const label = button.querySelector('.copy-link__label');
    const status = button.nextElementSibling;
    const original = label?.textContent ?? '';

    button.addEventListener('click', async () => {
      const ok = await copyText(button.dataset.url || location.href);
      const message = ok ? 'Tautan disalin' : 'Gagal menyalin tautan';
      if (label) label.textContent = message;
      if (status) status.textContent = message;
      button.dataset.state = ok ? 'done' : 'error';
      setTimeout(() => {
        if (label) label.textContent = original;
        if (status) status.textContent = '';
        delete button.dataset.state;
      }, RESET_MS);
    });
  }
</script>

<style>
  .copy-link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    min-height: 2.25rem;
    padding: 0 0.75rem;
    font: inherit;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--accent);
    background: transparent;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    cursor: pointer;
  }

  .copy-link:hover {
    border-color: var(--accent);
  }

  .copy-link[data-state='done'] {
    background: var(--accent-soft);
    border-color: var(--accent);
  }

  .copy-link[data-state='error'] {
    color: var(--warn-ink);
    background: var(--warn-bg);
  }
</style>
