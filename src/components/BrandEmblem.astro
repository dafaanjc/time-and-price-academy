---
// Artwork emblem merek induk (figur klasik + jam pasir), dari aset resmi di src/assets/Logo/.
// Aturan pakai (docs/architecture.md → "Merek"): maksimal SATU kali per halaman, tidak di header,
// tidak dipotong, tidak diwarnai ulang. Latar gambar dilebur dengan blend mode:
// - `plate` (hero beranda): SELALU versi gelap (1024px, satu-satunya sumber yang tajam di ukuran besar)
//   di atas pelat gelap, `screen` → latar hitam murni melebur ke warna pelat. Sama di kedua tema.
// - `footer`, tema gelap: versi gelap + `screen`;
//   tema terang: versi terang (latar abu-abu ±227) + `brightness(1.16)` agar latar menjadi putih,
//   lalu `multiply` → putih menjadi transparan di atas warna kertas. Garis etsa tidak berubah.
import { getImage } from 'astro:assets';
import { siteConfig } from '../config/site';
import emblemDark from '../assets/Logo/black logo.png';
import emblemLight from '../assets/Logo/logos.jpeg';

interface Props {
  /** `plate`: objek pameran di pelat hero beranda; `footer`: tanda kecil di footer halaman lain. */
  variant: 'plate' | 'footer';
}

const { variant } = Astro.props;
const isPlate = variant === 'plate';

// Lebar tampil maksimum (CSS px). Versi terang hanya 433px, jadi hanya dipakai di ukuran kecil.
const displayWidth = isPlate ? 280 : 96;
const sizes = isPlate ? '(min-width: 64rem) 280px, 168px' : '96px';
const widths = (max: number) => [displayWidth, displayWidth * 2].map((w) => Math.min(w, max));

const dark = await getImage({ src: emblemDark, widths: widths(emblemDark.width), format: 'webp' });
const light = isPlate ? dark : await getImage({ src: emblemLight, widths: widths(emblemLight.width), format: 'webp' });
const source = isPlate ? emblemDark : emblemLight;
const height = Math.round((displayWidth * source.height) / source.width);
---

<picture class={`emblem emblem--${variant}`}>
  {!isPlate && <source media="(prefers-color-scheme: dark)" srcset={dark.srcSet.attribute} sizes={sizes} />}
  <img
    src={light.src}
    srcset={light.srcSet.attribute}
    sizes={sizes}
    width={displayWidth}
    height={height}
    alt={isPlate ? siteConfig.emblemAlt : ''}
    loading={isPlate ? 'eager' : 'lazy'}
    decoding="async"
  />
</picture>

<style>
  .emblem {
    display: block;
    flex: none;
  }

  .emblem img {
    display: block;
    width: 100%;
    height: auto;
    /* Tema terang: latar abu-abu versi terang → putih → melebur ke kertas. */
    filter: brightness(1.16);
    mix-blend-mode: multiply;
  }

  .emblem--plate {
    width: min(280px, 100%);
  }

  /* Pelat selalu gelap: versi gelap, latar hitam melebur lewat `screen` di kedua tema. */
  .emblem--plate img {
    filter: none;
    mix-blend-mode: screen;
  }

  .emblem--footer {
    width: 96px;
  }

  @media (prefers-color-scheme: dark) {
    .emblem img {
      /* Tema gelap: versi gelap berlatar hitam murni; `screen` membuat hitam transparan. */
      filter: none;
      mix-blend-mode: screen;
    }
  }
</style>
