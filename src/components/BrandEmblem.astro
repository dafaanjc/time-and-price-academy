---
// Artwork emblem resmi tanpa pelat/bingkai: satu lapisan di panggung hero (figures/HeroStage) sampai hero
// dibangun ulang (docs/redesign-brief.md → Tahap 3). Di tempat lain emblem tampil sebagai pelat lewat Emblem.astro.
// Aturan pakai (docs/architecture.md → "Merek"): maksimal SATU kali per halaman, tidak di header, tidak digambar
// ulang, tidak diwarnai ulang, tidak diberi efek (bevel/3D/logam). Potongan hanya potongan bingkai panggung
// (jubah bawah & bahu kiri); kepala dan jam pasir selalu utuh.
// Selalu versi gelap (1024px, satu-satunya sumber yang tajam di ukuran besar) di atas pelat gelap;
// `screen` membuat latar hitam murni melebur ke warna pelat. Ukuran & potongan diatur oleh wadahnya.
import { getImage } from 'astro:assets';
import { siteConfig } from '../config/site';
import emblemPlate from '../assets/brand/logo-plate.png';

// Panggung hero: emblem ±86% lebar panggung (±690px di layar 1440) atau ±117% lebar layar di ponsel.
const displayWidth = 1024;
const sizes = '(min-width: 64rem) 60vw, 117vw';
const image = await getImage({ src: emblemPlate, widths: [480, 720, 1024], format: 'webp' });
const height = Math.round((displayWidth * emblemPlate.height) / emblemPlate.width);
---

<picture class="emblem emblem--plate">
  <img
    src={image.src}
    srcset={image.srcSet.attribute}
    sizes={sizes}
    width={displayWidth}
    height={height}
    alt={siteConfig.emblemAlt}
    loading="eager"
    fetchpriority="high"
    decoding="async"
  />
</picture>

<style>
  .emblem {
    display: block;
    flex: none;
    width: 100%;
  }

  .emblem img {
    display: block;
    width: 100%;
    height: auto;
    mix-blend-mode: screen;
  }
</style>
