---
// Artwork emblem merek induk (figur klasik + jam pasir), dari aset resmi di src/assets/Logo/.
// Aturan pakai (docs/architecture.md → "Merek"): maksimal SATU kali per halaman, tidak di header,
// tidak dipotong, tidak diwarnai ulang. Latar gambar dilebur ke tema dengan blend mode:
// - tema gelap: versi gelap (latar hitam murni) + `screen` → latar hitam menjadi transparan;
// - tema terang: versi terang (latar abu-abu ±227) + `brightness(1.16)` agar latar menjadi putih,
//   lalu `multiply` → putih menjadi transparan di atas warna kertas. Garis etsa tidak berubah.
import { getImage } from 'astro:assets';
import { siteConfig } from '../config/site';
import emblemDark from '../assets/Logo/black logo.png';
import emblemLight from '../assets/Logo/logos.jpeg';

interface Props {
  /** `hero`: artwork utama beranda; `footer`: tanda kecil di footer halaman lain. */
  variant: 'hero' | 'footer';
}

const { variant } = Astro.props;

// Lebar tampil (CSS px). Versi terang hanya 433px, jadi dibatasi agar tidak diperbesar.
const displayWidth = variant === 'hero' ? 300 : 96;
const sizes = variant === 'hero' ? '(min-width: 64rem) 300px, 240px' : '96px';
const widths = (max: number) => [displayWidth, displayWidth * 2].map((w) => Math.min(w, max));

const [dark, light] = await Promise.all([
  getImage({ src: emblemDark, widths: widths(emblemDark.width), format: 'webp' }),
  getImage({ src: emblemLight, widths: widths(emblemLight.width), format: 'webp' }),
]);
const height = Math.round((displayWidth * emblemLight.height) / emblemLight.width);
---

<picture class={`emblem emblem--${variant}`}>
  <source media="(prefers-color-scheme: dark)" srcset={dark.srcSet.attribute} sizes={sizes} />
  <img
    src={light.src}
    srcset={light.srcSet.attribute}
    sizes={sizes}
    width={displayWidth}
    height={height}
    alt={variant === 'hero' ? siteConfig.emblemAlt : ''}
    loading={variant === 'hero' ? 'eager' : 'lazy'}
    decoding="async"
  />
</picture>

<style>
  .emblem {
    display: block;
    flex: none;
  }

  .emblem img {
    display: block;
    width: 100%;
    height: auto;
    /* Tema terang: latar abu-abu versi terang → putih → melebur ke kertas. */
    filter: brightness(1.16);
    mix-blend-mode: multiply;
  }

  .emblem--hero {
    width: min(300px, 70vw);
  }

  .emblem--footer {
    width: 96px;
  }

  @media (max-width: 63.99rem) {
    .emblem--hero {
      width: min(240px, 70vw);
    }
  }

  @media (prefers-color-scheme: dark) {
    .emblem img {
      /* Tema gelap: versi gelap berlatar hitam murni; `screen` membuat hitam transparan. */
      filter: none;
      mix-blend-mode: screen;
    }
  }
</style>
