---
// Artwork emblem merek induk (figur klasik + jam pasir), dari aset resmi di src/assets/Logo/.
// Aturan pakai (docs/architecture.md → "Merek"): maksimal SATU kali per halaman, tidak di header,
// tidak digambar ulang, tidak diwarnai ulang, tidak diberi efek (bevel/3D/logam). Potongan hanya potongan
// bingkai di panggung hero (jubah bawah & bahu kiri); kepala dan jam pasir selalu utuh. Latar gambar dilebur dengan blend mode:
// - `plate` (panggung hero beranda): SELALU versi gelap (1024px, satu-satunya sumber yang tajam di ukuran besar)
//   di atas pelat gelap, `screen` → latar hitam murni melebur ke warna pelat.
//   Ukuran & potongan bingkai diatur oleh wadahnya (figures/HeroStage); gambar sendiri tidak diubah.
// - `footer` (situs hanya bertema terang, lihat docs/redesign-brief.md): versi terang (latar abu-abu ±227)
//   + `brightness(1.16)` agar latar menjadi putih,
//   lalu `multiply` → putih menjadi transparan di atas warna kertas. Garis etsa tidak berubah.
import { getImage } from 'astro:assets';
import { siteConfig } from '../config/site';
import emblemDark from '../assets/Logo/black logo.png';
import emblemLight from '../assets/Logo/logos.jpeg';

interface Props {
  /** `plate`: objek di panggung hero beranda; `footer`: tanda kecil di footer halaman lain. */
  variant: 'plate' | 'footer';
}

const { variant } = Astro.props;
const isPlate = variant === 'plate';

// Lebar tampil maksimum (CSS px). Versi terang hanya 433px, jadi hanya dipakai di ukuran kecil.
// Panggung hero: emblem ±86% lebar panggung (±690px di layar 1440) atau ±117% lebar layar di ponsel.
const displayWidth = isPlate ? 1024 : 96;
const sizes = isPlate ? '(min-width: 64rem) 60vw, 117vw' : '96px';
const widths = (max: number) =>
  (isPlate ? [480, 720, 1024] : [displayWidth, displayWidth * 2]).map((w) => Math.min(w, max));

const dark = await getImage({ src: emblemDark, widths: widths(emblemDark.width), format: 'webp' });
const light = isPlate ? dark : await getImage({ src: emblemLight, widths: widths(emblemLight.width), format: 'webp' });
const source = isPlate ? emblemDark : emblemLight;
const height = Math.round((displayWidth * source.height) / source.width);
---

<picture class={`emblem emblem--${variant}`}>
  <img
    src={light.src}
    srcset={light.srcSet.attribute}
    sizes={sizes}
    width={displayWidth}
    height={height}
    alt={isPlate ? siteConfig.emblemAlt : ''}
    loading={isPlate ? 'eager' : 'lazy'}
    fetchpriority={isPlate ? 'high' : 'auto'}
    decoding="async"
  />
</picture>

<style>
  .emblem {
    display: block;
    flex: none;
  }

  .emblem img {
    display: block;
    width: 100%;
    height: auto;
    /* Versi terang: latar abu-abu → putih → melebur ke kertas. */
    filter: brightness(1.16);
    mix-blend-mode: multiply;
  }

  .emblem--plate {
    width: 100%;
  }

  /* Pelat selalu gelap: versi gelap, latar hitam melebur lewat `screen`. */
  .emblem--plate img {
    filter: none;
    mix-blend-mode: screen;
  }

  .emblem--footer {
    width: 96px;
  }
</style>
