---
// Kategori sebagai "pelat pameran": motif isometrik, nomor "01 / 05", judul, deskripsi, dan konsep di dalamnya.
// Desktop: kategori pertama (Fondasi) menjadi pelat utama di kiri, sisanya kisi 2×2 di kanan — asimetris.
// Kategori baru cukup ditambahkan di src/data/categories.ts (plus motifnya di CategoryMotif).
import { categories, categoryIndexLabel } from '../data/categories';
import { categoryHref, conceptHref, getConceptsByCategory } from '../lib/concepts';
import CategoryMotif from './figures/CategoryMotif.astro';

interface Props {
  /** Level heading judul kategori (mengikuti heading bagian di atasnya). */
  headingLevel?: 2 | 3;
}

const { headingLevel = 3 } = Astro.props;
const Heading = `h${headingLevel}` as 'h2' | 'h3';
const grouped = await getConceptsByCategory();
---

<ol class="category-grid">
  {
    categories.map((category, i) => {
      const concepts = grouped.get(category.id) ?? [];
      return (
        <li class:list={['plate', { 'plate--lead': i === 0 }]} data-category={category.id}>
          <div class="plate__figure">
            <CategoryMotif motif={category.motif} />
          </div>
          <div class="plate__body">
            <p class="label">
              <span class="label__index">{categoryIndexLabel(category.id)}</span>
              <span class="label__sep" aria-hidden="true">·</span>{concepts.length > 0 ? `${concepts.length} konsep` : 'Segera hadir'}
            </p>
            <Heading class="plate__title">
              <a href={categoryHref(category.id)}>{category.title}</a>
            </Heading>
            <p class="plate__desc">{category.description}</p>
            {concepts.length > 0 && (
              <ul class="plate__concepts" aria-label={`Konsep dalam ${category.title}`}>
                {concepts.map((concept) => (
                  <li>
                    <a href={conceptHref(concept.id)}>{concept.data.title}</a>
                  </li>
                ))}
              </ul>
            )}
          </div>
        </li>
      );
    })
  }
</ol>

<style>
  .category-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-6) var(--grid-gap);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Pelat pameran: bingkai hairline di atas bidang --surface; seluruh pelat bisa diklik lewat tautan judul. */
  .plate {
    position: relative;
    display: grid;
    grid-template-columns: 7.5rem minmax(0, 1fr);
    align-content: start;
    gap: var(--space-4) var(--space-6);
    padding: var(--space-6);
    background: var(--surface);
    border: var(--border-hair) solid var(--rule-strong);
    transition: border-color var(--motion-base) var(--ease);
  }

  /* Sorotan pilihan: bingkai jadi kuningan + garis kuningan tipis di tepi atas (bukan pendaran). */
  .plate::before {
    content: '';
    position: absolute;
    inset: calc(-1 * var(--border-hair)) calc(-1 * var(--border-hair)) auto;
    height: var(--border-mark);
    background: var(--mark);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--motion-base) var(--ease);
  }

  .plate:hover,
  .plate:focus-within {
    border-color: var(--mark);
  }

  .plate:hover::before,
  .plate:focus-within::before {
    transform: scaleX(1);
  }

  /* Tautan judul direntangkan menutupi pelat; tautan konsep berada di atasnya. */
  .plate__title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .plate__concepts a {
    position: relative;
    z-index: 1;
  }

  .plate__figure {
    padding-top: var(--space-1);
  }

  .plate__body {
    min-width: 0;
  }

  .plate__title {
    margin: var(--space-2) 0 var(--space-2);
    font-size: var(--text-lg);
  }

  .plate__title a {
    color: var(--ink);
    text-decoration: none;
  }

  .plate:hover .plate__title a {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-decoration-color: var(--mark);
    text-underline-offset: 0.25em;
  }

  .plate__desc {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--ink-2);
  }

  .plate__concepts {
    display: flex;
    flex-wrap: wrap;
    margin: var(--space-4) 0 0;
    padding: 0;
    list-style: none;
    font-size: var(--text-sm);
  }

  /* Pemisah di AKHIR item agar tidak jatuh di awal baris saat membungkus. */
  .plate__concepts li:not(:last-child)::after {
    content: '·';
    margin-inline: var(--space-2);
    color: var(--ink-3);
  }

  .plate__concepts a {
    color: var(--ink-2);
  }

  .plate__concepts a:hover {
    color: var(--ink);
  }

  /* Pelat utama: motif lebih besar di atas teks. */
  .plate--lead {
    grid-template-columns: minmax(0, 1fr);
  }

  .plate--lead .plate__figure {
    max-width: 24rem;
  }

  .plate--lead .plate__title {
    font-size: var(--text-2xl);
  }

  .plate--lead .plate__desc {
    max-width: var(--measure-narrow);
    font-size: var(--text-base);
  }

  @media (min-width: 48rem) {
    .category-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .plate {
      grid-template-columns: minmax(0, 1fr);
    }

    .plate__figure {
      max-width: 11rem;
    }

    .plate--lead {
      grid-column: 1 / -1;
    }
  }

  /* Desktop: 12 kolom — pelat utama 6 kolom × 2 baris di kiri, empat pelat 3 kolom di kanan. */
  @media (min-width: 64rem) {
    .category-grid {
      grid-template-columns: repeat(var(--grid-columns), minmax(0, 1fr));
    }

    .plate {
      grid-column: span 3;
    }

    .plate--lead {
      grid-column: 1 / span 6;
      grid-row: span 2;
      padding: var(--space-8);
    }
  }
</style>
