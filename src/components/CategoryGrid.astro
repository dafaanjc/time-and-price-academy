---
import { categories } from '../data/categories';
import { categoryHref, getConceptsByCategory } from '../lib/concepts';

const grouped = await getConceptsByCategory();
const countLabel = (n: number) => (n > 0 ? `${n} konsep` : 'Segera hadir');
---

<ul class="category-grid">
  {
    categories.map((category) => (
      <li class="category-grid__item">
        <a class="category-grid__link" href={categoryHref(category.id)}>
          <span class="category-grid__title">{category.title}</span>
          <span class="category-grid__desc">{category.description}</span>
          <span class="category-grid__count">{countLabel(grouped.get(category.id)?.length ?? 0)}</span>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .category-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 15rem), 1fr));
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .category-grid__link {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    height: 100%;
    padding: 1.125rem 1.25rem;
    color: inherit;
    text-decoration: none;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }

  .category-grid__link:hover {
    border-color: var(--accent);
  }

  .category-grid__title {
    font-family: var(--font-serif);
    font-size: 1.125rem;
    font-weight: 600;
  }

  .category-grid__desc {
    font-size: 0.9375rem;
    color: var(--ink-soft);
  }

  .category-grid__count {
    margin-top: auto;
    padding-top: 0.375rem;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--accent);
  }
</style>
