---
// Masalah trader di beranda (Tahap 4 redesign): kartu indeks arsip. Pengantar di atas (pernyataan + lead), lalu
// satu kartu per masalah — kepala kartu bernomor dengan garis ganda kuningan, kutipan trader dalam Newsreader
// italic besar, ringkasan, baris bergaris "Keputusan" dan "Konsep", lubang kartu katalog di bawah.
// Mobile: satu kolom; ≥ 48rem: dua kolom. Data dari koleksi `problems`; halaman /masalah/ tetap memakai ProblemList.
import { conceptHref, getConcepts } from '../lib/concepts';
import { problemHref, type Problem } from '../lib/problems';
import { routes, withBase } from '../lib/url';
import SectionHeading from './SectionHeading.astro';

interface Props {
  problems: Problem[];
  number: string;
}

const { problems, number } = Astro.props;
const titles = new Map((await getConcepts()).map((c) => [c.id, c.data.title]));
const pad = (n: number) => String(n).padStart(2, '0');
---

<section class="problems" id="masalah" aria-labelledby="masalah-title" data-reveal>
  <SectionHeading
    id="masalah-title"
    number={number}
    title="Masalah Trader"
    more={{ href: withBase(routes.problems), label: 'Semua masalah' }}
  />

  <div class="problems__intro">
    <p class="problems__statement">Mulai dari yang terasa, bukan dari teori.</p>
    <p class="problems__lead">
      Setiap masalah di bawah adalah keputusan yang sedang dipertaruhkan. Kami menunjukkan konsep mana yang
      menjelaskannya dan cara menghitungnya.
    </p>
  </div>

  <ol class="problems__cards">
    {
      problems.map((problem, i) => (
        <li class="card">
          <p class="card__head label" aria-hidden="true">
            <span class="label__index">No. {pad(i + 1)}</span>
          </p>
          <h3 class="card__quote">
            <a href={problemHref(problem.id)}>“{problem.data.title}”</a>
          </h3>
          <p class="card__desc">{problem.data.description}</p>
          <dl class="card__meta">
            <div>
              <dt class="label">Keputusan</dt>
              <dd>{problem.data.decision}</dd>
            </div>
            <div>
              <dt class="label">Konsep</dt>
              <dd>
                {problem.data.concepts.map((id, j) => (
                  <>
                    {j > 0 && <span aria-hidden="true"> · </span>}
                    <a href={conceptHref(id)}>{titles.get(id) ?? id}</a>
                  </>
                ))}
              </dd>
            </div>
          </dl>
          <span class="card__hole" aria-hidden="true"></span>
        </li>
      ))
    }
  </ol>
</section>

<style>
  .problems {
    padding-top: var(--space-16);
  }

  .problems__statement {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: var(--weight-display);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-display);
    text-wrap: balance;
  }

  .problems__lead {
    max-width: var(--measure-narrow);
    margin: var(--space-4) 0 0;
    color: var(--ink-2);
  }

  .problems__cards {
    display: grid;
    gap: var(--space-6) var(--grid-gap);
    margin: var(--space-12) 0 0;
    padding: 0;
    list-style: none;
  }

  /* Kartu indeks: kertas terang, garis rambut, sudut tegas. Tanpa bayangan; sorotan = garis bingkai menebal. */
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: var(--space-4) var(--space-6) var(--space-8);
    background: var(--surface);
    border: var(--border-hair) solid var(--rule);
    transition: border-color var(--motion-fast) var(--ease);
  }

  .card:hover,
  .card:focus-within {
    border-color: var(--rule-strong);
  }

  /* Kepala kartu: nomor arsip di atas garis ganda kuningan. */
  .card__head {
    position: relative;
    margin: 0 0 var(--space-6);
    padding-bottom: var(--space-2);
    border-bottom: var(--border-hair) solid var(--brass);
  }

  .card__head::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    bottom: calc(-1 * var(--frame-gap) - var(--border-hair));
    border-bottom: var(--border-hair) solid var(--brass);
  }

  /* Kutipan dalam suara trader: Newsreader italic besar. */
  .card__quote {
    margin: 0;
    font-family: var(--font-text);
    font-size: var(--text-xl);
    font-style: italic;
    font-weight: 400;
    line-height: 1.25;
    letter-spacing: 0;
  }

  .card__quote a {
    color: var(--ink);
    text-decoration-color: transparent;
  }

  .card__quote a:hover,
  .card__quote a:focus-visible {
    text-decoration-color: var(--link-line-hover);
  }

  .card__desc {
    margin: var(--space-3) 0 0;
    font-size: var(--text-sm);
    color: var(--ink-2);
  }

  /* Baris bergaris seperti kartu katalog. */
  .card__meta {
    margin: var(--space-6) 0 0;
    font-size: var(--text-sm);
  }

  .card__meta div {
    display: grid;
    grid-template-columns: 6.5rem minmax(0, 1fr);
    column-gap: var(--space-3);
    padding-block: var(--space-2);
    border-top: var(--border-hair) solid var(--rule);
  }

  .card__meta div:last-child {
    border-bottom: var(--border-hair) solid var(--rule);
  }

  .card__meta dd {
    margin: 0;
    color: var(--ink-2);
  }

  .card__meta a {
    color: var(--ink-2);
  }

  .card__meta a:hover {
    color: var(--ink);
  }

  /* Lubang batang kartu katalog (satu ornamen per kartu). */
  .card__hole {
    position: absolute;
    left: 50%;
    bottom: var(--space-3);
    width: 0.75rem;
    height: 0.75rem;
    margin-left: -0.375rem;
    background: var(--paper);
    border: var(--border-hair) solid var(--rule-strong);
    border-radius: 50%;
  }

  @media (max-width: 30rem) {
    .card__meta div {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (min-width: 48rem) {
    .problems__cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 64rem) {
    .problems {
      padding-top: var(--space-24);
    }

    .problems__intro {
      display: grid;
      grid-template-columns: repeat(var(--grid-columns), minmax(0, 1fr));
      gap: var(--grid-gap);
      align-items: end;
    }

    .problems__statement {
      grid-column: 1 / span 5;
      font-size: var(--text-3xl);
    }

    .problems__lead {
      grid-column: 7 / -1;
      margin: 0;
    }

    .card {
      padding: var(--space-6) var(--space-8) var(--space-12);
    }
  }
</style>
