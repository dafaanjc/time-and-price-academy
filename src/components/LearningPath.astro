---
// Jalur belajar sebagai rute (R10; Tahap 5: nomor jilid Bodoni seperti katalog): rel ukur vertikal dengan tick per langkah; setiap langkah adalah baris
// editorial (nomor mono besar, judul serif, meta, ringkasan), bukan kartu. Tick kuningan saat ditunjuk.
// Terminal MULAI/SELESAI tetap sebagai label ujung rel.
import HourglassGlyph from './figures/HourglassGlyph.astro';
import { conceptHref, difficultyLabels, type ResolvedPath } from '../lib/concepts';
import { readingMinutes } from '../lib/reading-time';

interface Props {
  path: ResolvedPath;
}

const { path } = Astro.props;
const pad = (n: number) => String(n).padStart(2, '0');
---

<div class="route">
  <p class="label route__terminal" aria-hidden="true">Mulai</p>
  <ol class="route__steps" aria-label={`Jalur belajar: ${path.title}`}>
    {
      path.steps.map((concept, i) => (
        <li class="route__step row-link">
          <span class="route__number" aria-hidden="true">{pad(i + 1)}</span>
          <div class="route__body">
            <a class="route__title" href={conceptHref(concept.id)}>{concept.data.title}</a>
            <p class="label route__meta">
              <span class="label__index">Langkah {pad(i + 1)} / {pad(path.steps.length)}</span>
              <span class="label__sep" aria-hidden="true">·</span><span>{difficultyLabels[concept.data.difficulty]}</span>
              <span class="label__sep" aria-hidden="true">·</span><span class="route__time"><HourglassGlyph fill={(i + 1) / path.steps.length} />{readingMinutes(concept.body)} mnt baca</span>
            </p>
            <p class="route__desc">{concept.data.description}</p>
          </div>
        </li>
      ))
    }
  </ol>
  <p class="label route__terminal route__terminal--end" aria-hidden="true">Selesai</p>
</div>

<style>
  .route {
    --rail-x: 1.75rem;
    position: relative;
  }

  /* Rel ukur: garis vertikal dengan tick tiap sel kisi, dari MULAI sampai SELESAI. */
  .route::before {
    content: "";
    position: absolute;
    top: 0.75rem;
    bottom: 0.75rem;
    left: var(--rail-x);
    width: var(--tick-minor);
    background:
      linear-gradient(var(--rule-strong), var(--rule-strong)) left / var(--stroke-hair) 100% no-repeat,
      repeating-linear-gradient(to bottom, var(--rule-strong) 0 var(--stroke-hair), transparent var(--stroke-hair) var(--grid-cell));
  }

  .route__terminal {
    position: relative;
    margin: 0;
    padding-left: calc(var(--rail-x) + var(--space-6));
  }

  .route__steps {
    margin: var(--space-4) 0;
    padding: 0;
    list-style: none;
  }

  .route__step {
    display: grid;
    grid-template-columns: calc(var(--rail-x) * 2) minmax(0, 1fr);
    column-gap: var(--space-4);
    padding-block: var(--space-4);
    border-bottom: var(--border-hair) solid var(--rule);
  }

  .route__step:first-child {
    border-top: var(--border-hair) solid var(--rule);
  }

  /* Nomor langkah di atas rel: angka mono di bidang kertas, memotong garis rel. */
  .route__number {
    position: relative;
    justify-self: center;
    align-self: start;
    padding: var(--space-1) 0;
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    line-height: 1;
    letter-spacing: var(--tracking-display);
    color: var(--mark);
    background: var(--paper);
  }

  .route__title {
    font-family: var(--font-serif);
    font-size: var(--text-xl);
    font-weight: 600;
    line-height: var(--leading-tight);
    color: var(--ink);
  }

  .route__meta {
    margin: var(--space-2) 0 0;
  }

  .route__time {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
  }

  .route__desc {
    max-width: var(--measure-narrow);
    margin: var(--space-2) 0 0;
    font-size: var(--text-sm);
    color: var(--ink-2);
  }
</style>
