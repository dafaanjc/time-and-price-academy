---
// Jalur belajar sebagai diagram alur teknis (blueprint): terminal MULAI → langkah bernomor tegas
// (kotak hairline, nomor mono besar, rel penghubung berpanah) → terminal SELESAI.
import { conceptHref, difficultyLabels, type ResolvedPath } from '../lib/concepts';
import { readingMinutes } from '../lib/reading-time';

interface Props {
  path: ResolvedPath;
}

const { path } = Astro.props;
const pad = (n: number) => String(n).padStart(2, '0');
---

<div class="flow">
  <p class="label flow__terminal" aria-hidden="true">Mulai</p>
  <ol class="flow__steps" aria-label={`Jalur belajar: ${path.title}`}>
    {
      path.steps.map((concept, i) => (
        <li class="step">
          <div class="step__rail" aria-hidden="true">
            <span class="step__number">{pad(i + 1)}</span>
            <span class="step__line"></span>
          </div>
          <a class="step__card" href={conceptHref(concept.id)}>
            <span class="label">
              <span class="label__index">Langkah {pad(i + 1)} / {pad(path.steps.length)}</span>
              <span class="label__sep" aria-hidden="true">·</span>{difficultyLabels[concept.data.difficulty]}<span class="label__sep" aria-hidden="true">·</span>{readingMinutes(concept.body)} mnt baca
            </span>
            <span class="step__title">{concept.data.title}</span>
            <span class="step__desc">{concept.data.description}</span>
          </a>
        </li>
      ))
    }
  </ol>
  <p class="label flow__terminal flow__terminal--end" aria-hidden="true">Selesai</p>
</div>

<style>
  .flow {
    max-width: var(--measure);
  }

  .flow__terminal {
    display: inline-block;
    padding: var(--space-1) var(--space-3);
    border: var(--border-hair) solid var(--rule-strong);
    border-radius: var(--space-4);
    background: var(--surface);
  }

  .flow__steps {
    padding: 0;
    list-style: none;
  }

  .step {
    display: grid;
    grid-template-columns: 3.5rem minmax(0, 1fr);
    gap: var(--space-4);
  }

  /* Rel: kotak nomor, lalu garis turun yang berakhir di ujung panah menuju langkah berikutnya. */
  .step__rail {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .step__number {
    display: grid;
    place-items: center;
    width: 3.5rem;
    height: 3.5rem;
    font-family: var(--font-label);
    font-size: var(--text-lg);
    letter-spacing: var(--tracking-mono);
    color: var(--mark);
    background: var(--surface);
    border: var(--border-hair) solid var(--rule-strong);
    transition:
      background-color var(--motion-base) var(--ease),
      border-color var(--motion-base) var(--ease);
  }

  .step__line {
    position: relative;
    flex: 1;
    width: var(--border-hair);
    min-height: var(--space-6);
    background: var(--rule-strong);
  }

  /* Ujung panah menunjuk ke bawah, ke kotak nomor berikutnya. */
  .step__line::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 50%;
    width: var(--space-2);
    height: var(--space-2);
    background: var(--rule-strong);
    transform: translateX(-50%);
    clip-path: polygon(0 0, 100% 0, 50% 100%);
  }

  /* Langkah terakhir: rel tetap turun sedikit ke terminal SELESAI. */
  .step:last-child .step__line {
    min-height: var(--space-6);
  }

  .step__card {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin-bottom: var(--space-6);
    padding: var(--space-4) var(--space-6);
    color: inherit;
    text-decoration: none;
    background: var(--surface);
    border: var(--border-hair) solid var(--rule-strong);
    transition: border-color var(--motion-base) var(--ease);
  }

  .step:last-child .step__card {
    margin-bottom: var(--space-4);
  }

  .step__title {
    font-family: var(--font-serif);
    font-size: var(--text-lg);
    font-weight: 600;
    line-height: var(--leading-tight);
    color: var(--ink);
  }

  .step__desc {
    font-size: var(--text-sm);
    color: var(--ink-2);
  }

  .step:hover .step__card,
  .step__card:focus-visible {
    border-color: var(--mark);
  }

  .step:hover .step__number {
    border-color: var(--mark);
    background: var(--mark-soft);
  }

  .step__card:hover .step__title {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-decoration-color: var(--mark);
    text-underline-offset: 0.2em;
  }

  .flow__steps {
    margin-block: var(--space-4);
  }

  @media (max-width: 30rem) {
    .step {
      grid-template-columns: 2.5rem minmax(0, 1fr);
      gap: var(--space-3);
    }

    .step__number {
      width: 2.5rem;
      height: 2.5rem;
      font-size: var(--text-base);
    }

    .step__card {
      padding: var(--space-3) var(--space-4);
    }
  }
</style>
