---
import { conceptHref, type ResolvedPath } from '../lib/concepts';

interface Props {
  path: ResolvedPath;
}

const { path } = Astro.props;
const stepNumber = (i: number) => String(i + 1).padStart(2, '0');
---

<ol class="learning-path" aria-label={`Jalur belajar: ${path.title}`}>
  {
    path.steps.map((concept, i) => (
      <li class="learning-path__step">
        <span class="learning-path__number" aria-hidden="true">
          {stepNumber(i)}
        </span>
        <a class="learning-path__link" href={conceptHref(concept.id)}>
          <span class="learning-path__title">{concept.data.title}</span>
          <span class="learning-path__desc">{concept.data.description}</span>
        </a>
      </li>
    ))
  }
</ol>

<style>
  .learning-path {
    margin: 0;
    padding: 0;
    list-style: none;
    max-width: var(--measure);
  }

  .learning-path__step {
    position: relative;
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr);
    gap: 0.75rem;
    padding-bottom: 1rem;
  }

  /* Garis penghubung antar langkah. */
  .learning-path__step:not(:last-child)::before {
    content: '';
    position: absolute;
    left: 1.25rem;
    top: 2.5rem;
    bottom: 0;
    width: 1px;
    background: var(--line);
  }

  .learning-path__number {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--accent);
    background: var(--accent-soft);
    border-radius: 50%;
  }

  .learning-path__link {
    display: flex;
    flex-direction: column;
    padding-top: 0.375rem;
    color: inherit;
    text-decoration: none;
  }

  .learning-path__title {
    font-weight: 600;
    color: var(--accent);
  }

  .learning-path__link:hover .learning-path__title {
    text-decoration: underline;
  }

  .learning-path__desc {
    font-size: 0.9375rem;
    color: var(--ink-soft);
  }
</style>
