---
// Transisi dari merek induk ke produk: emblem sebagai objek pameran (satu-satunya emblem di beranda),
// lalu rantai konsep inti di atas sumbu waktu yang bertick. Penanda kuningan di langkah terakhir
// (nilai harapan) sama dengan penanda E[P] di figur hero.
import { siteConfig } from '../config/site';
import { conceptChain } from '../data/concept-chain';
import { conceptHref, getConceptsByIds } from '../lib/concepts';
import BrandEmblem from './BrandEmblem.astro';

const concepts = await getConceptsByIds(conceptChain.map((s) => s.id));
if (concepts.length !== conceptChain.length) {
  const found = new Set(concepts.map((c) => c.id));
  const missing = conceptChain.filter((s) => !found.has(s.id)).map((s) => s.id);
  throw new Error(`concept-chain.ts: konsep tidak ditemukan: ${missing.join(', ')}`);
}
const pad = (n: number) => String(n).padStart(2, '0');
---

<section class="lab" aria-labelledby="lab-title" data-reveal>
  <div class="lab__object">
    <BrandEmblem variant="exhibit" />
    <p class="lab__object-caption label">
      <span class="label__index">Objek 00</span><span class="label__sep" aria-hidden="true">·</span>{`Emblem ${siteConfig.masterBrand}`}
    </p>
  </div>

  <div class="lab__text">
    <p class="label">Dari akademi ke laboratorium</p>
    <h2 id="lab-title" class="lab__title">{siteConfig.product}</h2>
    <p class="lab__lead">
      {siteConfig.masterBrand} membaca pasar lewat dua sumbu: waktu dan harga. {siteConfig.product} adalah
      ruangnya untuk risiko, tempat ketidakpastian diukur lebih dulu sebelum keputusan diambil.
    </p>
  </div>

  <ol class="chain" aria-label="Rantai konsep inti">
    {
      conceptChain.map((step, i) => (
        <li class:list={['chain__step', { 'chain__step--last': i === conceptChain.length - 1 }]}>
          <a href={conceptHref(step.id)}>
            <span class="chain__index label" aria-hidden="true">
              {pad(i + 1)}
            </span>
            <span class="chain__label">{step.label}</span>
          </a>
        </li>
      ))
    }
  </ol>
</section>

<style>
  .lab {
    display: grid;
    gap: var(--space-8);
    align-items: center;
    padding-block: var(--space-12) 0;
  }

  .lab__object {
    justify-self: center;
    display: grid;
    justify-items: center;
    gap: var(--space-3);
  }

  .lab__object-caption {
    text-align: center;
  }

  .lab__title {
    margin: var(--space-2) 0 var(--space-4);
    font-size: clamp(var(--text-2xl), 5vw, var(--text-4xl));
    letter-spacing: var(--tracking-display);
  }

  .lab__lead {
    max-width: var(--measure-narrow);
    margin: 0;
    font-size: var(--text-lg);
    color: var(--ink-2);
  }

  /* Rantai = sumbu bertick. Mobile: sumbu tegak di kiri; desktop: sumbu mendatar di atas. */
  .chain {
    position: relative;
    display: grid;
    gap: var(--space-4);
    margin: var(--space-8) 0 0;
    padding: 0 0 0 var(--space-6);
    list-style: none;
    border-left: var(--stroke-axis) solid var(--axis);
  }

  .chain__step {
    position: relative;
  }

  /* Tick di sumbu untuk tiap langkah. */
  .chain__step::before {
    content: '';
    position: absolute;
    top: 0.7em;
    left: calc(-1 * var(--space-6));
    width: var(--tick-major);
    height: var(--stroke-hair);
    background: var(--axis);
  }

  .chain__step--last::before {
    top: calc(0.7em - 3px);
    left: calc(-1 * var(--space-6) - 4px);
    width: 7px;
    height: 7px;
    background: var(--mark);
  }

  .chain a {
    display: inline-flex;
    align-items: baseline;
    gap: var(--space-3);
    color: var(--ink);
    text-decoration: none;
  }

  .chain a:hover .chain__label {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
  }

  .chain__step--last .chain__index {
    color: var(--mark);
  }

  .chain__label {
    font-family: var(--font-serif);
    font-size: var(--text-lg);
    font-weight: 600;
  }

  @media (min-width: 64rem) {
    .lab {
      grid-template-columns: repeat(var(--grid-columns), minmax(0, 1fr));
      gap: var(--grid-gap);
      padding-block-start: var(--space-16);
    }

    .lab__object {
      grid-column: 1 / span 4;
    }

    .lab__text {
      grid-column: 6 / -1;
    }

    /* Rantai membentang seluruh lebar: sumbu waktu mendatar di bawah objek dan teks. */
    .chain {
      position: relative;
      grid-column: 1 / -1;
      margin-top: var(--space-12);
    }

    /* Mata panah di ujung kanan sumbu. */
    .chain::after {
      content: '';
      position: absolute;
      top: -4px;
      right: 0;
      width: 7px;
      height: 7px;
      border-top: var(--stroke-axis) solid var(--axis);
      border-right: var(--stroke-axis) solid var(--axis);
      transform: rotate(45deg);
    }

    .chain {
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: var(--space-4);
      padding: var(--space-6) 0 0;
      border-left: 0;
      border-top: var(--stroke-axis) solid var(--axis);
    }

    .chain__step::before {
      top: calc(-1 * var(--space-6));
      left: 0;
      width: var(--stroke-hair);
      height: var(--tick-major);
    }

    .chain__step--last::before {
      top: calc(-1 * var(--space-6) - 4px);
      left: -3px;
      width: 7px;
      height: 7px;
    }

    .chain a {
      flex-direction: column;
      gap: var(--space-1);
    }
  }
</style>
