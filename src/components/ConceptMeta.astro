---
import { getCategory } from '../data/categories';
import { categoryHref, difficultyLabels, statusLabels, type Concept } from '../lib/concepts';
import { readingMinutes } from '../lib/reading-time';

interface Props {
  concept: Concept;
}

const { concept } = Astro.props;
const { category, difficulty, status } = concept.data;
const statusClass = status === 'draft' ? 'badge badge--draft' : 'badge';
---

<dl class="concept-meta">
  <div>
    <dt>Kategori</dt>
    <dd><a href={categoryHref(category)}>{getCategory(category).title}</a></dd>
  </div>
  <div>
    <dt>Tingkat</dt>
    <dd>{difficultyLabels[difficulty]}</dd>
  </div>
  <div>
    <dt>Waktu baca</dt>
    <dd>{readingMinutes(concept.body)} menit</dd>
  </div>
  <div>
    <dt>Status</dt>
    <dd><span class={statusClass}>{statusLabels[status]}</span></dd>
  </div>
</dl>

<style>
  .concept-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.75rem;
    margin: 0;
  }

  dt {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  dd {
    margin: 0.125rem 0 0;
    font-size: 0.9375rem;
  }
</style>
