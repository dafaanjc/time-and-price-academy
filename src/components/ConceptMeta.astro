---
// Meta konsep dalam satu baris: "Fondasi · Dasar · 3 menit baca · Draf".
import { getCategory } from '../data/categories';
import { categoryHref, difficultyLabels, statusLabels, type Concept } from '../lib/concepts';
import { readingMinutes } from '../lib/reading-time';

interface Props {
  concept: Concept;
}

const { concept } = Astro.props;
const { category, difficulty, status } = concept.data;
const isDraft = status === 'draft';
---

<p class="concept-meta">
  <a href={categoryHref(category)}>{getCategory(category).title}</a>{' '}
  <span class="concept-meta__sep" aria-hidden="true">·</span>{' '}
  <span>Tingkat {difficultyLabels[difficulty].toLowerCase()}</span>{' '}
  <span class="concept-meta__sep" aria-hidden="true">·</span>{' '}
  <span>{readingMinutes(concept.body)} menit baca</span>{' '}
  {isDraft && <span class="badge badge--draft">{statusLabels[status]}</span>}
</p>

<style>
  .concept-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-1) var(--space-2);
    margin: 0;
    font-size: var(--text-sm);
    color: var(--ink-2);
  }

  .concept-meta a {
    color: var(--ink);
    font-weight: 600;
  }

  .concept-meta__sep {
    color: var(--ink-3);
  }

</style>
