---
// Wordmark tipografis "MEREK INDUK │ Produk" dari siteConfig. Ini penulisan nama, bukan logo:
// artwork emblem terlalu detail untuk ukuran header dan hanya tampil di hero/footer.
// Desktop: wordmark · navigasi utama · cari. Mobile: wordmark · cari · menu.
import { siteConfig } from '../config/site';
import MobileNav from './MobileNav.astro';
import PrimaryNav from './PrimaryNav.astro';
import { routes, withBase } from '../lib/url';

const searchHref = withBase(routes.search);
const onSearch = Astro.url.pathname === searchHref;
---

<header class="site-header">
  <a class="wordmark" href={withBase(routes.home)} aria-label={`${siteConfig.name} — Beranda`}>
    <span class="wordmark__master">{siteConfig.masterBrand}</span>
    <span class="wordmark__divider" aria-hidden="true"></span>
    <span class="wordmark__product">{siteConfig.product}</span>
  </a>

  <nav class="site-header__nav" aria-label="Navigasi utama">
    <PrimaryNav layout="row" />
  </nav>

  <div class="site-header__actions">
    <a class="site-header__search" href={searchHref} aria-label="Cari konsep" aria-current={onSearch ? 'page' : undefined}>
      <svg aria-hidden="true" width="20" height="20" viewBox="0 0 20 20">
        <circle cx="8.5" cy="8.5" r="5.25" fill="none" stroke="currentColor" stroke-width="1.75"></circle>
        <path d="M12.5 12.5L17 17" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"></path>
      </svg>
      <span class="site-header__search-label">Cari</span>
    </a>
    <MobileNav />
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    display: flex;
    align-items: center;
    gap: var(--space-6);
    height: var(--header-height);
    padding-inline: var(--gutter);
    background-color: var(--paper);
    background-image: var(--paper-grain);
    border-bottom: var(--border-hair) solid var(--rule);
  }

  .wordmark {
    display: flex;
    align-items: center;
    min-height: 2.75rem;
    gap: var(--space-3);
    min-width: 0;
    margin-right: auto;
    color: var(--ink);
    text-decoration: none;
  }

  /* Merek induk: italic small caps ala katalog; produk: Bodoni Moda. */
  .wordmark__master {
    font-size: var(--text-sm);
    font-style: italic;
    font-variant-caps: small-caps;
    letter-spacing: 0.03em;
    color: var(--ink-2);
    white-space: nowrap;
  }

  .wordmark__divider {
    width: var(--border-hair);
    height: 1.25rem;
    background: var(--rule-strong);
  }

  .wordmark__product {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: var(--weight-display);
    letter-spacing: var(--tracking-display);
    line-height: 1;
    white-space: nowrap;
  }

  /* Navigasi utama hanya di desktop; di mobile ada di menu. */
  .site-header__nav {
    display: none;
  }

  .site-header__actions {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .site-header__search {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 2.75rem;
    padding: 0 var(--space-2);
    color: var(--ink-2);
    text-decoration: none;
    transition: color var(--motion-fast) var(--ease);
  }

  .site-header__search:hover,
  .site-header__search[aria-current] {
    color: var(--ink);
  }

  .site-header__search-label {
    display: none;
  }

  @media (min-width: 64rem) {
    .site-header__nav {
      display: block;
    }

    .site-header__search-label {
      display: inline;
    }
  }

  /* Layar sempit: dua baris (induk di atas, produk di bawah) agar tetap utuh tanpa dipotong. */
  @media (max-width: 29.99rem) {
    .site-header {
      gap: var(--space-3);
    }

    .wordmark {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-1);
    }

    .wordmark__master {
      font-size: var(--text-xs);
      line-height: 1;
    }

    .wordmark__divider {
      display: none;
    }

    .wordmark__product {
      font-size: var(--text-base);
    }
  }
</style>
