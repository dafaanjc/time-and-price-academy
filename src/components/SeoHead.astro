---
import { siteConfig } from '../config/site';
import { OG_HEIGHT, OG_WIDTH } from '../lib/og-image';
import { absoluteUrl, routes, withBase } from '../lib/url';
// Dua font yang terlihat di layar pertama di-preload; sisanya dimuat lewat @font-face di global.css.
import textRegular from '@fontsource/newsreader/files/newsreader-latin-400-normal.woff2?url';
import displayMedium from '@fontsource/bodoni-moda/files/bodoni-moda-latin-500-normal.woff2?url';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  /** Nama kategori untuk article:section. */
  section?: string;
  /** Path gambar OG yang sudah memakai base. Default: gambar pratinjau umum. */
  image?: string;
  /** Halaman yang tidak untuk diindeks/dibagikan (mis. 404): tanpa canonical dan og:url. */
  noindex?: boolean;
}

const {
  title,
  description = siteConfig.description,
  type = 'website',
  section,
  image = withBase(routes.ogDefault),
  noindex = false,
} = Astro.props;
const fullTitle = title ? `${title} · ${siteConfig.name}` : `${siteConfig.name} · ${siteConfig.tagline}`;
const canonical = noindex ? undefined : absoluteUrl(Astro.url.pathname, Astro.site);
const imageUrl = absoluteUrl(image, Astro.site);
const imageAlt = `${title ?? siteConfig.tagline} — ${siteConfig.name}`;
const isArticle = type === 'article';
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{fullTitle}</title>
<meta name="description" content={description} />
<meta name="author" content={siteConfig.author} />
<link rel="icon" type="image/svg+xml" href={withBase(routes.faviconSvg)} />
<link rel="icon" type="image/png" sizes="32x32" href={withBase(routes.favicon)} />
<link rel="apple-touch-icon" sizes="180x180" href={withBase(routes.appleTouchIcon)} />
<link rel="preload" href={textRegular} as="font" type="font/woff2" crossorigin />
<link rel="preload" href={displayMedium} as="font" type="font/woff2" crossorigin />
{noindex && <meta name="robots" content="noindex" />}
{canonical && <link rel="canonical" href={canonical} />}

<meta property="og:type" content={type} />
<meta property="og:site_name" content={siteConfig.name} />
<meta property="og:locale" content={siteConfig.locale} />
<meta property="og:title" content={title ?? siteConfig.name} />
<meta property="og:description" content={description} />
{canonical && <meta property="og:url" content={canonical} />}
{imageUrl && <meta property="og:image" content={imageUrl} />}
{imageUrl && <meta property="og:image:type" content="image/png" />}
{imageUrl && <meta property="og:image:width" content={String(OG_WIDTH)} />}
{imageUrl && <meta property="og:image:height" content={String(OG_HEIGHT)} />}
{imageUrl && <meta property="og:image:alt" content={imageAlt} />}
{isArticle && <meta property="article:author" content={siteConfig.author} />}
{isArticle && section && <meta property="article:section" content={section} />}

<meta name="twitter:card" content={imageUrl ? 'summary_large_image' : 'summary'} />
<meta name="twitter:title" content={title ?? siteConfig.name} />
<meta name="twitter:description" content={description} />
{imageUrl && <meta name="twitter:image" content={imageUrl} />}
{imageUrl && <meta name="twitter:image:alt" content={imageAlt} />}
