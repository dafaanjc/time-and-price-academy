---
// Navigasi mobile memakai <dialog> native: fokus terkunci, Esc menutup.
import ConceptNav from './ConceptNav.astro';
import PrimaryNav from './PrimaryNav.astro';
---

<button class="mobile-nav__open" type="button" aria-haspopup="dialog" aria-controls="mobile-nav">
  <svg aria-hidden="true" width="20" height="20" viewBox="0 0 20 20">
    <path d="M3 5h14M3 10h14M3 15h14" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"></path>
  </svg>
  <span>Menu</span>
</button>

<dialog id="mobile-nav" class="mobile-nav" aria-label="Menu navigasi">
  <div class="mobile-nav__bar">
    <span class="mobile-nav__title">Menu</span>
    <button class="mobile-nav__close" type="button" aria-label="Tutup menu">
      <svg aria-hidden="true" width="20" height="20" viewBox="0 0 20 20">
        <path d="M5 5l10 10M15 5L5 15" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"></path>
      </svg>
    </button>
  </div>
  <nav class="mobile-nav__primary" aria-label="Navigasi utama">
    <PrimaryNav layout="column" />
  </nav>
  <ConceptNav />
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('#mobile-nav');
  const openButton = document.querySelector<HTMLButtonElement>('.mobile-nav__open');
  const closeButton = dialog?.querySelector<HTMLButtonElement>('.mobile-nav__close');

  openButton?.addEventListener('click', () => dialog?.showModal());
  closeButton?.addEventListener('click', () => dialog?.close());
  // Klik di luar panel (pada backdrop) menutup menu.
  dialog?.addEventListener('click', (event) => {
    if (event.target === dialog) dialog.close();
  });
  // Tutup dialog bila layar melebar ke mode desktop.
  matchMedia('(min-width: 64rem)').addEventListener('change', (event) => {
    if (event.matches) dialog?.close();
  });
</script>

<style>
  .mobile-nav__open {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 2.5rem;
    padding: 0 var(--space-3);
    font: inherit;
    font-size: var(--text-sm);
    color: var(--ink);
    background: transparent;
    border: var(--border-hair) solid var(--ink-3);
    border-radius: var(--radius-1);
    cursor: pointer;
  }

  @media (min-width: 64rem) {
    .mobile-nav__open {
      display: none;
    }
  }

  .mobile-nav {
    width: min(20rem, 86vw);
    height: 100dvh;
    max-height: none;
    margin: 0 0 0 auto;
    padding: 0 var(--space-6) var(--space-8);
    background: var(--surface);
    color: var(--ink);
    border: 0;
    border-left: 1px solid var(--rule);
    overflow-y: auto;
  }

  .mobile-nav::backdrop {
    background: rgb(0 0 0 / 0.4);
  }

  .mobile-nav__bar {
    position: sticky;
    top: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--header-height);
    margin-bottom: var(--space-4);
    background: var(--surface);
    border-bottom: 1px solid var(--rule);
  }

  .mobile-nav__primary {
    margin-bottom: var(--space-8);
  }

  .mobile-nav__title {
    font-weight: 600;
  }

  .mobile-nav__close {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    color: var(--ink);
    background: transparent;
    border: 0;
    border-radius: var(--radius-1);
    cursor: pointer;
  }
</style>
