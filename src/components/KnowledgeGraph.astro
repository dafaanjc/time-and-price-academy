---
// Graf prasyarat sebagai diagram teknis (Tahap 5: simpul = label katalog, garis = tinta; jalur yang ditunjuk
// menyala kuningan): garis hairline siku, penanda kecil, label berbingkai, tautan ke halaman konsep.
// Simpul yang disorot (hover/fokus keyboard) menyala kuningan, garis prasyaratnya ikut, simpul yang tidak
// berhubungan meredup, dan kartu keterangan (nama + ringkasan) muncul halus. Tanpa JS graf tetap utuh;
// hanya sorotan & keterangan yang hilang. Di layar sempit graf dipertahankan pada ukuran terbacanya dan
// digeser mendatar (bukan diperkecil sampai teksnya tak terbaca).
// Simpul diberi penanda bentuk per kategori (R9, dari `marker` di data/categories.ts); legenda di bawah graf.
import { categories, type CategoryId } from '../data/categories';
import { markerPath, NODE_ANCHOR_X, NODE_HEIGHT, NODE_RADIUS, NODE_WIDTH, wrapText, wrapTitle, type GraphLayout } from '../lib/graph';

interface Props {
  graph: GraphLayout;
  /** Awalan ID unik bila komponen dipakai lebih dari sekali di satu halaman. */
  idPrefix?: string;
}

const { graph, idPrefix = 'graf' } = Astro.props;
const titleId = `${idPrefix}-judul`;
const descId = `${idPrefix}-desk`;
const markerId = `${idPrefix}-panah`;
const markerActiveId = `${idPrefix}-panah-aktif`;
const LINE_HEIGHT = 17;
const markerOf = (group: string | undefined) => categories.find((c) => c.id === (group as CategoryId))?.marker ?? 'circle';
// Legenda: hanya kategori yang benar-benar punya simpul di graf, dalam urutan kategori.
const legend = categories.filter((c) => graph.nodes.some((n) => n.group === c.id));
const LABEL_X = NODE_ANCHOR_X + NODE_RADIUS + 10;

// Posisi baris teks agar satu atau dua baris tetap di tengah sel simpul.
const lineY = (count: number, i: number) => NODE_HEIGHT / 2 + (i - (count - 1) / 2) * LINE_HEIGHT;

// Kartu keterangan: lebar tetap, tinggi mengikuti jumlah baris. Muncul di bawah simpul; di tingkat
// terakhir (tidak ada ruang di bawah) muncul di atasnya.
const TIP_WIDTH = 224;
const TIP_PAD = 12;
const TIP_TITLE_LINE = 17;
const TIP_TEXT_LINE = 16;
// Baris kategori/topik: label mono kapital kecil (~7,7px per karakter pada 11px + tracking) → 26 karakter.
const TIP_META_LINE = 14;
const tips = graph.nodes.map((n) => {
  const meta = wrapText(n.meta, 26, 2);
  const title = wrapTitle(n.title, 28);
  const text = wrapText(n.description, 30, 4);
  const metaHeight = meta.length > 0 ? meta.length * TIP_META_LINE + 6 : 0;
  const height =
    TIP_PAD * 2 + metaHeight + title.length * TIP_TITLE_LINE + (text.length > 0 ? 6 + text.length * TIP_TEXT_LINE : 0);
  const x = Math.max(0, Math.min(n.x, graph.width - TIP_WIDTH));
  const below = n.layer < graph.layerCount - 1;
  const y = below ? n.y + NODE_HEIGHT / 2 + NODE_RADIUS + 10 : n.y + NODE_HEIGHT / 2 - NODE_RADIUS - 10 - height;
  return { id: n.id, meta, metaHeight, title, text, height, x, y };
});
---

<div class="graph" data-graph data-marker={`url(#${markerId})`} data-marker-active={`url(#${markerActiveId})`}>
  <!-- Dapat difokuskan agar pengguna keyboard bisa menggeser graf di layar sempit. -->
  <div class="graph__scroll" tabindex="0" role="region" aria-labelledby={titleId} data-start-x={graph.nodes[0]?.x ?? 0}>
    <svg
      width={graph.width}
      height={graph.height}
      viewBox={`0 0 ${graph.width} ${graph.height}`}
      aria-labelledby={`${titleId} ${descId}`}
    >
      <title id={titleId}>Peta pengetahuan: hubungan prasyarat antar konsep</title>
      <desc id={descId}>
        Garis mengarah dari konsep prasyarat ke konsep yang membutuhkannya. Setiap titik adalah tautan ke halaman
        konsep.
      </desc>
      <defs>
        <marker id={markerId} viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto">
          <path class="arrow" d="M 0 0 L 10 5 L 0 10 z"></path>
        </marker>
        <marker id={markerActiveId} viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto">
          <path class="arrow arrow--active" d="M 0 0 L 10 5 L 0 10 z"></path>
        </marker>
      </defs>

      <g class="edges" aria-hidden="true">
        {
          graph.edges.map((e) => (
            <path class="edge" d={e.d} pathLength="1" data-from={e.from} data-to={e.to} marker-end={`url(#${markerId})`} />
          ))
        }
      </g>

      <g class="nodes">
        {
          graph.nodes.map((n) => (
            <a href={n.href} class="node" data-node={n.id} data-category={n.group} aria-label={n.title}>
              <g transform={`translate(${n.x} ${n.y})`}>
                <rect class="node__hit" width={NODE_WIDTH} height={NODE_HEIGHT} />
                <circle class="node__ring" cx={NODE_ANCHOR_X} cy={NODE_HEIGHT / 2} r={NODE_RADIUS + 5} />
                <path class="node__dot" d={markerPath(markerOf(n.group), NODE_ANCHOR_X, NODE_HEIGHT / 2, NODE_RADIUS)} />
                <rect class="node__plate" x={LABEL_X - 7} y="4" width={NODE_WIDTH - LABEL_X + 3} height={NODE_HEIGHT - 8} />
                <text x={LABEL_X} dominant-baseline="central" aria-hidden="true">
                  {n.lines.map((line, i) => (
                    <tspan x={LABEL_X} y={lineY(n.lines.length, i)}>
                      {line}
                    </tspan>
                  ))}
                </text>
              </g>
            </a>
          ))
        }
      </g>

      <!-- Kartu keterangan digambar terakhir agar selalu di atas simpul lain. Dekoratif: teksnya juga ada di halaman konsep. -->
      <g class="tips" aria-hidden="true">
        {
          tips.map((t) => (
            <g class="tip" data-tip={t.id} transform={`translate(${t.x} ${t.y})`}>
              <g class="tip__body">
                <rect class="tip__plate" width={TIP_WIDTH} height={t.height} />
                <path class="tip__rule" d={`M0 0 H${TIP_WIDTH}`} />
                {t.meta.length > 0 && (
                  <text class="tip__meta" x={TIP_PAD} dominant-baseline="hanging">
                    {t.meta.map((line, i) => (
                      <tspan x={TIP_PAD} y={TIP_PAD + i * TIP_META_LINE}>
                        {line}
                      </tspan>
                    ))}
                  </text>
                )}
                <text class="tip__title" x={TIP_PAD} dominant-baseline="hanging">
                  {t.title.map((line, i) => (
                    <tspan x={TIP_PAD} y={TIP_PAD + t.metaHeight + i * TIP_TITLE_LINE}>
                      {line}
                    </tspan>
                  ))}
                </text>
                <text class="tip__text" x={TIP_PAD} dominant-baseline="hanging">
                  {t.text.map((line, i) => (
                    <tspan x={TIP_PAD} y={TIP_PAD + t.metaHeight + t.title.length * TIP_TITLE_LINE + 6 + i * TIP_TEXT_LINE}>
                      {line}
                    </tspan>
                  ))}
                </text>
              </g>
            </g>
          ))
        }
      </g>
    </svg>
  </div>

  <!-- Legenda: bentuk penanda = kategori. Teksnya terbaca pembaca layar; gambar penandanya dekoratif. -->
  <div class="graph__legend label">
    <ul class="graph__categories" aria-label="Kategori (bentuk penanda simpul)">
      {
        legend.map((c) => (
          <li>
            <svg class="graph__key" viewBox="0 0 16 16" width="12" height="12" aria-hidden="true" focusable="false">
              <path d={markerPath(c.marker, 8, 8, 5.5)} />
            </svg>
            <span>{c.title}</span>
          </li>
        ))
      }
    </ul>
    <p class="graph__edge-key" aria-hidden="true">
      <span class="graph__key graph__key--edge"></span><span>Prasyarat → konsep</span>
      <span class="graph__hint"><span class="label__sep">·</span>Geser mendatar untuk melihat seluruh peta</span>
    </p>
  </div>
</div>

<script>
  // Sorotan simpul: simpul, garis prasyarat yang terhubung, tetangga langsung, dan kartu keterangannya
  // menyala bersama; sisanya meredup.
  document.querySelectorAll<HTMLElement>('[data-graph]').forEach((root) => {
    // Layar sempit: mulai dengan simpul akar (tingkat 0) di tengah layar, bukan jalur lompatan kosong di tepi kiri.
    const scroller = root.querySelector<HTMLElement>('.graph__scroll');
    if (scroller && scroller.scrollWidth > scroller.clientWidth) {
      scroller.scrollLeft = Math.max(0, Number(scroller.dataset.startX) + 12 - scroller.clientWidth / 2);
    }

    const marker = root.dataset.marker ?? '';
    const markerActive = root.dataset.markerActive ?? '';
    const edges = [...root.querySelectorAll<SVGPathElement>('.edge')];
    const tips = new Map([...root.querySelectorAll<SVGGElement>('.tip')].map((t) => [t.dataset.tip, t]));
    const nodes = new Map([...root.querySelectorAll<SVGAElement>('.node')].map((n) => [n.dataset.node, n]));

    const setActive = (id: string, on: boolean) => {
      root.classList.toggle('has-active', on);
      tips.get(id)?.classList.toggle('is-on', on);
      nodes.get(id)?.classList.toggle('is-active', on);
      for (const edge of edges) {
        if (edge.dataset.from !== id && edge.dataset.to !== id) continue;
        edge.classList.toggle('is-linked', on);
        edge.setAttribute('marker-end', on ? markerActive : marker);
        // Tetangga langsung (prasyarat dan konsep turunan) tetap terang.
        nodes.get(edge.dataset.from === id ? edge.dataset.to : edge.dataset.from)?.classList.toggle('is-related', on);
      }
    };

    nodes.forEach((node, id) => {
      for (const [on, events] of [
        [true, ['pointerenter', 'focus']],
        [false, ['pointerleave', 'blur']],
      ] as const) {
        for (const type of events) {
          node.addEventListener(type, (e) => {
            // Sentuhan langsung membuka tautan; tidak perlu sorotan yang tertinggal.
            if (e instanceof PointerEvent && e.pointerType === 'touch') return;
            setActive(id ?? '', on);
          });
        }
      }
    });
  });
</script>

<style>
  /* Ukuran asli graf dijaga; bila lebih lebar dari layar, area ini yang digeser. */
  /* Bidang koordinat eksplisit (R10): kisi yang sama dengan plot-field, bingkai garis ukur. */
  .graph__scroll {
    overflow-x: auto;
    padding: var(--space-2);
    background-color: var(--surface);
    background-image:
      linear-gradient(to right, var(--grid-line-major) var(--stroke-hair), transparent var(--stroke-hair)),
      linear-gradient(to bottom, var(--grid-line-major) var(--stroke-hair), transparent var(--stroke-hair));
    background-size: var(--grid-cell) var(--grid-cell);
    border: var(--border-hair) solid var(--rule-strong);
  }

  .graph__scroll:focus-visible {
    outline-offset: 4px;
  }

  .graph__scroll > svg {
    display: block;
    max-width: none;
    margin-inline: auto;
  }

  .graph__legend {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2) var(--space-6);
    margin: var(--space-3) 0 0;
  }

  .graph__categories,
  .graph__edge-key {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-1) var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .graph__categories li,
  .graph__edge-key {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }

  .graph__edge-key {
    gap: var(--space-2);
  }

  .graph__key {
    display: inline-block;
    flex: none;
  }

  svg.graph__key path {
    fill: var(--surface);
    stroke: var(--ink-3);
    stroke-width: var(--stroke-trace);
  }

  .graph__key--edge {
    width: var(--space-4);
    height: 0;
    border-top: var(--stroke-hair) solid var(--rule-strong);
  }

  /* Petunjuk geser hanya di layar sempit. */
  .graph__hint {
    display: none;
  }

  @media (max-width: 47.99rem) {
    .graph__hint {
      display: inline;
    }
  }

  .edge {
    fill: none;
    stroke: var(--ink-soft);
    stroke-width: var(--stroke-hair);
    transition:
      stroke var(--motion-base) var(--ease),
      opacity var(--motion-base) var(--ease);
  }

  /* Kosakata gerak "hubungan": garis prasyarat yang terhubung digambar ulang dari asalnya ke tujuannya. */
  .edge.is-linked {
    stroke: var(--mark);
    stroke-width: var(--stroke-trace);
    stroke-dasharray: 1;
    animation: edge-draw var(--motion-slow) var(--ease) both;
  }

  /* Fokus pada satu simpul: yang tidak berhubungan mundur ke latar. */
  .has-active .edge:not(.is-linked) {
    opacity: 0.35;
  }

  .arrow {
    fill: var(--ink-soft);
  }

  .arrow--active {
    fill: var(--mark);
  }

  /* Area sentuh seluas sel simpul, tidak terlihat. */
  .node__hit {
    fill: transparent;
  }

  .node {
    cursor: pointer;
    transition: opacity var(--motion-base) var(--ease);
  }

  .has-active .node:not(.is-active):not(.is-related) {
    opacity: 0.45;
  }

  /* Label katalog: bidang kertas berbingkai hairline di belakang judul. */
  .node__plate {
    fill: var(--paper);
    stroke: var(--rule-strong);
    stroke-width: var(--stroke-hair);
    transition: stroke var(--motion-base) var(--ease);
  }

  .node:hover .node__plate,
  .node:focus-visible .node__plate,
  .node.is-active .node__plate,
  .node.is-related .node__plate {
    stroke: var(--mark);
  }

  .node__dot {
    fill: var(--surface);
    stroke: var(--ink-3);
    stroke-width: var(--stroke-trace);
    transition:
      fill var(--motion-base) var(--ease),
      stroke var(--motion-base) var(--ease);
  }

  /* Cincin ukur tipis di sekeliling simpul aktif (bukan pendaran). */
  .node__ring {
    fill: none;
    stroke: var(--mark);
    stroke-width: var(--stroke-hair);
    opacity: 0;
    transition: opacity var(--motion-base) var(--ease);
  }

  .node text {
    fill: var(--ink-2);
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: 600;
    transition: fill var(--motion-base) var(--ease);
  }

  .node.is-related .node__dot {
    stroke: var(--mark);
  }

  .node:hover .node__dot,
  .node:focus-visible .node__dot,
  .node.is-active .node__dot {
    fill: var(--mark);
    stroke: var(--mark);
  }

  .node:hover .node__ring,
  .node:focus-visible .node__ring,
  .node.is-active .node__ring {
    opacity: 1;
  }

  .node:hover text,
  .node:focus-visible text,
  .node.is-active text {
    fill: var(--ink);
  }

  .node:focus-visible {
    outline: none;
  }

  /* Fokus keyboard: cincin + garis bawah label, jadi tidak hanya bergantung pada warna. */
  .node:focus-visible text {
    text-decoration: underline;
    text-decoration-thickness: var(--stroke-hair);
    text-underline-offset: 0.2em;
  }

  .tip {
    pointer-events: none;
  }

  .tip__body {
    opacity: 0;
    transform: translateY(4px);
    transition:
      opacity var(--motion-base) var(--ease),
      transform var(--motion-base) var(--ease);
  }

  .tip.is-on .tip__body {
    opacity: 1;
    transform: translateY(0);
  }

  .tip__plate {
    fill: var(--surface);
    stroke: var(--rule-strong);
    stroke-width: var(--stroke-hair);
  }

  .tip__rule {
    fill: none;
    stroke: var(--mark);
    stroke-width: var(--border-mark);
  }

  .tip__meta {
    fill: var(--ink-3);
    font-family: var(--font-label);
    font-size: var(--text-xs);
    font-style: italic;
    font-variant-caps: small-caps;
    letter-spacing: 0.02em;
  }

  .tip__title {
    fill: var(--ink);
    font-family: var(--font-serif);
    font-size: var(--text-sm);
    font-weight: 600;
  }

  .tip__text {
    fill: var(--ink-2);
    font-family: var(--font-sans);
    font-size: var(--text-xs);
  }
</style>
