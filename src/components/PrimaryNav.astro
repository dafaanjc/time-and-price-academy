---
// Navigasi utama: baris di header desktop, kolom di menu mobile.
import { navCurrent, primaryNav } from '../lib/nav';

interface Props {
  layout: 'row' | 'column';
}

const { layout } = Astro.props;
const pathname = Astro.url.pathname;
---

<ul class={`primary-nav primary-nav--${layout}`}>
  {
    primaryNav.map((item) => (
      <li>
        <a href={item.href} aria-current={navCurrent(item, pathname)}>
          {item.label}
        </a>
      </li>
    ))
  }
</ul>

<style>
  .primary-nav {
    display: flex;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .primary-nav--row {
    gap: var(--space-6);
  }

  .primary-nav--column {
    flex-direction: column;
  }

  a {
    display: block;
    color: var(--ink-2);
    text-decoration: none;
    transition:
      color var(--motion-fast) var(--ease),
      border-color var(--motion-fast) var(--ease);
  }

  .primary-nav--row a {
    padding-block: var(--space-2);
    border-bottom: var(--stroke-trace-bold) solid transparent;
  }

  .primary-nav--column a {
    padding: var(--space-3) 0;
    font-family: var(--font-display);
    font-size: var(--text-lg);
    line-height: var(--leading-tight);
    border-bottom: var(--border-hair) solid var(--rule);
  }

  a:hover {
    color: var(--ink);
  }

  .primary-nav--row a:hover {
    border-bottom-color: var(--rule-strong);
  }

  /* Bagian aktif: garis kuningan di bawah (desktop) atau di kiri (mobile); teks tinta. */
  a[aria-current] {
    color: var(--ink);
  }

  .primary-nav--row a[aria-current] {
    border-bottom-color: var(--brass);
  }

  .primary-nav--column a[aria-current] {
    padding-left: var(--space-3);
    border-left: var(--border-hair) solid var(--brass);
  }
</style>
