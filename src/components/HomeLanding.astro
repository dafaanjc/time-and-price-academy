---
// Hero beranda — Tahap 3 "Pelat Ukiran" (docs/redesign-brief.md). Teks hero sama dengan R9.1, kecuali baris merek
// (induk + produk) di atas judul yang dihapus pada revisi Tahap 3: header sudah menjadi identitas.
// Nama file & kelas (`landing__*`) sengaja berbeda dari HomeHero lama di `main`: Astro menurunkan ID cakupan CSS
// dari path file, jadi dev server yang masih memegang CSS HomeHero lama tidak bisa lagi menimpa markup ini.
// Kiri (dinding terang): judul kalimat biasa, pertanyaan inti ("apa yang terjadi saat
// keputusan Anda salah?"), lead, dua pintu masuk (masalah; jam pasir modal di bagian berikutnya).
// Kanan: pelat ukiran (figures/HeroStage) — spiral emas & kisi, emblem resmi, cabang kemungkinan dari jam pasir;
// benang merah dari "Sekarang" turun ke bagian "00 Anggaran salah". Tanpa kontrol: alat hitung ada di bawah hero.
// Desktop: pelat utuh berbingkai di kolom 6–12 (di atas kertas). Mobile: pelat tepi ke tepi di bawah teks.
import { siteConfig } from '../config/site';
import HeroStage from './figures/HeroStage.astro';
---

<section class="landing" aria-labelledby="hero-title">
  <div class="landing__text">
    <h1 id="hero-title" class="landing__title">{siteConfig.heroLine}</h1>
    <p class="landing__question">Pertanyaan yang lebih penting: apa yang terjadi saat keputusan Anda salah?</p>
    <p class="landing__lead">
      Setiap posisi punya jam pasirnya sendiri. Seberapa cepat modal habis ditentukan sebelum entry, oleh
      risiko per transaksi. Mulai dari masalah yang Anda alami, lalu pahami konsep di baliknya.
    </p>
    <p class="landing__actions">
      <a class="button" href="#masalah">Mulai dari masalah</a>
      <a class="landing__secondary" href="#jam-pasir">Uji jam pasir modal ↓</a>
    </p>
  </div>

  <div class="landing__stage">
    <HeroStage />
  </div>
</section>

<style>
  .landing {
    display: grid;
    gap: var(--space-8);
    padding-block: 0 var(--space-8);
  }

  /* Judul kalimat biasa, besar dan rapat: satu pernyataan, bukan slogan kapital. Skala sengaja dibatasi
     (revisi Tahap 3) agar paragraf dan kedua tombol terlihat tanpa gulir di 1440×900 dan 1920×1080. */
  .landing__title {
    margin: 0 0 var(--space-4);
    font-size: clamp(var(--text-3xl), 11vw, var(--text-4xl));
    line-height: var(--leading-hero);
    letter-spacing: var(--tracking-display);
    text-wrap: balance;
  }

  .landing__question {
    max-width: 30ch;
    margin: 0;
    font-family: var(--font-serif);
    font-size: var(--text-lg);
    font-style: italic;
    line-height: var(--leading-tight);
    color: var(--ink-2);
    text-wrap: balance;
  }

  .landing__lead {
    max-width: var(--measure-narrow);
    margin: var(--space-4) 0 0;
    color: var(--ink-2);
  }

  .landing__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-6);
    margin: var(--space-6) 0 0;
  }

  .button {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0 var(--space-6);
    font-weight: 600;
    color: var(--paper);
    background: var(--ink);
    border: var(--border-hair) solid var(--ink);
    border-radius: var(--radius-1);
    text-decoration: none;
    transition:
      color var(--motion-fast) var(--ease),
      background-color var(--motion-fast) var(--ease);
  }

  .button:hover {
    color: var(--ink);
    background: transparent;
  }

  .landing__secondary {
    font-weight: 600;
    color: var(--ink);
  }

  /* Mobile/tablet: pelat tepi ke tepi. Benang merah = padding bawah hero + padding atas bagian berikutnya
     (src/pages/index.astro → .home-section). */
  .landing__stage {
    --stage-thread-length: calc(var(--space-8) + var(--space-16));
    margin-inline: calc(-1 * var(--gutter));
    min-width: 0;
  }

  @media (min-width: 64rem) {
    .landing {
      grid-template-columns: repeat(var(--grid-columns), minmax(0, 1fr));
      gap: var(--grid-gap);
      align-items: center;
      padding-block: 0 var(--space-16);
    }

    .landing__text {
      grid-column: 1 / span 5;
    }

    /* Maks --text-4xl (±76px, sebelumnya --text-6xl ±101px): −25 %. 1440px → ±55px, 1920px → ±73px. */
    .landing__title {
      font-size: clamp(var(--text-3xl), 3.8vw, var(--text-4xl));
    }

    /* Ikut proporsional: --text-lg (sebelumnya --text-xl). */
    .landing__question {
      font-size: var(--text-lg);
    }

    /* Pelat utuh di kolom 6–12: bingkainya terlihat di keempat sisi. */
    .landing__stage {
      --stage-thread-length: calc(var(--space-16) + var(--space-24));
      grid-column: 6 / -1;
      margin-inline: 0;
    }
  }
</style>
