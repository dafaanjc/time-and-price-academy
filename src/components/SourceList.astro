---
import SourceCard from './SourceCard.astro';
import { layoutSectionIds } from '../lib/sections';
import { sortSources, type Source } from '../lib/sources';

interface Props {
  sources: Source[];
}

const sources = sortSources(Astro.props.sources);
const id = layoutSectionIds.sources;
---

<section class="source-list" aria-labelledby={id}>
  <h2 id={id}>Sumber</h2>
  {
    sources.length > 0 ? (
      <ol>
        {sources.map((source, i) => (
          <li>
            <SourceCard source={source} index={i + 1} />
          </li>
        ))}
      </ol>
    ) : (
      <p class="source-list__empty">Belum ada sumber terverifikasi untuk konsep ini.</p>
    )
  }
</section>

<style>
  .source-list {
    max-width: var(--measure);
    padding-top: var(--space-8);
    border-top: 1px solid var(--rule-strong);
  }

  h2 {
    margin: 0 0 0.75rem;
    font-size: var(--text-xl);
  }

  ol {
    display: grid;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Kolom margin (desktop lebar): label objek yang rapat. */
  @media (min-width: 80rem) {
    .source-list {
      padding-top: var(--space-2);
      border-top: var(--border-mark) double var(--brass);
    }

    .source-list h2 {
      font-family: var(--font-label);
      font-size: var(--text-sm);
      font-style: italic;
      font-weight: 400;
      font-variant-caps: small-caps;
      letter-spacing: 0.02em;
      color: var(--ink-3);
    }

    .source-list :global(.source-card) {
      padding: var(--space-3);
    }

    .source-list :global(.source-card__title) {
      font-size: var(--text-base);
    }
  }

  .source-list__empty {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--ink-3);
  }
</style>
