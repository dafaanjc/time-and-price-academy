---
// INSTRUMEN 00 · Jam pasir modal (beranda, bagian tepat di bawah hero; sejak R9.1 di dinding terang).
// Warna dari token umum (--ink*, --rule*, --mark, --sand), jadi juga benar bila diletakkan di dalam `.plate`.
// Pasir = modal. Setiap keputusan yang salah menjatuhkan risiko % dari modal berjalan; bukaan leher = risiko per
// transaksi. Skala di kanan dikalibrasi dari luas tabung (tidak linear), penunjuk kuningan = sisa modal, garis
// putus-putus = sisa modal bila risikonya 1%. Hitungan pasti (src/lib/hourglass.ts), bukan data pasar.
// Tanpa JS: keadaan awal tetap tergambar lengkap dengan teks setara; kontrol disembunyikan.
// Gerak: pasir berpindah HANYA saat pengguna bertindak (--motion-slow, sekali); tanpa animasi berulang.
import {
  REFERENCE_RISK,
  describeHourglass,
  formatPercent,
  formatRecovery,
  hourglassGeometry,
  hourglassScale,
  hourglassState,
} from '../../lib/hourglass';

const RISKS = [1, 2, 5, 10] as const;
const defaults = { risk: 5, losses: 10, maxLosses: 40 };

const geo = hourglassGeometry();
const scale = hourglassScale(geo);
const state = hourglassState(geo, defaults.risk, defaults.losses);
const { cx, neck, half, top, bottom, width, height } = geo;
const post = half + 12;
const scaleX = cx + half + 24;
const id = 'jam-pasir';
const showReference = defaults.risk !== REFERENCE_RISK && defaults.losses > 0;
const px = (y: number) => `transform: translateY(${y}px)`;
---

<figure
  id={id}
  class="hourglass"
  data-hourglass
  data-risk={defaults.risk}
  data-losses={defaults.losses}
  data-max-losses={defaults.maxLosses}
  aria-labelledby={`${id}-caption`}
>
  <p class="label">
    <span class="label__index">Instrumen 00</span><span class="label__sep" aria-hidden="true">·</span>Jam pasir modal
  </p>

  <svg
    class="hourglass__svg"
    viewBox={`-52 0 ${width + 104} ${height}`}
    role="img"
    aria-labelledby={`${id}-title ${id}-desc`}
    focusable="false"
  >
    <title id={`${id}-title`}>Jam pasir modal</title>
    <desc id={`${id}-desc`} data-out="desc">{describeHourglass(state)}</desc>
    <defs>
      <clipPath id={`${id}-top`}><path d={geo.topBulb}></path></clipPath>
      <clipPath id={`${id}-bottom`}><path d={geo.bottomBulb}></path></clipPath>
    </defs>

    <!-- Rangka: pelat atas & bawah, dua tiang. -->
    <g class="svg-axis">
      <rect x={cx - post - 6} y={top - 12} width={(post + 6) * 2} height="12"></rect>
      <rect x={cx - post - 6} y={bottom} width={(post + 6) * 2} height="12"></rect>
      <path d={`M${cx - post} ${top} V${bottom} M${cx + post} ${top} V${bottom}`}></path>
    </g>

    <!-- Pasir atas (modal tersisa) dan bawah (modal yang hilang). Bergerak lewat transform. -->
    <g clip-path={`url(#${id}-top)`}>
      <g class="hourglass__sand" data-out="top" style={px(state.topLevel)}>
        <rect class="hourglass__fill" x="0" y="0" width={width} height={geo.bulb + 2}></rect>
        <rect class="hourglass__surface" x="0" y="0" width={width} height="1.5"></rect>
      </g>
      <g class:list={['hourglass__sand', { 'is-hidden': !showReference }]} data-out="reference" style={px(state.referenceLevel)}>
        <path class="svg-guide" d={`M0 0 H${width}`}></path>
      </g>
    </g>
    <g clip-path={`url(#${id}-bottom)`}>
      <g class="hourglass__sand" data-out="bottom" style={px(state.bottomLevel)}>
        <rect class="hourglass__fill" x="0" y="0" width={width} height={geo.bulb + 2}></rect>
        <rect class="hourglass__surface" x="0" y="0" width={width} height="1.5"></rect>
      </g>
    </g>
    <!-- Aliran di leher: tebalnya = risiko per transaksi. -->
    <line
      class:list={['hourglass__stream', { 'is-hidden': defaults.losses === 0 }]}
      data-out="stream"
      x1={cx}
      y1={neck}
      x2={cx}
      y2={state.bottomLevel}
      stroke-width={state.stream}
    ></line>

    <path class="hourglass__glass" d={geo.glass}></path>

    <!-- Skala sisa modal (dikalibrasi dari luas tabung) dan penunjuk kuningan. -->
    <path class="svg-axis" d={`M${scaleX} ${top} V${neck}`}></path>
    <g class="svg-tick">
      {scale.map((s) => <path d={`M${scaleX} ${s.y} h${s.major ? 8 : 4}`} />)}
    </g>
    <g class="svg-label">
      {scale.filter((s) => s.major).map((s) => <text x={scaleX + 12} y={s.y + 3.5}>{s.percent}%</text>)}
      <!-- Dekat leher: garis pembanding 1% tidak pernah turun ke sini (≥ 66,9% sampai 40 kali salah). -->
      <text x={cx - post - 8} y={neck - 24} text-anchor="end">Modal</text>
      <text x={cx - post - 8} y={bottom - 8} text-anchor="end">Rugi</text>
    </g>
    <g class="hourglass__sand" data-out="pointer" style={px(state.topLevel)}>
      <path class="svg-mark" d={`M${scaleX - 2} 0 l-7 -4 v8 Z`}></path>
      <path class="hourglass__pointer" d={`M${cx + half - 4} 0 H${scaleX - 9}`}></path>
    </g>
    <g class:list={['hourglass__sand', { 'is-hidden': !showReference }]} data-out="reference-label" style={px(state.referenceLevel)}>
      <text class="svg-label" x={cx - post - 8} y="3.5" text-anchor="end">Risiko 1%</text>
    </g>
  </svg>

  <dl class="hourglass__readout">
    <div class="hourglass__main">
      <dt class="label">Sisa modal</dt>
      <dd data-out="remaining">{formatPercent(state.remaining)}</dd>
    </div>
    <div>
      <dt class="label">Salah beruntun</dt>
      <dd data-out="losses">{state.losses}×</dd>
    </div>
    <div>
      <dt class="label">Untuk pulih</dt>
      <dd data-out="recovery">{formatRecovery(state.recovery)}</dd>
    </div>
  </dl>

  <form class="hourglass__controls" data-controls hidden>
    <fieldset class="hourglass__risk">
      <legend class="label">Risiko per transaksi</legend>
      {
        RISKS.map((r) => (
          <label>
            <input type="radio" name="risk" value={r} checked={r === defaults.risk} />
            <span>{r}%</span>
          </label>
        ))
      }
    </fieldset>
    <div class="hourglass__actions">
      <button type="button" class="hourglass__step" data-action="loss">Salah sekali lagi <span aria-hidden="true">→</span></button>
      <button type="button" class="hourglass__reset" data-action="reset">Ulang dari nol</button>
    </div>
  </form>

  <p class="visually-hidden" aria-live="polite" data-out="live"></p>

  <figcaption id={`${id}-caption`} class="hourglass__caption">
    Pasir adalah modal. Setiap keputusan yang salah menjatuhkan persentase yang sama dari modal yang tersisa;
    bukaan leher adalah risiko per transaksi. Hitungan pasti, bukan data pasar atau rekomendasi.
  </figcaption>
</figure>

<script>
  import {
    describeHourglass,
    formatPercent,
    formatRecovery,
    hourglassGeometry,
    hourglassState,
    REFERENCE_RISK,
  } from '../../lib/hourglass';

  const geo = hourglassGeometry();

  for (const root of document.querySelectorAll<HTMLElement>('[data-hourglass]')) {
    const form = root.querySelector<HTMLFormElement>('[data-controls]');
    if (!form) continue;
    const out = (name: string) => root.querySelector<SVGElement | HTMLElement>(`[data-out="${name}"]`)!;
    const step = form.querySelector<HTMLButtonElement>('[data-action="loss"]')!;
    const max = Number(root.dataset.maxLosses);
    let risk = Number(root.dataset.risk);
    let losses = Number(root.dataset.losses);

    const render = (announce: boolean) => {
      const s = hourglassState(geo, risk, losses);
      const move = (name: string, y: number) => (out(name).style.transform = `translateY(${y}px)`);
      move('top', s.topLevel);
      move('bottom', s.bottomLevel);
      move('pointer', s.topLevel);
      move('reference', s.referenceLevel);
      move('reference-label', s.referenceLevel);
      const showReference = risk !== REFERENCE_RISK && losses > 0;
      out('reference').classList.toggle('is-hidden', !showReference);
      out('reference-label').classList.toggle('is-hidden', !showReference);
      const stream = out('stream');
      stream.setAttribute('y2', String(s.bottomLevel));
      stream.setAttribute('stroke-width', String(s.stream));
      stream.classList.toggle('is-hidden', losses === 0);
      out('remaining').textContent = formatPercent(s.remaining);
      out('losses').textContent = `${losses}×`;
      out('recovery').textContent = formatRecovery(s.recovery);
      const text = describeHourglass(s);
      out('desc').textContent = text;
      if (announce) {
        out('live').textContent = text;
        // Kosakata gerak "konsekuensi" (R10): angka yang berubah karena tindakan pengguna ditandai sekali.
        for (const el of [out('remaining'), out('recovery')]) {
          el.classList.remove('value-changed');
          void (el as HTMLElement).offsetWidth;
          el.classList.add('value-changed');
        }
      }
      step.disabled = losses >= max;
    };

    form.addEventListener('change', () => {
      risk = Number(new FormData(form).get('risk'));
      render(true);
    });
    form.addEventListener('click', (event) => {
      const action = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-action]')?.dataset.action;
      if (action === 'loss') losses = Math.min(max, losses + 1);
      else if (action === 'reset') losses = 0;
      else return;
      render(true);
    });
    form.hidden = false;
    render(false);
  }
</script>

<style>
  .hourglass {
    display: grid;
    gap: var(--space-4);
    margin: 0;
    min-width: 0;
  }

  .hourglass [hidden],
  .hourglass .is-hidden {
    display: none;
  }

  .hourglass__svg {
    display: block;
    width: 100%;
    max-width: 22rem;
    height: auto;
    margin-inline: auto;
    overflow: visible;
  }

  .hourglass__glass {
    fill: none;
    stroke: var(--ink-2);
    stroke-width: var(--stroke-trace);
    stroke-linejoin: round;
  }

  .hourglass__fill {
    fill: var(--sand);
  }

  .hourglass__surface {
    fill: var(--mark);
  }

  .hourglass__stream {
    stroke: var(--mark);
  }

  .hourglass__pointer {
    fill: none;
    stroke: var(--mark);
    stroke-width: var(--stroke-hair);
    stroke-dasharray: var(--dash-guide);
  }

  /* Satu-satunya gerak instrumen: pasir berpindah sekali per tindakan pengguna. */
  .hourglass__sand {
    transition: transform var(--motion-slow) var(--ease);
  }

  .hourglass__readout {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) repeat(2, minmax(0, 1fr));
    gap: var(--space-4);
    margin: 0;
    padding-top: var(--space-3);
    border-top: var(--border-hair) solid var(--rule);
  }

  .hourglass__readout dd {
    margin: var(--space-1) 0 0;
    font-family: var(--font-serif);
    font-size: var(--text-lg);
    font-weight: 600;
    line-height: 1.1;
  }

  .hourglass__main dd {
    font-size: var(--text-2xl);
    color: var(--ink);
  }

  .hourglass__main dt {
    color: var(--mark);
  }

  .hourglass__controls {
    display: grid;
    gap: var(--space-4);
  }

  .hourglass__risk {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    border: 0;
  }

  .hourglass__risk legend {
    width: 100%;
    margin-bottom: var(--space-2);
    padding: 0;
  }

  .hourglass__risk label {
    position: relative;
  }

  .hourglass__risk input {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: pointer;
  }

  .hourglass__risk span {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 3.25rem;
    min-height: 2.75rem;
    padding: 0 var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--ink-2);
    border: var(--border-hair) solid var(--rule-strong);
    border-radius: var(--radius-1);
    transition:
      color var(--motion-fast) var(--ease),
      border-color var(--motion-fast) var(--ease);
  }

  .hourglass__risk input:hover + span {
    color: var(--ink);
    border-color: var(--ink-2);
  }

  .hourglass__risk input:checked + span {
    color: var(--mark);
    font-weight: 600;
    border-color: var(--mark);
  }

  .hourglass__risk input:focus-visible + span {
    outline: 2px solid var(--ink);
    outline-offset: 2px;
  }

  .hourglass__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-4);
    align-items: center;
  }

  .hourglass__actions button {
    min-height: 2.75rem;
    padding: 0 var(--space-4);
    font: inherit;
    font-weight: 600;
    border-radius: var(--radius-1);
    cursor: pointer;
    transition:
      color var(--motion-fast) var(--ease),
      background-color var(--motion-fast) var(--ease);
  }

  .hourglass__step {
    color: var(--paper);
    background: var(--ink);
    border: var(--border-hair) solid var(--ink);
  }

  .hourglass__step:hover:not(:disabled) {
    color: var(--ink);
    background: transparent;
  }

  .hourglass__step:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .hourglass__actions .hourglass__reset {
    padding-inline: 0;
    color: var(--ink);
    background: none;
    border: 0;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
  }

  .hourglass__reset:hover {
    text-decoration-thickness: 2px;
  }

  .hourglass__caption {
    font-size: var(--text-xs);
    line-height: 1.5;
    color: var(--ink-3);
  }
</style>
