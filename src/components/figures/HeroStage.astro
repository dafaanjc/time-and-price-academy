---
// Hero "Pelat Ukiran" (docs/redesign-brief.md → Tahap 3): satu pelat gelap besar berbingkai ganda di atas
// kertas, berisi logo dengan kedalaman berlapis (2.5D, tanpa library):
//   1. belakang: kisi waktu × harga (CSS) + spiral emas vektor (figures/GoldenSpiral) yang matanya tepat di jam
//      pasir figur — waktu berputar masuk ke "sekarang";
//   2. tengah: emblem resmi (BrandEmblem, versi hitam, dilebur `screen`, tidak diwarnai ulang). Potongan hanya
//      tepi pelat (jubah bawah & bahu kiri); kepala dan jam pasir selalu utuh;
//   3. depan: medan hasil prosedural (src/lib/outcome-field.ts) — cabang kemungkinan dari jam pasir, selubung
//      ±2σ ∝ √t, garis E[P] kuningan (satu-satunya lintasan kuningan), kurva kepadatan di T.
// Dua komposisi dipilih dari lebar panggung sendiri (container query ≥ 34rem): lebar 1000×720 (figur kiri, medan
// kanan) dan ringkas 600×760 (figur atas, garis potong, medan di bawah dengan satu jalur masa lalu).
//
// Gerak (satu momen utama situs), semuanya CSS scroll-driven (`view-timeline` pada pelat) dan hanya bila
// `prefers-reduced-motion: no-preference` + browser mendukung `animation-timeline`; selain itu pelat tampil diam
// dan lengkap (keadaan akhir):
//   - lapisan bergeser dengan kecepatan berbeda (--hero-shift-back/mid/front; dikurangi di mobile);
//   - cabang "tergambar" dari jam pasir, spiral terurai dari matanya di jam pasir (stroke-dashoffset, `pathLength="1"`);
//   - lalu kilau tipis menyapu pelat (--hero-sheen), sekali per arah gulir.
// Kemiringan kursor (maks --hero-tilt, 4°) + paralaks kursor per lapisan: skrip kecil, dipasang saat browser
// idle, hanya desktop dengan kursor halus. Benang merah ke bagian "Anggaran salah": garis kuningan dari "Sekarang"
// turun keluar pelat sampai judul bagian berikutnya, diakhiri glyph jam pasir.
import { siteConfig } from '../../config/site';
import { spiralEye } from '../../lib/golden-spiral';
import { outcomeField } from '../../lib/outcome-field';
import BrandEmblem from '../BrandEmblem.astro';
import GoldenSpiral from './GoldenSpiral.astro';
import HourglassGlyph from './HourglassGlyph.astro';

// Komposisi lebar: 1000×720. Titik "sekarang" tepat di kanan jam pasir figur.
const W = { w: 1000, h: 720, x0: 684, y0: 347, xT: 905, sigmaT: 66, axis: 664 };
const wide = outcomeField({ x0: W.x0, y0: W.y0, xT: W.xT, sigmaT: W.sigmaT, densityWidth: 58, seed: 11 });

// Komposisi ringkas: 600×760. Figur dipotong di y = 500; "sekarang" di bawah jam pasir.
const C = { w: 600, h: 760, x0: 368, y0: 636, xT: 526, sigmaT: 34, axis: 742, cut: 500 };
const compact = outcomeField({ x0: C.x0, y0: C.y0, xT: C.xT, sigmaT: C.sigmaT, densityWidth: 40, seed: 11, steps: 24 });
// Satu jalur masa lalu (deterministik) yang tiba di "sekarang".
const past = (() => {
  const pts: string[] = [];
  const n = 18;
  for (let i = 0; i <= n; i++) {
    const x = 28 + ((C.x0 - 28) * i) / n;
    const y = C.y0 + (i === n ? 0 : Math.sin(i * 1.7) * 9 + Math.cos(i * 0.9) * 6);
    pts.push(`${i ? 'L' : 'M'}${Math.round(x * 10) / 10} ${Math.round(y * 10) / 10}`);
  }
  return pts.join(' ');
})();

const pct = (v: number, of: number) => `${Math.round((v / of) * 10000) / 100}%`;

// Kotak emblem per komposisi (satuan viewBox). Lebar: figur digeser ke kiri (revisi Tahap 3) agar ada jarak
// antara jam pasir (tepi kanan ±603) dan sumbu Harga/"sekarang" (x0 = 684); kepala tetap utuh (tepi kiri ±49).
// Garis bantu tipis menyambungkan jam pasir ke "sekarang". Ringkas tidak berubah.
const ART_WIDE = { x: -220, y: -6, w: 860 };
const ART_COMPACT = { x: -200, y: -10, w: 700 };

// Spiral emas: matanya di pusat jam pasir yang dipegang figur. Pusat jam pasir pada aset 1024px ≈ (830, 420),
// lalu dipetakan lewat kotak emblem tiap komposisi → lebar (477, 347), ringkas (367, 277).
// Tepi kanan jam pasir pada aset ≈ 980/1024.
const HOURGLASS = { x: 830 / 1024, y: 420 / 1024, right: 980 / 1024 };
const hourglassRightWide = Math.round(ART_WIDE.x + HOURGLASS.right * ART_WIDE.w);
const spiralBox = (box: { w: number; h: number }, art: { x: number; y: number; w: number }, width: number) => {
  const [ex, ey] = spiralEye(1000);
  const k = width / 1000;
  const eye = { x: art.x + HOURGLASS.x * art.w, y: art.y + HOURGLASS.y * art.w };
  return `left: ${pct(eye.x - ex * k, box.w)}; top: ${pct(eye.y - ey * k, box.h)}; width: ${pct(width, box.w)}`;
};
const spiralWide = spiralBox(W, ART_WIDE, 1400);
const spiralCompact = spiralBox(C, ART_COMPACT, 900);
const artWideStyle = `--art-wide-left: ${pct(ART_WIDE.x, W.w)}; --art-wide-top: ${pct(ART_WIDE.y, W.h)}; --art-wide-width: ${pct(ART_WIDE.w, W.w)}`;
---

<div class="stage-wrap">
  <figure class="stage plate" data-stage aria-labelledby="stage-caption">
    <div class="stage__field" style={artWideStyle}>
      <!-- Lapisan 1b: spiral emas (belakang, di atas kisi). Dekoratif. -->
      <div class="stage__spiral stage__spiral--wide" style={spiralWide}>
        <GoldenSpiral iterations={10} />
      </div>
      <div class="stage__spiral stage__spiral--compact" style={spiralCompact}>
        <GoldenSpiral iterations={10} />
      </div>

      <!-- Lapisan 2: emblem resmi. Hanya dipindah; potongan oleh tepi pelat. -->
      <div class="stage__art">
        <div class="stage__art-inner">
          <BrandEmblem />
        </div>
      </div>

      <!-- Lapisan 3: medan hasil. Dekoratif-informatif; artinya ada di keterangan. -->
      <svg class="stage__svg stage__svg--wide" viewBox={`0 0 ${W.w} ${W.h}`} aria-hidden="true" focusable="false">
        <path class="svg-axis" d={`M${W.x0} ${W.axis} H${W.w - 24}`}></path>
        <path class="svg-tick" d={[0, 1, 2, 3, 4, 5, 6].map((i) => `M${W.x0 + i * ((W.xT - W.x0) / 6)} ${W.axis} v6`).join(' ')}></path>
        <path class="svg-guide stage__now-guide" d={`M${W.x0} 96 V${W.h}`}></path>
        <path class="svg-guide" d={`M${W.xT} 96 V${W.axis}`}></path>
        <path class="svg-guide" d={`M${hourglassRightWide + 8} ${W.y0} H${W.x0 - 8}`}></path>
        {wide.paths.map((d) => <path class="stage__path stage__draw" d={d} pathLength="1" />)}
        <path class="stage__envelope" d={wide.upper}></path>
        <path class="stage__envelope" d={wide.lower}></path>
        <path class="stage__density-curve" d={wide.density}></path>
        <path class="stage__expected" d={wide.expected}></path>
        <circle class="stage__now" cx={W.x0} cy={W.y0} r="4.5"></circle>
        <g class="stage__labels stage__labels--wide">
          <text x={W.x0 - 10} y={W.axis + 28} text-anchor="end">Sekarang</text>
          <text x={W.xT + 8} y={W.axis - 10}>T</text>
          <text x={W.w - 24} y={W.axis + 28} text-anchor="end">Waktu →</text>
          <text x={W.x0 + 8} y="92">Harga</text>
          <text class="stage__label-mark" x={W.xT - 8} y={W.y0 - 10} text-anchor="end">E[P]</text>
        </g>
      </svg>

      <svg class="stage__svg stage__svg--compact" viewBox={`0 0 ${C.w} ${C.h}`} aria-hidden="true" focusable="false">
        <path class="stage__cut" d={`M0 ${C.cut} H${C.w}`}></path>
        <path class="svg-guide stage__now-guide" d={`M${C.x0} 452 V${C.h}`}></path>
        <path class="svg-axis" d={`M24 ${C.axis} H${C.w - 16}`}></path>
        <path class="stage__past" d={past}></path>
        {compact.paths.map((d) => <path class="stage__path stage__draw" d={d} pathLength="1" />)}
        <path class="stage__envelope" d={compact.upper}></path>
        <path class="stage__envelope" d={compact.lower}></path>
        <path class="stage__density-curve" d={compact.density}></path>
        <path class="stage__expected" d={compact.expected}></path>
        <circle class="stage__now" cx={C.x0} cy={C.y0} r="4"></circle>
        <g class="stage__labels stage__labels--compact">
          <text x="28" y={C.y0 - 24}>Masa lalu</text>
          <text x={C.x0 - 8} y={C.axis - 8} text-anchor="end">Sekarang</text>
          <text x={C.xT - 8} y={C.axis - 8} text-anchor="end">T</text>
          <text class="stage__label-mark" x={C.xT - 8} y={C.y0 - 8} text-anchor="end">E[P]</text>
        </g>
      </svg>
    </div>

    <figcaption id="stage-caption" class="stage__caption">
      <p class="label">
        <span class="label__index">Fig. 00</span><span class="label__sep" aria-hidden="true">·</span>Waktu × harga
      </p>
      <p class="stage__text">
        Dari jam pasir di tangan figur, masa depan bercabang: setiap garis satu kemungkinan, garis kuningan nilai
        harapan, kurva di T sebaran hasilnya. Semakin jauh horizon, semakin lebar sebarannya (σ ∝ √t). Ilustrasi
        konsep, bukan data pasar.
      </p>
      <p class="label stage__object">
        <span class="label__index">Objek 00</span><span class="label__sep" aria-hidden="true">·</span>{`Emblem ${siteConfig.masterBrand}`}
      </p>
    </figcaption>
    <span class="stage__sheen" aria-hidden="true"></span>
  </figure>

  <!-- Benang merah: "Sekarang" turun ke anggaran salah (jam pasir modal) di bagian berikutnya. -->
  <div class="stage__thread" aria-hidden="true">
    <span class="stage__thread-line"></span>
    <HourglassGlyph fill={0.6} />
  </div>
</div>

<script>
  // Kemiringan kursor + paralaks kursor per lapisan (desktop, kursor halus). Dipasang saat browser idle agar tidak
  // bersaing dengan render awal. Tidak ada loop terus-menerus: rAF hanya berjalan sampai nilai menetap.
  const stage = document.querySelector<HTMLElement>('[data-stage]');
  const desktop = window.matchMedia('(hover: hover) and (pointer: fine) and (min-width: 64rem)');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
  const whenIdle = (fn: () => void) =>
    typeof window.requestIdleCallback === 'function' ? window.requestIdleCallback(fn, { timeout: 2000 }) : setTimeout(fn, 1200);

  if (stage) {
    whenIdle(() => {
      const hero = stage.closest('section') ?? stage;
      const target = { x: 0, y: 0 };
      const eased = { x: 0, y: 0 };
      let frame = 0;
      let last = 0;
      const clamp = (n: number) => Math.max(-1, Math.min(1, n));

      const step = (now: number) => {
        const dt = last ? Math.min(64, now - last) : 16;
        last = now;
        const k = 1 - Math.exp(-dt / 140);
        eased.x += (target.x - eased.x) * k;
        eased.y += (target.y - eased.y) * k;
        stage.style.setProperty('--tx', eased.x.toFixed(4));
        stage.style.setProperty('--ty', eased.y.toFixed(4));
        const settled = Math.abs(target.x - eased.x) < 0.001 && Math.abs(target.y - eased.y) < 0.001;
        frame = settled ? 0 : requestAnimationFrame(step);
        if (settled) last = 0;
      };
      const kick = () => {
        if (!frame) frame = requestAnimationFrame(step);
      };

      hero.addEventListener(
        'pointermove',
        (e) => {
          if (e.pointerType !== 'mouse' || !desktop.matches || reduce.matches) return;
          const r = stage.getBoundingClientRect();
          target.x = clamp((e.clientX - (r.left + r.width / 2)) / (r.width / 2));
          target.y = clamp((e.clientY - (r.top + r.height / 2)) / (r.height / 2));
          kick();
        },
        { passive: true },
      );
      hero.addEventListener('pointerleave', () => {
        target.x = target.y = 0;
        kick();
      });
      const reset = () => {
        if (desktop.matches && !reduce.matches) return;
        if (frame) cancelAnimationFrame(frame);
        frame = last = 0;
        target.x = target.y = eased.x = eased.y = 0;
        stage.style.removeProperty('--tx');
        stage.style.removeProperty('--ty');
      };
      reduce.addEventListener('change', reset);
      desktop.addEventListener('change', reset);
    });
  }
</script>

<style>
  .stage-wrap {
    position: relative;
    container: stage / inline-size;
    min-width: 0;
    /* Kemiringan kursor: perspektif di pembungkus, rotasi di pelat. */
    perspective: 1600px;
  }

  .stage {
    --tx: 0;
    --ty: 0;
    position: relative;
    display: flex;
    flex-direction: column;
    min-width: 0;
    margin: 0;
    transform: rotateX(calc(var(--ty) * var(--hero-tilt) * -1)) rotateY(calc(var(--tx) * var(--hero-tilt)));
    view-timeline: --stage block;
  }

  /* Bingkai ganda ala pelat buku: garis kedua di dalam tepi pelat. */
  .stage::after {
    content: '';
    position: absolute;
    inset: var(--space-2);
    z-index: 3;
    border: var(--border-hair) solid var(--plate-rule-strong);
    pointer-events: none;
  }

  .stage__field {
    position: relative;
    overflow: hidden;
    aspect-ratio: 600 / 760;
  }

  /* Lapisan 1a: kisi waktu × harga (lebih besar dari bidang agar geseran tidak membuka tepi). */
  .stage__field::before {
    content: '';
    position: absolute;
    inset: calc(-4 * var(--grid-cell));
    background-image:
      linear-gradient(to right, var(--plate-grid) var(--stroke-hair), transparent var(--stroke-hair)),
      linear-gradient(to bottom, var(--plate-grid) var(--stroke-hair), transparent var(--stroke-hair));
    background-size: var(--grid-cell) var(--grid-cell);
    transform: translate3d(calc(var(--tx) * var(--hero-pointer) * -0.3), calc(var(--ty) * var(--hero-pointer) * -0.3), 0);
  }

  /* Kilau: pita cahaya tipis yang menyapu seluruh pelat. Tak terlihat tanpa animasi (keadaan diam = pelat polos). */
  .stage__sheen {
    position: absolute;
    inset: 0;
    z-index: 2;
    background: linear-gradient(105deg, transparent 38%, var(--hero-sheen) 50%, transparent 62%) 120% 0 / 250% 100% no-repeat;
    opacity: 0;
    pointer-events: none;
  }

  .stage__spiral {
    position: absolute;
    opacity: 0.55;
    transform: translate3d(calc(var(--tx) * var(--hero-pointer) * -0.3), calc(var(--ty) * var(--hero-pointer) * -0.3), 0);
  }

  .stage__spiral--wide {
    display: none;
  }

  .stage__svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    transform: translate3d(calc(var(--tx) * var(--hero-pointer) * -1), calc(var(--ty) * var(--hero-pointer) * -1), 0);
  }

  .stage__svg--wide {
    display: none;
  }

  .stage__svg :global(*) {
    vector-effect: non-scaling-stroke;
  }

  .stage__path {
    fill: none;
    stroke: var(--plate-ink-3);
    stroke-width: var(--stroke-hair);
    stroke-opacity: 0.42;
    stroke-linejoin: round;
  }

  .stage__past {
    fill: none;
    stroke: var(--plate-ink);
    stroke-width: var(--stroke-trace-bold);
    stroke-linejoin: round;
  }

  .stage__envelope {
    fill: none;
    stroke: var(--plate-rule-strong);
    stroke-width: var(--stroke-hair);
    stroke-dasharray: var(--dash-trace);
  }

  .stage__density-curve {
    fill: none;
    stroke: var(--plate-ink-2);
    stroke-width: var(--stroke-trace);
  }

  .stage__expected {
    fill: none;
    stroke: var(--plate-mark);
    stroke-width: var(--stroke-trace-bold);
  }

  .stage__now {
    fill: var(--plate);
    stroke: var(--plate-mark);
    stroke-width: var(--stroke-trace);
  }

  .stage__now-guide {
    stroke: var(--plate-mark);
    stroke-opacity: 0.7;
  }

  .stage__cut {
    fill: none;
    stroke: var(--plate-rule-strong);
    stroke-width: var(--stroke-hair);
  }

  /* Label grafik = gaya caption Fig./Objek (italic small caps). Latar pelat di belakang huruf (stroke warna
     pelat, dilukis di bawah isi) memutus garis yang lewat, jadi label tidak pernah tertimpa garis.
     Ukuran dalam satuan viewBox: ±13–15px pada lebar pelat biasa. */
  .stage__labels {
    fill: var(--plate-ink-3);
    font-family: var(--font-label);
    font-style: italic;
    font-variant-caps: small-caps;
    letter-spacing: 0.02em;
    paint-order: stroke;
    stroke: var(--plate);
    stroke-width: 5px;
    stroke-linejoin: round;
  }

  .stage__labels--wide {
    font-size: 21px;
  }

  .stage__labels--compact {
    font-size: 23px;
  }

  .stage__label-mark {
    fill: var(--plate-mark);
  }

  /* Emblem: diposisikan dalam persen bidang agar sejajar dengan medan. */
  .stage__art {
    position: absolute;
    inset: 0 0 auto;
    height: calc(500 / 760 * 100%);
    overflow: hidden;
    pointer-events: none;
  }

  /* `transform` membuat grup terisolasi, jadi blend `screen` dipasang di grup ini (bukan hanya di <img>). */
  .stage__art-inner {
    position: absolute;
    left: calc(-200 / 600 * 100%);
    top: calc(-10 / 500 * 100%);
    width: calc(700 / 600 * 100%);
    mix-blend-mode: screen;
    transform: translate3d(calc(var(--tx) * var(--hero-pointer) * -0.6), calc(var(--ty) * var(--hero-pointer) * -0.6), 0);
  }

  .stage__caption {
    display: grid;
    gap: var(--space-2);
    padding: var(--space-4) var(--space-6) var(--space-8);
    border-top: var(--border-hair) solid var(--plate-rule);
  }

  .stage__caption p {
    margin: 0;
  }

  .stage__text {
    max-width: var(--measure-narrow);
    font-size: var(--text-sm);
    color: var(--plate-ink-2);
  }

  /* Benang merah: garis kuningan dari "Sekarang" (x0) keluar pelat sampai judul bagian berikutnya.
     Di luar alur tata letak (absolut di bawah pelat); panjangnya diatur wadah (HomeLanding) lewat
     --stage-thread-length = jarak dari tepi bawah pelat ke garis judul bagian berikutnya. */
  .stage__thread {
    position: absolute;
    top: 100%;
    left: calc(368 / 600 * 100% - 0.375rem);
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 0.75rem;
    height: var(--stage-thread-length, var(--space-16));
    color: var(--ink-2);
    transform-origin: top center;
  }

  .stage__thread-line {
    flex: 1;
    width: var(--stroke-hair);
    background: var(--brass);
  }

  .stage__thread :global(.glyph-hourglass) {
    margin-top: var(--space-1);
  }

  @container stage (min-width: 34rem) {
    .stage__field {
      aspect-ratio: 1000 / 720;
    }

    .stage__svg--wide,
    .stage__spiral--wide {
      display: block;
    }

    .stage__svg--compact,
    .stage__spiral--compact {
      display: none;
    }

    .stage__art {
      height: 100%;
    }

    .stage__art-inner {
      left: var(--art-wide-left);
      top: var(--art-wide-top);
      width: var(--art-wide-width);
    }

    .stage__caption {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: baseline;
      gap: var(--space-2) var(--space-6);
      padding: var(--space-4) var(--space-8) var(--space-8);
    }

    .stage__text {
      grid-column: 1 / -1;
      grid-row: 2;
    }

    .stage__thread {
      left: calc(684 / 1000 * 100% - 0.375rem);
    }
  }

  /* ---------- Momen hero: scroll-driven (keadaan diam di atas = keadaan akhir) ---------- */
  @keyframes stage-draw {
    from {
      stroke-dashoffset: var(--draw-from, 0.85);
    }
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes stage-shift {
    from {
      translate: 0 calc(var(--shift) * -1);
    }
    to {
      translate: 0 var(--shift);
    }
  }

  /* Desktop: mulai dari nol (komposisi tepat saat halaman dibuka). */
  @keyframes stage-shift-down {
    from {
      translate: 0 0;
    }
    to {
      translate: 0 var(--shift);
    }
  }

  @keyframes stage-sheen {
    0% {
      opacity: 0;
      background-position: 120% 0;
    }
    25%,
    75% {
      opacity: 1;
    }
    100% {
      opacity: 0;
      background-position: -20% 0;
    }
  }

  @keyframes thread-draw {
    from {
      transform: scaleY(0);
    }
    to {
      transform: scaleY(1);
    }
  }

  /* Garis waktu: mobile/tablet memakai view timeline pelat (pelat masuk dari bawah, di bawah teks hero);
     desktop memakai gulir halaman dari atas (pelat sudah terlihat penuh saat halaman dibuka, jadi gerak dimulai
     dari keadaan awal yang tenang: cabang & spiral baru sebagian, paralaks nol). */
  /* Longhand sengaja (bukan `animation:`): minifier menggabungkan shorthand + animation-timeline menjadi satu
     shorthand yang ditolak Chrome, sehingga animasinya hilang. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      /* Garis tergambar: cabang dari jam pasir ke kanan (awal path); spiral dari matanya di jam pasir ke luar
         (akhir path, jadi offset negatif). */
      .stage__draw,
      .stage__spiral :global(.golden-spiral__curve) {
        stroke-dasharray: 1;
        animation-name: stage-draw;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: --stage;
        animation-range: entry 40% cover 50%;
      }

      .stage__spiral :global(.golden-spiral__curve) {
        --draw-from: -0.8;
      }

      /* Paralaks gulir: lapisan jauh tertinggal, lapisan depan mendahului. */
      .stage__field::before,
      .stage__spiral,
      .stage__art-inner,
      .stage__svg {
        animation-name: stage-shift;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: --stage;
        animation-range: cover 0% cover 100%;
      }

      .stage__field::before,
