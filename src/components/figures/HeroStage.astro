---
// Panggung hero (R9.3): medan risiko abstrak — WAKTU × HARGA × KETIDAKPASTIAN — di bidang gelap.
// Tanpa figur, tanpa jam pasir, tanpa simbol dekoratif: geometri sendiri yang bercerita.
//   masa lalu  = satu jalur yang sudah terjadi, di lantai, berakhir di "sekarang";
//   masa depan = relief kepadatan probabilitas yang MELEBAR menuju horizon T (σ ∝ √t), jalur-jalur bercabang
//                menempel di permukaannya, satu lintasan kuningan = nilai harapan E[P].
// Isi: figures/RiskField (three.js, dimuat malas; kualitas high/medium/low dari lib/risk-field/quality.ts;
// low = figur SVG teknis TimePriceFigure). Di sini hanya warna: --field-* dipetakan ke tinta pelat, jadi
// relief berupa garis grafit terang di atas bidang gelap dan kuningan tetap satu-satunya aksen.
// Gerak (di RiskField/scene.ts, mati di bawah prefers-reduced-motion → SVG diam): drift kamera sangat pelan,
// napas medan, penanda kuningan kecil di lintasan E[P], paralaks gulir (dan penunjuk di desktop).
import RiskField from './RiskField.astro';
---

<figure class="stage plate" aria-labelledby="stage-caption">
  <div class="stage__field">
    <RiskField number="00" caption={false} />
  </div>

  <figcaption id="stage-caption" class="stage__caption">
    <p class="label">
      <span class="label__index">Fig. 00</span><span class="label__sep" aria-hidden="true">·</span>Medan risiko<span class="label__sep" aria-hidden="true">·</span>Waktu × harga × ketidakpastian
    </p>
    <p class="stage__text">
      Masa lalu hanya satu jalur. Setelah “sekarang”, kemungkinan bercabang dan medan kepadatannya melebar
      menuju horizon T. Garis kuningan adalah nilai harapan. Ilustrasi konsep, bukan data pasar.
    </p>
  </figcaption>
</figure>

<style>
  .stage {
    /* Warna medan di bidang gelap: grafit terang untuk relief, kuningan hanya untuk E[P]. */
    --field-grid: var(--plate-rule);
    --field-line-faint: var(--plate-rule-strong);
    --field-line: var(--plate-ink-3);
    --field-axis: var(--plate-rule-strong);
    --field-trace: var(--plate-ink);
    --field-highlight: var(--plate-mark);
    --field-fill: var(--plate-rule);
    /* Figur SVG cadangan (kualitas low) memakai --paper / --mark-soft: petakan ke bidang gelap. */
    --paper: var(--plate);
    --mark-soft: var(--plate-rule);
    min-width: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    border-inline: 0;
  }

  /* Bidang: kisi teknis gelap yang sangat samar di belakang medan; ruang kosong di sekelilingnya disengaja. */
  .stage__field {
    padding: var(--space-6) var(--gutter) var(--space-4);
    background-image:
      linear-gradient(to right, var(--plate-grid) var(--stroke-hair), transparent var(--stroke-hair)),
      linear-gradient(to bottom, var(--plate-grid) var(--stroke-hair), transparent var(--stroke-hair));
    background-size: var(--grid-cell) var(--grid-cell);
  }

  .stage__caption {
    display: grid;
    gap: var(--space-2);
    padding: var(--space-4) var(--gutter) var(--space-6);
    border-top: var(--border-hair) solid var(--plate-rule);
  }

  .stage__caption p {
    margin: 0;
  }

  .stage__text {
    max-width: var(--measure-narrow);
    font-size: var(--text-sm);
    color: var(--plate-ink-2);
  }

  @media (min-width: 64rem) {
    .stage__field {
      padding: var(--space-12) var(--space-12) var(--space-8);
    }

    .stage__caption {
      padding: var(--space-4) var(--space-6) var(--space-6);
    }
  }
</style>
