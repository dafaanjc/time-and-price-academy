---
// Motif teknis kategori: gambar isometrik kecil (SVG inline, dekoratif — judul kategori selalu
// tertulis di sebelahnya). Proyeksi dari src/lib/iso.ts (t → kanan-bawah, p → atas, d → kiri-bawah).
// Nama motif dari `motif` di src/data/categories.ts. Motif baru = satu cabang di `draw()` + nilai di
// `categoryMotifs`. Maksimal satu penanda kuningan (.svg-mark) per motif.
// Setiap motif digambar di ruang 3D lalu diskalakan agar pas ke kanvas 160×104 yang sama.
import type { CategoryMotif } from '../../data/categories';
import { isoPath, project, steps } from '../../lib/iso';

interface Props {
  motif: CategoryMotif;
}

const { motif } = Astro.props;

const U = 10;
type P3 = [number, number, number?]; // [t, p, d]
const path = (pts: P3[], close = false) => isoPath(pts.map(([t, p, d = 0]) => ({ t, p, d })), U, close);
const at = ([t, p, d = 0]: P3) => project({ t, p, d }, U);

/** Kisi lantai (p = 0): garis sejajar sumbu waktu dan sumbu kepadatan. */
const floor = (tMax: number, dMax: number, step = 2) =>
  [
    ...steps(0, tMax, tMax / step).map((t) => path([[t, 0, 0], [t, 0, dMax]])),
    ...steps(0, dMax, dMax / step).map((d) => path([[0, 0, d], [tMax, 0, d]])),
  ].join(' ');

const curve = (from: number, to: number, n: number, fn: (t: number) => number, d = 0) =>
  steps(from, to, n).map((t): P3 => [t, fn(t), d]);

interface Drawing {
  grid: string;
  axes: string;
  ticks?: string;
  guides?: string;
  traces: string[];
  alt?: string[];
  /** Penanda kuningan (satu). */
  mark: { at: P3; shape: 'dot' | 'square' };
  /** Lingkaran simpul (pohon keputusan). */
  nodes?: P3[];
}

const timePriceAxes = () => `${path([[0, 0], [10.4, 0]])} ${path([[0, 0], [0, 7.4]])}`;

function draw(): Drawing {
  switch (motif) {
    case 'axes': {
      // Distribusi normal berdiri di dinding waktu × harga; salinan di belakang memberi kedalaman.
      const bell = (d: number) => curve(0.5, 9.5, 48, (t) => 6.2 * Math.exp(-((t - 5) ** 2) / (2 * 1.7 ** 2)), d);
      return {
        grid: floor(10, 6),
        axes: timePriceAxes(),
        guides: [path([[5, 0, 0], [5, 6.2, 0]]), path([[5, 6.2, 0], [5, 6.2, 4]]), path([[5, 0, 0], [5, 0, 4]])].join(' '),
        traces: [path(bell(0))],
        alt: [path(bell(4))],
        mark: { at: [5, 0, 0], shape: 'dot' },
      };
    }
    case 'band': {
      // Jejak harga di dalam dua batas (bidang tipis); batas rugi di bawah sebagai garis putus.
      const trace: P3[] = [[0, 3.8], [1, 4.4], [2, 3.4], [3, 4.6], [4, 3.9], [5, 5], [6, 4.1], [7, 4.5], [8, 3.6], [9, 4.3], [10, 4]];
      const plane = (p: number) => path([[0, p, 0], [10, p, 0], [10, p, 3], [0, p, 3]], true);
      return {
        grid: floor(10, 3),
        axes: timePriceAxes(),
        guides: plane(6.4),
        traces: [path(trace)],
        alt: [path([[0, 1.6, 0], [10, 1.6, 0]]), path([[0, 1.6, 3], [10, 1.6, 3]])],
        mark: { at: [0, 1.6, 0], shape: 'square' },
      };
    }
    case 'oscillation': {
      // Tenang, lalu satu kejatuhan di t = 3,5: ayunan melebar. Dua jejak sejajar memberi kedalaman.
      const y = (t: number) => 3.6 + Math.sin(t * 2.2) * (t < 3.5 ? 0.3 : Math.min(2.6, 0.3 + (t - 3.5) * 0.55));
      return {
        grid: floor(10, 4),
        axes: timePriceAxes(),
        guides: [path([[0, 3.6, 0], [10, 3.6, 0]]), path([[3.5, 0, 0], [3.5, 6.6, 0]])].join(' '),
        traces: [path(curve(0, 10, 90, y, 0))],
        alt: [path(curve(0, 10, 90, y, 3.4))],
        mark: { at: [3.5, y(3.5), 0], shape: 'dot' },
      };
    }
    case 'kink': {
      // Fungsi nilai: cekung untuk untung, lebih curam untuk rugi, patah di titik acuan (5; 3,5).
      const v = (t: number) => {
        const x = t - 5;
        return 3.5 + (x >= 0 ? 3 * (1 - Math.exp(-x / 2.6)) : -4.4 * (1 - Math.exp(x / 1.8)));
      };
      const rungs = [1.5, 3, 4.5, 6, 7.5, 9].map((t) => path([[t, v(t), 0], [t, v(t), 3]]));
      return {
        grid: floor(10, 3),
        axes: `${path([[0, 3.5], [10.4, 3.5]])} ${path([[5, 0], [5, 7.4]])}`,
        guides: rungs.join(' '),
        traces: [path(curve(0.6, 9.6, 60, v, 0))],
        alt: [path(curve(0.6, 9.6, 60, v, 3))],
        mark: { at: [5, 3.5, 0], shape: 'dot' },
      };
    }
    case 'tree': {
      // Pohon keputusan di lantai (p = 0); tiang setinggi hasil berdiri di tiap daun.
      const root: P3 = [0.6, 0, 2.5];
      const a: P3 = [3.6, 0, 1];
      const b: P3 = [3.6, 0, 4];
      const leaves: [P3, number][] = [
        [[7, 0, 0], 4.6],
        [[7, 0, 2], 1.6],
        [[7, 0, 3], 3.4],
        [[7, 0, 5], 2.4],
      ];
      const edges: [P3, P3][] = [
        [root, a],
        [root, b],
        [a, leaves[0]![0]],
        [a, leaves[1]![0]],
        [b, leaves[2]![0]],
        [b, leaves[3]![0]],
      ];
      return {
        grid: floor(8, 6),
        axes: '',
        guides: leaves.map(([l, h]) => path([l, [l[0], h, l[2]]])).join(' '),
        traces: edges.map(([from, to]) => path([from, to])),
        ticks: leaves.map(([l, h]) => path([[l[0] - 0.35, h, l[2]], [l[0] + 0.35, h, l[2]]])).join(' '),
        nodes: [a, b],
        mark: { at: root, shape: 'square' },
      };
    }
  }
}

const g = draw();

// Kotak batas seluruh gambar → skala & geser agar pas ke kanvas (garis tetap tipis: lihat CSS).
const numbers =
  [g.grid, g.axes, g.ticks ?? '', g.guides ?? '', ...g.traces, ...(g.alt ?? [])]
    .join(' ')
    .match(/-?\d+(?:\.\d+)?/g)
    ?.map(Number) ?? [];
const points: [number, number][] = [];
for (let i = 0; i + 1 < numbers.length; i += 2) points.push([numbers[i]!, numbers[i + 1]!]);
for (const n of g.nodes ?? []) points.push(at(n));
const xs = points.map(([x]) => x);
const ys = points.map(([, y]) => y);
const [minX, maxX, minY, maxY] = [Math.min(...xs), Math.max(...xs), Math.min(...ys), Math.max(...ys)];
const W = 160;
const H = 104;
const PAD = 8;
const scale = Math.min((W - 2 * PAD) / (maxX - minX), (H - 2 * PAD) / (maxY - minY));
const tx = Math.round((W - (maxX - minX) * scale) / 2 - minX * scale);
const ty = Math.round((H - (maxY - minY) * scale) / 2 - minY * scale);
const [mx, my] = at(g.mark.at);
---

<svg class="motif" viewBox={`0 0 ${W} ${H}`} aria-hidden="true" focusable="false">
  <g transform={`translate(${tx} ${ty}) scale(${scale.toFixed(3)})`}>
    <path class="svg-grid" d={g.grid}></path>
    {g.axes && <path class="svg-axis" d={g.axes}></path>}
    {g.ticks && <path class="svg-tick" d={g.ticks}></path>}
    {g.guides && <path class="svg-guide" d={g.guides}></path>}
    {g.alt?.map((d) => <path class="svg-trace svg-trace--alt" d={d}></path>)}
    {g.traces.map((d) => <path class="svg-trace" d={d}></path>)}
    {g.nodes?.map((n) => <circle class="motif__node" cx={at(n)[0]} cy={at(n)[1]} r="4"></circle>)}
    {
      g.mark.shape === 'dot' ? (
        <circle class="svg-mark" cx={mx} cy={my} r="3.5"></circle>
      ) : (
        <rect class="svg-mark" x={mx - 3.5} y={my - 3.5} width="7" height="7"></rect>
      )
    }
  </g>
</svg>

<style>
  .motif {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  /* Tebal garis tetap dalam px layar, tidak ikut skala gambar. */
  .motif :global(path),
  .motif :global(circle),
  .motif :global(rect) {
    vector-effect: non-scaling-stroke;
  }

  .motif__node {
    fill: var(--surface);
    stroke: var(--axis);
    stroke-width: var(--stroke-axis);
  }

  .motif :global(.svg-mark) {
    transition:
      fill var(--motion-base) var(--ease),
      stroke var(--motion-base) var(--ease);
  }
</style>
