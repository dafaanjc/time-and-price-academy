---
// Objek ukiran per kategori (Tahap 4 redesign, docs/redesign-brief.md): gambar garis bergaya etsa — garis rambut
// tinta, arsiran 45° untuk sisi bayangan, satu aksen kuningan per objek, berdiri di satu garis dasar.
// Sumber pilihan objek: `object` di src/data/categories.ts. Kanvas 120×120. Dekoratif (aria-hidden): nama
// kategori selalu tertulis di sebelahnya. Warna dari token (tinta, --brass, --surface), tanpa warna di markup.
import type { CategoryObject } from '../../data/categories';

interface Props {
  object: CategoryObject;
}

const { object } = Astro.props;
// Satu objek per kategori per halaman, jadi id pola arsiran cukup unik per objek.
const hatch = `hatch-${object}`;
const fillHatch = `url(#${hatch})`;

// Dadu isometrik (Fondasi): sudut-sudut kubus dan titik mata dadu pada tiap sisi.
const die = { top: 'M45 50 L70 62 L45 74 L20 62 Z', left: 'M20 62 L45 74 L45 102 L20 90 Z', right: 'M45 74 L70 62 L70 90 L45 102 Z' };
const facePoint = (o: [number, number], u: [number, number], a: number, b: number): [number, number] => [
  o[0] + u[0] * a,
  o[1] + u[1] * a + 28 * b,
];
const leftPips = [facePoint([20, 62], [25, 12], 0.3, 0.3), facePoint([20, 62], [25, 12], 0.7, 0.7)];
const rightPips = [0.25, 0.5, 0.75].map((t) => facePoint([45, 74], [25, -12], t, t));

// Koin (Keuangan Perilaku): manik-manik di tepi.
const beads = Array.from({ length: 28 }, (_, i) => {
  const a = (i / 28) * Math.PI * 2;
  return [44 + 27.2 * Math.cos(a), 58 + 27.2 * Math.sin(a)] as const;
});
const stack = [92, 86, 80];

// Kepala patung (Psikologi): ikal rambut sebagai busur pendek.
const curls = [
  [36, 54], [34, 64], [38, 44], [45, 36], [53, 30], [62, 27], [71, 28], [44, 50], [52, 42], [60, 36], [69, 35], [42, 60], [50, 52],
];
---

<svg class={`object object--${object}`} viewBox="0 0 120 120" aria-hidden="true" focusable="false">
  <defs>
    <pattern id={hatch} width="3" height="3" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
      <line class="object__hatch-line" x1="0" y1="0" x2="0" y2="3"></line>
    </pattern>
  </defs>

  {
    object === 'dice-hourglass' && (
      <g>
        <path class="object__ground" d="M12 106 H110"></path>
        <g class="object__hourglass">
          <path class="object__paper" d="M80 22 C80 44 89 52 90 59 C89 66 80 74 80 96 H100 C100 74 91 66 90 59 C91 52 100 44 100 22 Z"></path>
          <path class="object__brass-fill" d="M84 32 H96 C95 40 92 44 90 46 C88 44 85 40 84 32 Z M81.5 95 C82.5 86 87 81 90 80 C93 81 97.5 86 98.5 95 Z"></path>
          <path class="object__line" d="M90 46 V80"></path>
          <path class="object__line" d="M80 22 C80 44 89 52 90 59 C89 66 80 74 80 96 M100 22 C100 44 91 52 90 59 C91 66 100 74 100 96"></path>
          <path class="object__line" d="M77 22 V96 M103 22 V96"></path>
          <rect class="object__hatched" fill={fillHatch} x="74" y="17" width="32" height="5"></rect>
          <rect class="object__hatched" fill={fillHatch} x="74" y="96" width="32" height="5"></rect>
        </g>
        <g class="object__die">
          <path class="object__paper" d={die.top}></path>
          <path class="object__paper" d={die.left}></path>
          <path class="object__hatched" fill={fillHatch} d={die.right}></path>
          <ellipse class="object__pip" cx="45" cy="62" rx="3.2" ry="1.8"></ellipse>
          {leftPips.map(([x, y]) => <circle class="object__pip" cx={x} cy={y} r="2.2" />)}
          {rightPips.map(([x, y]) => <circle class="object__pip object__pip--paper" cx={x} cy={y} r="2.2" />)}
        </g>
      </g>
    )
  }

  {
    object === 'scales' && (
      <g>
        <path class="object__ground" d="M30 110 H90"></path>
        <path class="object__hatched" fill={fillHatch} d="M44 110 H76 L70 102 H50 Z"></path>
        <path class="object__paper" d="M58 34 H62 V102 H58 Z"></path>
        <path class="object__hatched" fill={fillHatch} d="M60.5 34 H62 V102 H60.5 Z"></path>
        <path class="object__paper" d="M16 30.5 H104 V34 H16 Z"></path>
        <path class="object__line" d="M22 34 L11 72 M22 34 L33 72 M98 34 L87 72 M98 34 L109 72"></path>
        <path class="object__paper" d="M8 72 H36 Q35 82 22 83 Q9 82 8 72 Z"></path>
        <path class="object__hatched" fill={fillHatch} d="M9.5 76 H34.5 Q31 82 22 83 Q13 82 9.5 76 Z"></path>
        <path class="object__paper" d="M84 72 H112 Q111 82 98 83 Q85 82 84 72 Z"></path>
        <path class="object__hatched" fill={fillHatch} d="M85.5 76 H110.5 Q107 82 98 83 Q89 82 85.5 76 Z"></path>
        <path class="object__brass-line" d="M60 30.5 V13"></path>
        <circle class="object__brass-ring" cx="60" cy="32.2" r="2.8"></circle>
      </g>
    )
  }

  {
    object === 'bust' && (
      <g>
        <path class="object__ground" d="M22 118 H102"></path>
        <rect class="object__paper" x="46" y="112" width="36" height="6"></rect>
        <rect class="object__hatched" fill={fillHatch} x="72" y="112" width="10" height="6"></rect>
        <rect class="object__paper" x="38" y="106" width="52" height="6"></rect>
        <path class="object__brass-line" d="M38 106 H90"></path>
        <path
          class="object__paper"
          d="M44 92 C34 86 28 72 29 58 C30 40 42 26 58 24 C70 22 80 28 83 38 C84 42 84 44 85 46 L90 55 L87 57 C87 59 86 60 86 61 L88 63 L86 65 L87 67 C86 70 84 71 84 72 C85 76 83 79 79 80 C74 81 70 80 68 82 L67 92 C70 98 80 100 88 104 V106 H34 C34 100 40 96 44 92 Z"
        ></path>
        <path class="object__hatched" fill={fillHatch} d="M44 92 C40 84 36 74 36 64 L47 70 L52 94 C48 97 40 100 36 106 H34 C34 100 40 96 44 92 Z"></path>
        <path class="object__hatched" fill={fillHatch} d="M68 82 L67 92 C70 98 76 100 80 101 L74 86 Z"></path>
        {curls.map(([x, y]) => <path class="object__fine" d={`M${x} ${y} c2.5 -3.5 7 -3 7 1.5 c0 2 -2 3 -3.5 2`} />)}
        <path class="object__fine" d="M52 60 c4 -4 9 0 7 5 c-1 3 -4 3 -5 5.5"></path>
        <path class="object__fine" d="M75 46 q3.2 -2 6.4 0.3 M74 41.5 q5 -3 10 0"></path>
      </g>
    )
  }

  {
    object === 'coin' && (
      <g>
        <path class="object__ground" d="M10 104 H112"></path>
        {stack.map((y) => (
          <g>
            <path class="object__hatched" fill={fillHatch} d={`M60 ${y} V${y + 5} A22 7 0 0 0 104 ${y + 5} V${y} Z`}></path>
            <path class="object__line" d={`M60 ${y} V${y + 5} A22 7 0 0 0 104 ${y + 5} V${y}`}></path>
            <ellipse class="object__paper" cx="82" cy={y} rx="22" ry="7"></ellipse>
          </g>
        ))}
        <circle class="object__paper" cx="44" cy="58" r="30"></circle>
        <path class="object__hatched" fill={fillHatch} d="M44 88 A30 30 0 0 0 74 58 A26 26 0 0 1 44 84 A26 26 0 0 1 18 62 A30 30 0 0 0 44 88 Z"></path>
        <circle class="object__brass-ring object__brass-ring--wide" cx="44" cy="58" r="30"></circle>
        <circle class="object__line" cx="44" cy="58" r="24.5"></circle>
        {beads.map(([x, y]) => <circle class="object__bead" cx={x.toFixed(2)} cy={y.toFixed(2)} r="0.8" />)}
        <text class="object__numeral" x="44" y="67" text-anchor="middle">1</text>
        <path class="object__fine" d="M33 71 H55"></path>
      </g>
    )
  }

  {
    object === 'dividers' && (
      <g>
        <path class="object__ground" d="M14 106 H104"></path>
        <path class="object__arc" d="M68.4 42.5 A24 24 0 0 1 51.8 42.6"></path>
        <rect class="object__paper" x="57" y="4" width="6" height="12"></rect>
        <path class="object__fine" d="M57 7 H63 M57 10 H63 M57 13 H63"></path>
        <path class="object__hatched" fill={fillHatch} d="M55.5 23 L61.5 25.5 L31 102 L29 101 Z"></path>
        <path class="object__line" d="M55.5 23 L61.5 25.5 L31 102 L29 101 Z"></path>
        <path class="object__paper" d="M58.5 25.5 L64.5 23 L90 94 L86 95.5 Z"></path>
        <path class="object__hatched" fill={fillHatch} d="M86 95.5 L90 94 L89 102 Z"></path>
        <path class="object__line" d="M86 95.5 L90 94 L89 102 Z"></path>
        <circle class="object__paper" cx="60" cy="20" r="5.5"></circle>
        <circle class="object__brass-ring object__brass-ring--wide" cx="60" cy="20" r="5.5"></circle>
        <circle class="object__pip" cx="60" cy="20" r="1.2"></circle>
      </g>
    )
  }
</svg>

<style>
  .object {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
    color: var(--ink);
  }

  .object * {
    vector-effect: non-scaling-stroke;
  }

  .object__hatch-line {
    stroke: currentColor;
    stroke-width: 0.7;
    vector-effect: none;
  }

  .object__line,
  .object__paper,
  .object__hatched,
  .object__fine,
  .object__ground,
  .object__arc,
  .object__pip {
    stroke: currentColor;
    stroke-width: 1px;
    stroke-linejoin: round;
    stroke-linecap: round;
  }

  .object__line,
  .object__fine,
  .object__ground,
  .object__arc {
    fill: none;
  }

  .object__paper,
  .object__pip--paper {
    fill: var(--surface);
  }

  .object__fine {
    stroke-width: 0.75px;
  }

  .object__ground {
    stroke: var(--rule-strong);
  }

  .object__arc {
    stroke: var(--rule-strong);
    stroke-dasharray: var(--dash-guide);
  }

  .object__pip {
    fill: currentColor;
  }

  .object__bead {
    fill: currentColor;
  }

  .object__numeral {
    fill: currentColor;
    font-family: var(--font-display);
    font-size: 26px;
  }

  /* Satu aksen kuningan per objek. */
  .object__brass-fill {
    fill: var(--sand);
    stroke: var(--brass);
    stroke-width: 1px;
  }

  .object__brass-line {
    fill: none;
    stroke: var(--brass);
    stroke-width: 1.5px;
    stroke-linecap: round;
  }

  .object__brass-ring {
    fill: none;
    stroke: var(--brass);
    stroke-width: 1.5px;
  }

  .object__brass-ring--wide {
    stroke-width: 2px;
  }
</style>

