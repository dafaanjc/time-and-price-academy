---
import ConceptNav from './ConceptNav.astro';
---

<aside class="sidebar">
  <ConceptNav />
</aside>

<style>
  .sidebar {
    display: none;
  }

  @media (min-width: 64rem) {
    .sidebar {
      display: block;
      position: sticky;
      top: var(--header-height);
      height: calc(100dvh - var(--header-height));
      overflow-y: auto;
      padding: var(--space-8) var(--space-6) var(--space-12) var(--gutter);
      border-right: var(--border-hair) solid var(--rule);
    }
  }
</style>
