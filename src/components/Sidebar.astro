---
import SiteNav from './SiteNav.astro';
---

<aside class="sidebar">
  <SiteNav />
</aside>

<style>
  .sidebar {
    display: none;
  }

  @media (min-width: 64rem) {
    .sidebar {
      display: block;
      position: sticky;
      top: var(--header-height);
      height: calc(100dvh - var(--header-height));
      overflow-y: auto;
      padding: 1.5rem 1rem 2rem;
      border-right: 1px solid var(--line);
    }
  }
</style>
