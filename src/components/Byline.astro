---
// Atribusi penulis + tombol salin tautan. Wajib di setiap halaman konsep.
import { siteConfig } from '../config/site';
import CopyLinkButton from './CopyLinkButton.astro';

interface Props {
  url?: string;
}

const { url } = Astro.props;
---

<div class="byline">
  <p class="byline__text">{siteConfig.attribution}</p>
  <CopyLinkButton url={url} />
</div>

<style>
  .byline {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding-block: 0.875rem;
    border-block: 1px solid var(--line);
  }

  .byline__text {
    margin: 0;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--ink-soft);
  }
</style>
