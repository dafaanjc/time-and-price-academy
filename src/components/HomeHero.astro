---
// Hero beranda — arah R9 "Jam Pasir Modal".
// Kiri (dinding terang): judul besar kalimat biasa, pertanyaan inti ("apa yang terjadi saat keputusan Anda salah?"),
// dan pintu masuk. Kanan: SATU pelat gelap berisi dua objek — emblem resmi (Objek 00, versi hitam, utuh; satu-satunya
// emblem di beranda) dan instrumen jam pasir modal yang bisa dioperasikan (Instrumen 00).
// Mobile: instrumen tampil di layar pertama, emblem menyusul di bawahnya di dalam pelat yang sama.
// Risk Field 3D tidak lagi dipasang di sini (lihat CLAUDE.md → "3D: Risk Field").
import { siteConfig } from '../config/site';
import BrandEmblem from './BrandEmblem.astro';
import CapitalHourglass from './figures/CapitalHourglass.astro';
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero__text">
    <p class="label">
      {siteConfig.masterBrand}<span class="label__sep" aria-hidden="true">·</span>{siteConfig.product}
    </p>
    <h1 id="hero-title" class="hero__title">{siteConfig.heroLine}</h1>
    <p class="hero__question">Pertanyaan yang lebih penting: apa yang terjadi saat keputusan Anda salah?</p>
    <p class="hero__lead">
      Setiap posisi punya jam pasirnya sendiri. Seberapa cepat modal habis ditentukan sebelum entry, oleh
      risiko per transaksi. Mulai dari masalah yang Anda alami, lalu pahami konsep di baliknya.
    </p>
    <p class="hero__actions">
      <a class="button" href="#masalah">Mulai dari masalah</a>
      <a class="hero__secondary" href="#sistem">Lihat sistem belajar →</a>
    </p>
  </div>

  <div class="hero__plate plate">
    <div class="hero__instrument">
      <CapitalHourglass />
    </div>
    <figure class="hero__object">
      <BrandEmblem variant="plate" />
      <figcaption class="label">
        <span class="label__index">Objek 00</span><span class="label__sep" aria-hidden="true">·</span>{`Emblem ${siteConfig.masterBrand}`}
      </figcaption>
    </figure>
  </div>
</section>

<style>
  .hero {
    display: grid;
    gap: var(--space-8);
    padding-block: 0 var(--space-8);
  }

  /* Judul kalimat biasa, sangat besar dan rapat: satu pernyataan, bukan slogan kapital. */
  .hero__title {
    margin: var(--space-4) 0 var(--space-4);
    font-size: clamp(var(--text-3xl), 11vw, var(--text-5xl));
    line-height: var(--leading-hero);
    letter-spacing: var(--tracking-display);
    text-wrap: balance;
  }

  .hero__question {
    max-width: 30ch;
    margin: 0;
    font-family: var(--font-serif);
    font-size: var(--text-lg);
    font-style: italic;
    line-height: var(--leading-tight);
    color: var(--ink-2);
    text-wrap: balance;
  }

  .hero__lead {
    max-width: var(--measure-narrow);
    margin: var(--space-4) 0 0;
    color: var(--ink-2);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-6);
    margin: var(--space-6) 0 0;
  }

  .button {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0 var(--space-6);
    font-weight: 600;
    color: var(--paper);
    background: var(--ink);
    border: var(--border-hair) solid var(--ink);
    border-radius: var(--radius-1);
    text-decoration: none;
    transition:
      color var(--motion-fast) var(--ease),
      background-color var(--motion-fast) var(--ease);
  }

  .button:hover {
    color: var(--ink);
    background: transparent;
  }

  .hero__secondary {
    font-weight: 600;
    color: var(--ink);
  }

  /* Pelat: tepi ke tepi di mobile (menembus gutter), bingkai di dalam grid di desktop. */
  .hero__plate {
    display: grid;
    gap: var(--space-8);
    margin-inline: calc(-1 * var(--gutter));
    padding: var(--space-6) var(--gutter) var(--space-8);
    border-inline: 0;
  }

  .hero__object {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    margin: 0;
    padding-top: var(--space-6);
    border-top: var(--border-hair) solid var(--plate-rule);
  }

  .hero__object :global(.emblem--plate) {
    width: 7.5rem;
  }

  @media (min-width: 48rem) {
    .hero__plate {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: start;
    }

    .hero__object {
      flex-direction: column;
      align-items: flex-start;
      padding-top: 0;
      border-top: 0;
    }

    .hero__object :global(.emblem--plate) {
      width: min(280px, 100%);
    }
  }

  @media (min-width: 64rem) {
    .hero {
      grid-template-columns: repeat(var(--grid-columns), minmax(0, 1fr));
      gap: var(--grid-gap);
      align-items: center;
      padding-block: var(--space-4) var(--space-16);
    }

    .hero__text {
      grid-column: 1 / span 5;
    }

    .hero__title {
      font-size: clamp(var(--text-4xl), 5vw, var(--text-6xl));
    }

    .hero__question {
      font-size: var(--text-xl);
    }

    .hero__plate {
      grid-column: 6 / -1;
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      gap: var(--space-8);
      margin-inline: 0;
      padding: var(--space-8);
      border-inline: var(--border-hair) solid var(--plate-rule);
    }

    /* Desktop: emblem (asal-usul) di kiri, instrumen (alat kerja) di kanan. */
    .hero__object {
      order: -1;
      align-self: center;
      gap: var(--space-4);
    }

    .hero__object :global(.emblem--plate) {
      width: 100%;
    }
  }
</style>
