---
// Hero beranda: tagline sebagai judul kapital bergaya huruf pahatan museum (5 kolom kiri) dan
// FIG. 01 Medan Risiko (7 kolom kanan): figur 3D three.js dengan fallback SVG teknis.
// Di bawah tombol, baris spesifikasi bergaya label museum; angkanya dihitung dari data, bukan ditulis.
import { siteConfig } from '../config/site';
import { categories } from '../data/categories';
import { getConcepts } from '../lib/concepts';
import { getProblems } from '../lib/problems';
import { routes, withBase } from '../lib/url';
import RiskField from './figures/RiskField.astro';
import { toolComponents } from './tools';

const pad = (n: number) => String(n).padStart(2, '0');
const specs = [
  { label: 'Konsep', value: (await getConcepts()).length },
  { label: 'Masalah trader', value: (await getProblems()).length },
  { label: 'Alat hitung', value: Object.keys(toolComponents).length },
  { label: 'Kategori', value: categories.length },
];
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero__text">
    <p class="label">
      {siteConfig.masterBrand}<span class="label__sep" aria-hidden="true">·</span>{siteConfig.product}
    </p>
    <h1 id="hero-title" class="hero__title">
      {siteConfig.taglineParts.map((part) => <span>{part}</span>)}
    </h1>
    <p class="hero__lead">
      Mulai dari masalah yang Anda alami saat trading, lalu pahami konsep risiko di baliknya: definisinya,
      contoh hitungannya, dan cara menerapkannya.
    </p>
    <p class="hero__actions">
      <a class="button" href="#masalah">Mulai dari masalah</a>
      <a class="hero__secondary" href="#sistem">Lihat sistem belajar →</a>
    </p>
    <dl class="hero__specs">
      {
        specs.map((s) => (
          <div>
            <dt class="label">{s.label}</dt>
            <dd>{pad(s.value)}</dd>
          </div>
        ))
      }
    </dl>
  </div>

  <div class="hero__figure">
    <RiskField number="01" />
  </div>
</section>

<style>
  .hero {
    display: grid;
    gap: var(--space-12);
    padding-block: var(--space-4) var(--space-8);
  }

  /* Judul kapital serif: tegas tapi tenang — tracking sedikit dibuka, baris rapat. */
  .hero__title {
    display: flex;
    flex-direction: column;
    margin: var(--space-6) 0 var(--space-6);
    font-size: clamp(var(--text-2xl), 8.5vw, var(--text-4xl));
    line-height: var(--leading-caps-display);
    letter-spacing: var(--tracking-caps-display);
    text-transform: uppercase;
  }

  .hero__lead {
    max-width: var(--measure-narrow);
    margin: 0;
    font-size: var(--text-lg);
    color: var(--ink-2);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-6);
    margin: var(--space-8) 0 0;
  }

  .button {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0 var(--space-6);
    font-weight: 600;
    color: var(--paper);
    background: var(--ink);
    border: var(--border-hair) solid var(--ink);
    border-radius: var(--radius-1);
    text-decoration: none;
    transition:
      color var(--motion-fast) var(--ease),
      background-color var(--motion-fast) var(--ease);
  }

  .button:hover {
    color: var(--ink);
    background: transparent;
  }

  .hero__secondary {
    font-weight: 600;
    color: var(--ink);
  }

  /* Baris spesifikasi: empat sel dengan garis tick di atas, seperti skala pada penggaris. */
  .hero__specs {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4) var(--space-6);
    max-width: 32rem;
    margin: var(--space-12) 0 0;
  }

  .hero__specs div {
    padding-top: var(--space-2);
    border-top: var(--stroke-hair) solid var(--rule-strong);
  }

  .hero__specs dd {
    margin: var(--space-1) 0 0;
    font-family: var(--font-serif);
    font-size: var(--text-xl);
    font-weight: 600;
    line-height: 1;
  }

  .hero__figure {
    width: 100%;
    min-width: 0;
  }

  @media (min-width: 30rem) {
    .hero__specs {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  @media (min-width: 64rem) {
    .hero {
      grid-template-columns: repeat(var(--grid-columns), minmax(0, 1fr));
      gap: var(--grid-gap);
      align-items: center;
      padding-block: var(--space-8) var(--space-16);
    }

    .hero__text {
      grid-column: 1 / span 5;
    }

    .hero__title {
      font-size: clamp(var(--text-3xl), 3.6vw, var(--text-4xl));
    }

    .hero__figure {
      grid-column: 6 / -1;
    }
  }
</style>
