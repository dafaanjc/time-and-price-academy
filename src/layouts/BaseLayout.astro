---
import '../styles/global.css';
import { siteConfig } from '../config/site';
import SeoHead from '../components/SeoHead.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Sidebar from '../components/Sidebar.astro';
import SiteFooter from '../components/SiteFooter.astro';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  section?: string;
  /** Path gambar OG (sudah dengan base). */
  image?: string;
  noindex?: boolean;
  /**
   * Tampilkan indeks konsep di kiri (desktop). Hanya untuk halaman di dalam area konsep
   * (konsep, kategori). Halaman lain memakai kontainer di tengah tanpa sidebar.
   */
  sidebar?: boolean;
}

const { title, description, type, section, image, noindex, sidebar = false } = Astro.props;
---

<!doctype html>
<html lang={siteConfig.lang}>
  <head>
    <SeoHead title={title} description={description} type={type} section={section} image={image} noindex={noindex} />
    <!--
      Scroll reveal (lihat global.css → "Scroll reveal"). Inline di <head> agar kelas .js-reveal terpasang
      sebelum render pertama (tanpa kedip). Tidak aktif tanpa IntersectionObserver atau bila pengguna
      memilih gerak dikurangi; setiap section hanya dianimasikan sekali.
    -->
    <script is:inline>
      (() => {
        if (!('IntersectionObserver' in window)) return;
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        document.documentElement.classList.add('js-reveal');
        document.addEventListener('DOMContentLoaded', () => {
          const observer = new IntersectionObserver(
            (entries) => {
              for (const entry of entries) {
                if (!entry.isIntersecting) continue;
                entry.target.classList.add('is-revealed');
                observer.unobserve(entry.target);
              }
            },
            { rootMargin: '0px 0px -8% 0px', threshold: 0.06 },
          );
          document.querySelectorAll('[data-reveal]').forEach((el) => observer.observe(el));
        });
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#konten">Langsung ke konten</a>
    <SiteHeader />
    <div class:list={['shell', { 'shell--sidebar': sidebar }]}>
      {sidebar && <Sidebar />}
      <div class="shell__main">
        <main id="konten" tabindex="-1">
          <slot />
        </main>
        <SiteFooter />
      </div>
    </div>
  </body>
</html>

<style>
  .shell {
    max-width: var(--container);
    margin-inline: auto;
  }

  .shell__main {
    min-width: 0;
    padding: var(--space-8) var(--gutter) 0;
  }

  main:focus {
    outline: none;
  }

  @media (min-width: 64rem) {
    .shell__main {
      padding-top: var(--space-12);
    }

    .shell--sidebar {
      display: grid;
      grid-template-columns: var(--sidebar-width) minmax(0, 1fr);
      max-width: var(--container-wide);
    }

    .shell--sidebar .shell__main {
      padding-inline: var(--space-12);
    }
  }
</style>
