---
// Urutan halaman konsep:
// header (deskripsi, meta, atribusi, salin tautan) → notis draf → daftar isi →
// isi MDX → masalah trader terkait → konsep terkait → prasyarat → sumber → navigasi jalur belajar.
import BaseLayout from './BaseLayout.astro';
import ConceptHeader from '../components/ConceptHeader.astro';
import PlaceholderNotice from '../components/PlaceholderNotice.astro';
import TableOfContents from '../components/TableOfContents.astro';
import ConceptLinkList from '../components/ConceptLinkList.astro';
import SourceList from '../components/SourceList.astro';
import PathNav from '../components/PathNav.astro';
import PathPosition from '../components/PathPosition.astro';
import ConceptMap from '../components/ConceptMap.astro';
import ProblemList from '../components/ProblemList.astro';
import { getCategory } from '../data/categories';
import { layoutLocalGraph } from '../lib/local-graph';
import { conceptHref, getConcepts, getConceptsByIds, getPathContext, type Concept } from '../lib/concepts';
import { getProblemsForConcept } from '../lib/problems';
import { layoutSectionIds } from '../lib/sections';
import { absoluteUrl, conceptOgImage } from '../lib/url';

interface Props {
  concept: Concept;
  sections: { id: string; title: string }[];
}

const { concept, sections } = Astro.props;
const { title, description, category, status, related, prerequisites, sources } = concept.data;

const relatedConcepts = await getConceptsByIds(related);
const prerequisiteConcepts = await getConceptsByIds(prerequisites);
const pathContext = await getPathContext(concept.id);
// Tautan balik otomatis: masalah trader yang merujuk konsep ini.
const relatedProblems = await getProblemsForConcept(concept.id);
// Mini peta: konsep yang menjadikan konsep ini prasyaratnya = "lanjutan".
const dependents = (await getConcepts()).filter((c) => c.data.prerequisites.includes(concept.id));
const toNode = (c: Concept) => ({ id: c.id, title: c.data.title, href: conceptHref(c.id) });
const localGraph = layoutLocalGraph({
  current: toNode(concept),
  prerequisites: prerequisiteConcepts.map(toNode),
  next: dependents.map(toNode),
  related: relatedConcepts.map(toNode),
});
const shareUrl = absoluteUrl(Astro.url.pathname, Astro.site);
---

<BaseLayout
  title={title}
  description={description}
  type="article"
  section={getCategory(category).title}
  image={conceptOgImage(concept.id)}
  sidebar
>
  <article class="concept">
    <ConceptHeader concept={concept} url={shareUrl} />
    {pathContext && <PathPosition context={pathContext} />}

    {
      status === 'draft' && (
        <PlaceholderNotice>
          Belum ditinjau dan belum bersumber. Angka dalam contoh adalah ilustrasi, bukan data pasar atau rekomendasi.
        </PlaceholderNotice>
      )
    }

    <div class="concept__body">
      <TableOfContents sections={sections} />
      <div class="content">
        <slot />
      </div>
    </div>

    {
      relatedProblems.length > 0 && (
        <section class="concept-problems" aria-labelledby={layoutSectionIds.problems}>
          <h2 id={layoutSectionIds.problems}>Masalah Trader Terkait</h2>
          <ProblemList problems={relatedProblems} headingLevel={3} />
        </section>
      )
    }

    <div class="concept-relations">
      <div class="concept-relations__lists">
        <ConceptLinkList
          id={layoutSectionIds.related}
          title="Konsep Terkait"
          concepts={relatedConcepts}
          empty="Belum ada konsep terkait."
        />

        <ConceptLinkList
          id={layoutSectionIds.prerequisites}
          title="Prasyarat"
          concepts={prerequisiteConcepts}
          empty="Tidak ada prasyarat. Konsep ini bisa dipelajari lebih dulu."
        />
      </div>
      <ConceptMap graph={localGraph} currentTitle={title} />
    </div>

    <SourceList sources={sources} />

    {pathContext && <PathNav context={pathContext} />}
  </article>
</BaseLayout>

<style>
  /* Layar lebar: isi (lebar baca) di kiri, daftar isi sticky di kolom kanan. */
  @media (min-width: 80rem) {
    .concept__body {
      display: grid;
      grid-template-columns: minmax(0, var(--measure)) 13rem;
      gap: var(--space-12);
      align-items: start;
    }

    .concept__body > :global(.toc) {
      grid-column: 2;
      grid-row: 1;
      position: sticky;
      top: calc(var(--header-height) + var(--space-8));
    }

    .concept__body > .content {
      grid-column: 1;
      grid-row: 1;
    }
  }

  /* Daftar tautan (teks) di kiri, mini peta di kanan pada layar lebar; satu kolom di layar sempit. */
  .concept-relations {
    display: grid;
    gap: var(--space-8);
    align-items: start;
    padding-top: var(--space-8);
    border-top: 1px solid var(--rule-strong);
  }

  .concept-relations__lists {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  @media (min-width: 64rem) {
    .concept-relations {
      grid-template-columns: minmax(0, var(--measure)) minmax(0, 22rem);
      gap: var(--space-12);
    }

    .concept-relations :global(.concept-map) {
      position: sticky;
      top: calc(var(--header-height) + var(--space-8));
    }
  }

  .concept-problems {
    max-width: var(--measure);
  }

  .concept-problems h2 {
    margin: 0 0 var(--space-3);
    font-size: var(--text-xl);
  }

  .concept {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }
</style>
